// Frontmatter
import { useTranslations } from '../../../../i18n/translations';
import { getLocaleFromUrl } from '../../../../i18n/utils';
import LanguageSwitcher from '../../../../components/LanguageSwitcher.astro';
import main_pic from './assets/neuhold-michael_main-pic.jpg';
import logoGasthausHoaterwirt from './assets/logo_gasthaus-hoaterwirt.svg';
import logoRoteRakete from './assets/logo_Rote-Rakete.webp';
import logoLima from './assets/logo_lima.jpg';
import pdfThesisDiploma from './assets/neuhold-michael_diploma-thesis.pdf';
import pdfThesisBachelor from './assets/neuhold-michael_bachelor-thesis.pdf';
import pdfSponsorMap from './assets/neuhold-michael_sponsormap.pdf';

const PDF_SPONSOR_MAP = pdfSponsorMap
const PDF_THESIS_DIPLOMA = pdfThesisDiploma;
const PDF_THESIS_BACHELOR = pdfThesisBachelor;
const PDF_THESIS_MASTER = './neuhold-michael/assets/neuhold-michael_master-thesis.pdf'; // still todo hehe

const locale = getLocaleFromUrl(Astro.url);
const translate = useTranslations(locale);
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Michael Neuhold - Software Engineering Student at TU Graz, Triathlete, Teaching Assistant. Passionate about machine learning and competitive sports." />
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="profile" />
  <meta property="og:url" content="https://faces.neulanc.com/people/neuhold-michael/" />
  <meta property="og:title" content="Michael Neuhold - Software Engineer & Triathlete" />
  <meta property="og:description" content="Software Engineering Student at TU Graz, Triathlete, Teaching Assistant." />
  <meta property="og:image" content="https://faces.neulanc.com/_astro/neuhold-michael_main-pic.jpg" />
  
  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content="https://faces.neulanc.com/people/neuhold-michael/" />
  <meta property="twitter:title" content="Michael Neuhold - Software Engineer & Triathlete" />
  <meta property="twitter:description" content="Software Engineering Student at TU Graz, Triathlete, Teaching Assistant." />
  <meta property="twitter:image" content="https://faces.neulanc.com/_astro/neuhold-michael_main-pic.jpg" />

  <script>
    Object.assign(window, {
      MathJax: {
        tex: {
          inlineMath: [['\\(', '\\)']],
          displayMath: [['$$', '$$']]
        },
        svg: {
          fontCache: 'global'
        }
      }
    });
  </script>
  <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js"></script>
  
  <title>Michael Neuhold</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      background:
        radial-gradient(circle at top left, rgba(0, 102, 204, 0.08), transparent 30%),
        radial-gradient(circle at top right, rgba(0, 170, 255, 0.07), transparent 26%),
        linear-gradient(180deg, #f8fbff 0%, #ffffff 28%, #f6f9fc 100%);
      color: #243042;
      line-height: 1.6;
      min-height: 100vh;
      scroll-padding-top: 90px;
    }

    .container {
      max-width: 1040px;
      margin: 0 auto;
      padding: 4rem 2rem;
    }

    /* Header / About Section */
    .about {
      margin-bottom: 4rem;
    }

    .about h1 {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 1rem;
      color: #000;
    }

    .about-content {
      display: flex;
      gap: 2rem;
      align-items: flex-start;
      margin-bottom: 2rem;
    }

    .portrait {
      width: 180px;
      height: 180px;
      border-radius: 8px;
      object-fit: cover;
      flex-shrink: 0;
    }

    .bio {
      flex: 1;
      font-size: 1.05rem;
      color: #555;
    }

    .bio p {
      margin-bottom: 1rem;
    }

    .sponsor-section {
      margin-bottom: 3.5rem;
    }

    .sponsor-list {
      display: grid;
      gap: 0.9rem;
      margin-top: 1rem;
    }

    .sponsor-item {
      display: grid;
      grid-template-columns: 64px minmax(0, 1fr);
      gap: 0.9rem;
      align-items: center;
      padding: 0.95rem 1rem;
      border: 1px solid rgba(0, 102, 204, 0.14);
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.94);
      box-shadow: 0 10px 26px rgba(16, 30, 54, 0.05);
      color: inherit;
      text-decoration: none;
    }

    .sponsor-item:hover {
      border-color: rgba(0, 102, 204, 0.24);
      transform: translateY(-1px);
    }

    .sponsor-logo {
      width: 64px;
      height: 64px;
      border-radius: 14px;
      object-fit: contain;
      background: #fff;
      padding: 0.35rem;
      border: 1px solid rgba(0, 102, 204, 0.08);
    }

    .sponsor-item strong {
      display: block;
      color: #08192c;
      font-size: 1rem;
    }

    .sponsor-item small {
      display: block;
      margin-top: 0.15rem;
      color: #607286;
      font-size: 0.82rem;
    }

    .sport-sponsor-note {
      margin: 0 0 1rem;
      color: #506173;
      font-size: 0.96rem;
    }

    .section {
      margin-bottom: 3.5rem;
    }

    .section-header {
      position: relative;
      overflow: hidden;
      margin-bottom: 1.25rem;
      padding: 1.35rem 1.4rem;
      border: 1px solid rgba(0, 102, 204, 0.14);
      border-radius: 22px;
      background:
        linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(245, 250, 255, 0.96));
      box-shadow: 0 18px 42px rgba(16, 30, 54, 0.08);
      cursor: pointer;
      transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
    }

    .section-header::after {
      content: '';
      position: absolute;
      inset: auto -10% -55% auto;
      width: 240px;
      height: 240px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(0, 170, 255, 0.16), transparent 68%);
      pointer-events: none;
    }

    .section-header:hover {
      transform: translateY(-2px);
      border-color: rgba(0, 102, 204, 0.28);
      box-shadow: 0 22px 52px rgba(16, 30, 54, 0.12);
    }

    .section-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      margin-bottom: 0.55rem;
      padding: 0.28rem 0.7rem;
      border-radius: 999px;
      background: rgba(0, 102, 204, 0.08);
      color: #0052a6;
      font-size: 0.76rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .section-header h2 {
      font-size: 2rem;
      font-weight: 700;
      color: #09192d;
      line-height: 1.1;
      margin-bottom: 0.55rem;
    }

    .section-subtitle {
      max-width: 72ch;
      color: #536273;
      font-size: 0.98rem;
    }

    .social-links {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-top: 1.5rem;
    }

    .social-row {
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
    }

    .social-links a {
      color: #0066cc;
      text-decoration: none;
      font-size: 0.95rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.3rem;
      transition: all 0.2s ease;
    }

    .social-links a:hover {
      color: #0088ff;
      transform: translateY(-2px);
    }

    .social-links a svg {
      width: 24px;
      height: 24px;
      fill: currentColor;
    }

    .year-section {
      position: relative;
      margin-bottom: 1.2rem;
    }

    .year-header {
      padding: 0.2rem 0 0.9rem;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .year-header:hover h3 {
      color: #0066cc;
    }

    .year-header h3 {
      font-size: 1.5rem;
      font-weight: 600;
      color: #16314d;
      transition: color 0.2s ease;
    }

    .items {
      margin-left: 3rem;
      margin-bottom: 2rem;
      position: relative;
    }

    /* Creative animated line */
    .items::before {
      content: '';
      position: absolute;
      left: -2rem;
      top: 0;
      bottom: 0;
      width: 2px;
      background: linear-gradient(
        180deg,
        transparent 0%,
        #0066cc 10%,
        #00aaff 50%,
        #0066cc 90%,
        transparent 100%
      );
      animation: lineGlow 2s ease-in-out infinite alternate;
    }

    /* Animated dots flowing down the line */
    .items::after {
      content: '';
      position: absolute;
      left: calc(-2rem - 2px);
      top: 0;
      width: 6px;
      height: 6px;
      background: #00aaff;
      border-radius: 50%;
      box-shadow: 0 0 10px #00aaff, 0 0 20px rgba(0, 170, 255, 0.5);
      animation: dotFlow 3s ease-in-out infinite;
    }

    @keyframes lineGlow {
      0% {
        opacity: 0.5;
        box-shadow: 0 0 5px rgba(0, 102, 204, 0.3);
      }
      100% {
        opacity: 1;
        box-shadow: 0 0 15px rgba(0, 170, 255, 0.6);
      }
    }

    @keyframes dotFlow {
      0% {
        top: 0%;
        opacity: 0;
      }
      10% {
        opacity: 1;
      }
      90% {
        opacity: 1;
      }
      100% {
        top: 100%;
        opacity: 0;
      }
    }

    .item {
      margin-bottom: 1rem;
      padding: 1.2rem 1.2rem 1.15rem;
      border: 1px solid rgba(20, 47, 79, 0.08);
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.92);
      box-shadow: 0 10px 28px rgba(16, 30, 54, 0.05);
      position: relative;
      transition: all 0.3s ease;
    }

    /* Item indicator dot - perfectly centered on line */
    .item::before {
      content: '';
      position: absolute;
      left: calc(-2rem - 6px);
      top: 0.4rem;
      width: 12px;
      height: 12px;
      background: #fff;
      border: 3px solid #0066cc;
      border-radius: 50%;
      z-index: 2;
      transition: all 0.3s ease;
    }

    .item:hover::before {
      transform: scale(1.4);
      border-color: #00aaff;
      box-shadow: 0 0 0 4px rgba(0, 170, 255, 0.2), 0 0 15px rgba(0, 170, 255, 0.4);
      background: #00aaff;
    }

    .item:hover {
      transform: translateX(4px);
    }

    .item:hover h4 {
      color: #0066cc;
    }

    .item:last-child {
      border-bottom: none;
    }

    .item h4 {
      font-size: 1.08rem;
      font-weight: 700;
      margin-bottom: 0.45rem;
      color: #08192c;
      letter-spacing: -0.01em;
    }

    .item-meta {
      display: inline-flex;
      align-items: center;
      margin-bottom: 0.7rem;
      padding: 0.24rem 0.65rem;
      border-radius: 999px;
      background: rgba(0, 102, 204, 0.08);
      color: #0052a6;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.02em;
    }

    .item p {
      color: #506173;
      font-size: 0.96rem;
      margin-bottom: 0.5rem;
    }

    .item p:last-child {
      margin-bottom: 0;
    }

    .item a {
      color: #0066cc;
      text-decoration: none;
    }

    .item a:hover {
      text-decoration: underline;
    }

    .sport-text-links .item {
      display: block;
      width: 100%;
      color: #243042;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
    }

    .sport-text-links .item:hover {
      text-decoration: underline;
    }

    .thesis-abstract {
      margin-top: 0.9rem;
      border: 1px solid #d8e6f7;
      border-radius: 10px;
      background: #f8fbff;
      overflow: hidden;
    }

    .thesis-abstract summary {
      list-style: none;
      cursor: pointer;
      padding: 0.7rem 0.9rem;
      font-size: 0.95rem;
      font-weight: 600;
      color: #005bb5;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.8rem;
    }

    .thesis-abstract summary::-webkit-details-marker {
      display: none;
    }

    .thesis-abstract summary::after {
      content: '▾';
      font-size: 0.9rem;
      transition: transform 0.2s ease;
    }

    .thesis-abstract[open] summary::after {
      transform: rotate(180deg);
    }

    .thesis-abstract p {
      border-top: 1px solid #d8e6f7;
      margin: 0;
      padding: 0.9rem;
      color: #555;
      font-size: 0.92rem;
    }

    .thesis-abstract-content {
      border-top: 1px solid #d8e6f7;
      padding: 0.9rem;
      color: #555;
      font-size: 0.92rem;
    }

    .thesis-abstract-content p {
      border-top: none;
      margin: 0 0 0.8rem 0;
      padding: 0;
    }

    .thesis-abstract-content p:last-child {
      margin-bottom: 0;
    }

    .math-block {
      margin: 0 0 0.8rem 0;
      padding: 0.7rem 0.9rem;
      background: #eef5ff;
      border: 1px solid #d8e6f7;
      border-radius: 8px;
      overflow-x: auto;
    }

    .section-notes {
      display: grid;
      gap: 0.7rem;
      margin-top: 1rem;
    }

    .section-notes li {
      list-style: none;
      position: relative;
      padding-left: 1.1rem;
      color: #506173;
      font-size: 0.94rem;
    }

    .section-notes li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.65em;
      width: 0.42rem;
      height: 0.42rem;
      border-radius: 999px;
      background: linear-gradient(135deg, #0066cc, #00aaff);
    }

    .sport-layout {
      display: grid;
      gap: 1.2rem;
      margin-bottom: 1.3rem;
    }

    .achievements-panel {
      padding: 1.15rem 1.2rem;
      border-radius: 20px;
      border: 1px solid rgba(0, 102, 204, 0.14);
      background: linear-gradient(160deg, rgba(255, 255, 255, 0.98), rgba(241, 248, 255, 0.94));
      box-shadow: 0 14px 30px rgba(16, 30, 54, 0.07);
    }

    .achievements-panel h3 {
      font-size: 1.05rem;
      margin-bottom: 0.8rem;
      color: #0f2842;
      letter-spacing: 0.01em;
    }

    .achievement-list {
      display: grid;
      gap: 0.55rem;
      list-style: none;
    }

    .achievement-list li {
      position: relative;
      padding: 0.62rem 0.8rem 0.62rem 1.35rem;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.86);
      border: 1px solid rgba(0, 102, 204, 0.1);
      color: #27445f;
      font-size: 0.93rem;
    }

    .achievement-list li::before {
      content: '';
      position: absolute;
      left: 0.75rem;
      top: 50%;
      width: 0.38rem;
      height: 0.38rem;
      transform: translateY(-50%);
      border-radius: 50%;
      background: linear-gradient(135deg, #0066cc, #00aaff);
      box-shadow: 0 0 0 3px rgba(0, 170, 255, 0.14);
    }

    .achievement-list a {
      color: #005ab6;
      text-decoration: none;
      font-weight: 700;
    }

    .achievement-list a:hover {
      text-decoration: underline;
    }

    .race-log {
      padding: 1.15rem 1.2rem;
      border-radius: 20px;
      border: 1px solid rgba(0, 102, 204, 0.14);
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(245, 251, 255, 0.96));
      box-shadow: 0 14px 30px rgba(16, 30, 54, 0.06);
    }

    .race-log h3 {
      font-size: 1.05rem;
      margin-bottom: 0.9rem;
      color: #0f2842;
      letter-spacing: 0.01em;
    }

    .race-year-group {
      margin-bottom: 1.25rem;
    }

    .race-year-group:last-child {
      margin-bottom: 0;
    }

    .race-year-group > h4 {
      margin-bottom: 0.62rem;
      font-size: 0.9rem;
      color: #4a6078;
      text-transform: uppercase;
      letter-spacing: 0.09em;
    }

    .race-cards-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.8rem;
      align-items: start;
    }

    .race-card {
      display: grid;
      gap: 0.52rem;
      padding: 1rem;
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.88);
      border: 1px solid rgba(0, 102, 204, 0.1);
      box-shadow: 0 8px 24px rgba(16, 30, 54, 0.05);
      scroll-margin-top: 110px;
      align-self: start;
      height: fit-content;
    }

    .race-card.is-pulsed {
      animation: racePulse 1.8s ease-out;
    }

    @keyframes racePulse {
      0% {
        transform: scale(1);
        box-shadow: 0 8px 24px rgba(16, 30, 54, 0.05);
        border-color: rgba(0, 102, 204, 0.1);
      }
      20% {
        transform: scale(1.03);
        box-shadow: 0 18px 40px rgba(0, 102, 204, 0.18);
        border-color: rgba(0, 102, 204, 0.4);
      }
      70% {
        transform: scale(1.015);
        box-shadow: 0 14px 32px rgba(0, 102, 204, 0.12);
        border-color: rgba(0, 102, 204, 0.24);
      }
      100% {
        transform: scale(1);
        box-shadow: 0 8px 24px rgba(16, 30, 54, 0.05);
        border-color: rgba(0, 102, 204, 0.1);
      }
    }

    .race-card--placeholder {
      border-style: dashed;
      background: rgba(0, 102, 204, 0.04);
      color: #6b7c8f;
    }

    .race-type {
      font-size: 0.77rem;
      font-weight: 800;
      color: #0052a6;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .race-name-location {
      font-size: 1rem;
      line-height: 1.3;
      color: #08192c;
    }

    .race-official-link {
      width: fit-content;
      color: #0066cc;
      text-decoration: none;
      font-size: 0.88rem;
      font-weight: 700;
      border-bottom: 1px dashed rgba(0, 102, 204, 0.35);
    }

    .race-official-link:hover {
      color: #0052a6;
      border-bottom-color: rgba(0, 82, 166, 0.8);
    }

    .race-times {
      display: grid;
      gap: 0.55rem;
      margin-top: 0.1rem;
    }

    .race-time-item {
      padding: 0.62rem 0.72rem;
      border-radius: 10px;
      border: 1px solid rgba(0, 102, 204, 0.1);
      background: #f7fbff;
    }

    .race-time-item p {
      margin: 0;
      color: #41566e;
      font-size: 0.88rem;
    }

    .race-time-item .race-time-value {
      margin-top: 0.2rem;
      font-size: 0.98rem;
      color: #102942;
      font-weight: 700;
    }

    .card-media {
      margin-bottom: 0.9rem;
      border-radius: 16px;
      border: 1px dashed rgba(0, 102, 204, 0.22);
      background:
        linear-gradient(135deg, rgba(0, 102, 204, 0.14), rgba(0, 170, 255, 0.07));
      min-height: 150px;
      display: grid;
      place-items: center;
      text-align: center;
      padding: 0.9rem;
      color: #0052a6;
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .card-media small {
      display: block;
      margin-top: 0.35rem;
      color: #57718b;
      font-size: 0.72rem;
      letter-spacing: 0.02em;
      text-transform: none;
      font-weight: 600;
    }

    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0.9rem;
      margin-top: 1rem;
    }

    .gallery-card {
      min-height: 160px;
      padding: 0.9rem;
      border-radius: 18px;
      border: 1px solid rgba(0, 102, 204, 0.1);
      background:
        linear-gradient(180deg, rgba(255,255,255,0.92), rgba(244,249,255,0.96));
      box-shadow: 0 12px 24px rgba(16, 30, 54, 0.05);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 0.8rem;
    }

    .gallery-visual {
      flex: 1;
      border-radius: 14px;
      border: 1px dashed rgba(0, 102, 204, 0.22);
      background:
        linear-gradient(135deg, rgba(0, 102, 204, 0.12), rgba(0, 170, 255, 0.06));
      display: grid;
      place-items: center;
      color: #0052a6;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      min-height: 92px;
    }

    .gallery-caption {
      font-size: 0.84rem;
      color: #607286;
    }

    .sport-item-media {
      margin-bottom: 0.9rem;
      min-height: 140px;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .container {
        padding: 2rem 1rem;
      }

      .about-content {
        flex-direction: column;
      }

      .portrait {
        width: 150px;
        height: 150px;
      }

      .about h1 {
        font-size: 2rem;
      }

      .section-header h2 {
        font-size: 1.5rem;
      }

      .section-header {
        padding: 1.1rem 1rem;
      }

      .race-cards-grid,
      .gallery-grid {
        grid-template-columns: repeat(1, minmax(0, 1fr));
      }

      .card-media,
      .sport-item-media {
        min-height: 120px;
      }

      .achievements-panel,
      .race-log {
        padding: 1rem 0.9rem;
      }

      .year-header {
        top: 60px;
      }

      .year-header h3 {
        font-size: 1.2rem;
      }

      .items {
        margin-left: 1.5rem;
      }

      .items::before {
        left: -1rem;
      }

      .items::after {
        left: calc(-1rem - 2px);
      }

      .item::before {
        left: calc(-1rem - 6px);
      }

      body {
        padding-bottom: 140px;
        scroll-padding-top: 72px;
      }

      .lang-switcher-wrapper {
        top: calc(10px + env(safe-area-inset-top, 0px));
        bottom: auto;
        left: auto;
        right: 12px;
        transform: none;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        padding: 0.28rem 0.48rem;
        max-width: calc(100% - 24px);
        width: fit-content;
        background: rgba(255, 255, 255, 0.95);
        border: 1px solid #e0e0e0;
        border-radius: 999px;
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
        backdrop-filter: blur(8px);
      }

      .sticky-years,
      .sticky-years#stickyYears {
        top: calc(10px + env(safe-area-inset-top, 0px) + 40px); /* below switcher */
        bottom: auto;
        left: auto;
        right: 12px;
        transform: none;
        display: grid;
        grid-template-columns: repeat(2, max-content);
        justify-content: end;
        align-content: start;
        align-items: center;
        overflow: visible;
        padding: 0.4rem 0.5rem;
        gap: 0.3rem 0.4rem;
        border-radius: 12px;
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
        border: 1px solid #e0e0e0;
        width: max-content;
        max-width: calc(100% - 24px);
      }

      .sticky-years::-webkit-scrollbar {
        height: 6px;
      }

      .sticky-years::-webkit-scrollbar-thumb {
        background: #d0d0d0;
        border-radius: 999px;
      }

      .sticky-year-btn {
        white-space: nowrap;
        flex: 0 0 auto;
        font-size: 0.82rem;
        padding: 0.45rem 0.75rem;
      }

      .section-header {
        padding: 1.05rem 1rem;
      }
    }

    /* Smooth scrolling */
    html {
      scroll-behavior: smooth;
    }

    /* Language Switcher positioning */
    .lang-switcher-wrapper {
      position: fixed;
      top: calc(16px + env(safe-area-inset-top, 0px));
      right: 16px;
      left: auto;
      z-index: 250;
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.3rem 0.55rem;
      background: rgba(255, 255, 255, 0.96);
      border: 1px solid #e0e0e0;
      border-radius: 999px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
      max-width: min(92vw, 280px);
      width: fit-content;
      height: auto;
      backdrop-filter: blur(8px);
    }

    .inline-link {
      color: #0066cc;
      text-decoration: none;
      font-weight: 600;
    }

    .inline-link:hover {
      text-decoration: underline;
    }

    /* Sticky year indicators */
    .sticky-years,
    .sticky-years#stickyYears {
      position: fixed;
      top: calc(16px + env(safe-area-inset-top, 0px) + 42px); /* below switcher */
      right: 16px;
      left: auto;
      display: grid;
      grid-template-columns: repeat(2, max-content);
      justify-content: end;
      align-content: start;
      align-items: center;
      gap: 0.35rem 0.45rem;
      z-index: 200;
      background: rgba(255, 255, 255, 0.95);
      padding: 0.35rem 0.45rem;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      width: max-content;
      max-width: 92vw;
      max-height: none;
      overflow: visible;
    }

    .sticky-year-btn {
      background: #f5f5f5;
      border: 1px solid #ddd;
      padding: 0.35rem 0.65rem;
      border-radius: 10px;
      cursor: pointer;
      font-size: 0.82rem;
      font-weight: 600;
      color: #666;
      transition: all 0.2s ease;
      line-height: 1.2;
      flex: 0 0 auto;
      height: auto;
    }

    .sticky-year-btn:hover {
      background: #0066cc;
      color: #fff;
      border-color: #0066cc;
    }

    .sticky-year-btn.active {
      background: #0066cc;
      color: #fff;
      border-color: #0066cc;
    }
  </style>
</head>
