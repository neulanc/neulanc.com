---
import { useTranslations } from '../../../../i18n/translations';
import { getLocaleFromUrl } from '../../../../i18n/utils';
import LanguageSwitcher from '../../../../components/LanguageSwitcher.astro';
import mainPic from './assets/neuhold-michael_main-pic.jpg';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Michael Neuhold</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      background: #fff;
      color: #333;
      line-height: 1.6;
    }

    .container {
      max-width: 900px;
      margin: 0 auto;
      padding: 4rem 2rem;
    }

    /* Header / About Section */
    .about {
      margin-bottom: 4rem;
    }

    .about h1 {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 1rem;
      color: #000;
    }

    .about-content {
      display: flex;
      gap: 2rem;
      align-items: flex-start;
      margin-bottom: 2rem;
    }

    .portrait {
      width: 180px;
      height: 180px;
      border-radius: 8px;
      object-fit: cover;
      flex-shrink: 0;
    }

    .bio {
      flex: 1;
      font-size: 1.05rem;
      color: #555;
    }

    .bio p {
      margin-bottom: 1rem;
    }

    .social-links {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-top: 1.5rem;
    }

    .social-row {
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
    }

    .social-links a {
      color: #0066cc;
      text-decoration: none;
      font-size: 0.95rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.3rem;
      transition: all 0.2s ease;
    }

    .social-links a:hover {
      color: #0088ff;
      transform: translateY(-2px);
    }

    .social-links a svg {
      width: 24px;
      height: 24px;
      fill: currentColor;
    }

    /* Timeline Section */
    .section {
      margin-bottom: 3rem;
    }

    .section-header {
      position: sticky;
      top: 0;
      background: #fff;
      padding: 1.5rem 0;
      margin-bottom: 1rem;
      z-index: 100;
      border-bottom: 2px solid #e0e0e0;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .section-header:hover {
      border-bottom-color: #0066cc;
    }

    .section-header h2 {
      font-size: 2rem;
      font-weight: 600;
      color: #000;
    }

    .year-section {
      position: relative;
    }

    .year-header {
      padding: 1rem 0;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .year-header:hover h3 {
      color: #0066cc;
    }

    .year-header h3 {
      font-size: 1.5rem;
      font-weight: 600;
      color: #333;
      transition: color 0.2s ease;
    }

    .items {
      margin-left: 3rem;
      margin-bottom: 2rem;
      position: relative;
    }

    /* Creative animated line */
    .items::before {
      content: '';
      position: absolute;
      left: -2rem;
      top: 0;
      bottom: 0;
      width: 2px;
      background: linear-gradient(
        180deg,
        transparent 0%,
        #0066cc 10%,
        #00aaff 50%,
        #0066cc 90%,
        transparent 100%
      );
      animation: lineGlow 2s ease-in-out infinite alternate;
    }

    /* Animated dots flowing down the line */
    .items::after {
      content: '';
      position: absolute;
      left: calc(-2rem - 2px);
      top: 0;
      width: 6px;
      height: 6px;
      background: #00aaff;
      border-radius: 50%;
      box-shadow: 0 0 10px #00aaff, 0 0 20px rgba(0, 170, 255, 0.5);
      animation: dotFlow 3s ease-in-out infinite;
    }

    @keyframes lineGlow {
      0% {
        opacity: 0.5;
        box-shadow: 0 0 5px rgba(0, 102, 204, 0.3);
      }
      100% {
        opacity: 1;
        box-shadow: 0 0 15px rgba(0, 170, 255, 0.6);
      }
    }

    @keyframes dotFlow {
      0% {
        top: 0%;
        opacity: 0;
      }
      10% {
        opacity: 1;
      }
      90% {
        opacity: 1;
      }
      100% {
        top: 100%;
        opacity: 0;
      }
    }

    .item {
      margin-bottom: 2.5rem;
      padding-bottom: 2.5rem;
      padding-left: 0;
      border-bottom: 1px solid #f0f0f0;
      position: relative;
      transition: all 0.3s ease;
    }

    /* Item indicator dot - perfectly centered on line */
    .item::before {
      content: '';
      position: absolute;
      left: calc(-2rem - 6px);
      top: 0.4rem;
      width: 12px;
      height: 12px;
      background: #fff;
      border: 3px solid #0066cc;
      border-radius: 50%;
      z-index: 2;
      transition: all 0.3s ease;
    }

    .item:hover::before {
      transform: scale(1.4);
      border-color: #00aaff;
      box-shadow: 0 0 0 4px rgba(0, 170, 255, 0.2), 0 0 15px rgba(0, 170, 255, 0.4);
      background: #00aaff;
    }

    .item:hover {
      transform: translateX(8px);
    }

    .item:hover h4 {
      color: #0066cc;
    }

    .item:last-child {
      border-bottom: none;
    }

    .item h4 {
      font-size: 1.1rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
      color: #000;
    }

    .item-meta {
      font-size: 0.9rem;
      color: #888;
      margin-bottom: 0.5rem;
    }

    .item p {
      color: #666;
      font-size: 0.95rem;
    }

    .item a {
      color: #0066cc;
      text-decoration: none;
    }

    .item a:hover {
      text-decoration: underline;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .container {
        padding: 2rem 1rem;
      }

      .about-content {
        flex-direction: column;
      }

      .portrait {
        width: 150px;
        height: 150px;
      }

      .about h1 {
        font-size: 2rem;
      }

      .section-header h2 {
        font-size: 1.5rem;
      }

      .year-header {
        top: 60px;
      }

      .year-header h3 {
        font-size: 1.2rem;
      }

      .items {
        margin-left: 1.5rem;
      }

      .items::before {
        left: -1rem;
      }

      .items::after {
        left: calc(-1rem - 2px);
      }

      .item::before {
        left: calc(-1rem - 6px);
      }
    }

    /* Smooth scrolling */
    html {
      scroll-behavior: smooth;
    }

    /* Language Switcher positioning */
    .lang-switcher-wrapper {
      position: fixed;
      top: 20px;
      left: 20px;
      z-index: 250;
    }

    /* Sticky year indicators */
    .sticky-years {
      position: fixed;
      top: 20px;
      right: 20px;
      display: flex;
      gap: 0.5rem;
      z-index: 200;
      background: rgba(255, 255, 255, 0.95);
      padding: 0.5rem;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .sticky-year-btn {
      background: #f5f5f5;
      border: 1px solid #ddd;
      padding: 0.4rem 0.8rem;
      border-radius: 4px;
      cursor: pointer;
      font-size: 0.85rem;
      font-weight: 600;
      color: #666;
      transition: all 0.2s ease;
    }

    .sticky-year-btn:hover {
      background: #0066cc;
      color: #fff;
      border-color: #0066cc;
    }

    .sticky-year-btn.active {
      background: #0066cc;
      color: #fff;
      border-color: #0066cc;
    }
  </style>
</head>
<body>

