<script>
  // Sticky section navigation - only headlines, not years
  const sections = document.querySelectorAll('.section');
  const stickyYearsContainer = document.getElementById('stickyYears');
  
  const sectionData: Array<{ name: string; element: Element }> = [];
  sections.forEach(section => {
    const headerElement = section.querySelector('.section-header h2');
    if (headerElement) {
      const sectionName = headerElement.textContent;
      sectionData.push({ name: sectionName, element: section });
    }
  });

  // Create sticky section buttons
  sectionData.forEach(({ name, element }) => {
    const btn = document.createElement('button');
    btn.className = 'sticky-year-btn';
    btn.textContent = name;
    btn.onclick = () => {
      element.scrollIntoView({ behavior: 'smooth' });
    };
    if (stickyYearsContainer) {
      stickyYearsContainer.appendChild(btn);
    }
  });

  // Update active section on scroll
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && stickyYearsContainer) {
          const currentSection = entry.target;
          const headerElement = currentSection.querySelector('.section-header h2');
          if (headerElement) {
            const sectionName = headerElement.textContent;
            const buttons = stickyYearsContainer.querySelectorAll('.sticky-year-btn');
            buttons.forEach(btn => {
              if (btn.textContent === sectionName) {
                btn.classList.add('active');
              } else {
                btn.classList.remove('active');
              }
            });
          }
        }
      });
    },
    {
      threshold: 0.3,
      rootMargin: '-100px 0px -70% 0px'
    }
  );

  sections.forEach(section => observer.observe(section));

  const achievementLinks = document.querySelectorAll('.achievement-links a[href^="#race-"]');

  const pulseRace = (target: HTMLElement) => {
    target.classList.remove('is-pulsed');
    void target.offsetWidth;
    target.classList.add('is-pulsed');

    window.setTimeout(() => {
      target.classList.remove('is-pulsed');
    }, 1800);
  };

  achievementLinks.forEach(link => {
    link.addEventListener('click', () => {
      const href = link.getAttribute('href');
      if (!href || href === '#')
        return;

      const target = document.querySelector(href);
      if (!target || !(target instanceof HTMLElement))
        return;

      pulseRace(target);
    });
  });

  // Also highlight a race when this page is opened with a race hash directly.
  const initialTarget = window.location.hash
    ? document.querySelector(window.location.hash)
    : null;
  if (initialTarget instanceof HTMLElement && initialTarget.classList.contains('race-card')) {
    window.setTimeout(() => pulseRace(initialTarget), 100);
  }
</script>

