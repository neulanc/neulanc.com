import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import { getLocaleFromUrl } from '../../i18n/utils';

const content = {
  de: {
    title: 'Faces – neulanc',
    heading: 'Willkommen bei Faces!',
    text: 'Hier entsteht eine Liste aller Menschen, die neulanc repräsentieren.',
  },
  en: {
    title: 'Faces – neulanc',
    heading: 'Welcome to Faces!',
    text: 'This will become a list of all the people who represent neulanc.',
  },
} as const;

const locale = getLocaleFromUrl(Astro.url);
const t = content[locale];

---

<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <title>{t.title}</title>
  </head>
  <body>
    <LanguageSwitcher currentLocale={locale} currentPath={Astro.url.pathname.replace(/^\/faces/, '') || '/'} />
    <h1>{t.heading}</h1>
    <p>{t.text}</p>
  </body>
</html>
