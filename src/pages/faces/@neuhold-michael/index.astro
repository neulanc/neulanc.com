      font-size: 0.82rem;
    }

    .sport-sponsor-note {
      margin: 0 0 1rem;
      color: #506173;
      font-size: 0.96rem;
    }

    .section {
      margin-bottom: 3.5rem;
    }

    .section-header {
      position: relative;
      overflow: hidden;
      margin-bottom: 1.25rem;
      padding: 1.35rem 1.4rem;
      border: 1px solid rgba(0, 102, 204, 0.14);
      border-radius: 22px;
      background:
        linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(245, 250, 255, 0.96));
      box-shadow: 0 18px 42px rgba(16, 30, 54, 0.08);
      cursor: pointer;
      transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
    }

    .section-header::after {
      content: '';
      position: absolute;
      inset: auto -10% -55% auto;
      width: 240px;
      height: 240px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(0, 170, 255, 0.16), transparent 68%);
      pointer-events: none;
    }

    .section-header:hover {
      transform: translateY(-2px);
      border-color: rgba(0, 102, 204, 0.28);
      box-shadow: 0 22px 52px rgba(16, 30, 54, 0.12);
    }

    .section-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      margin-bottom: 0.55rem;
      padding: 0.28rem 0.7rem;
      border-radius: 999px;
      background: rgba(0, 102, 204, 0.08);
      color: #0052a6;
      font-size: 0.76rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .section-header h2 {
      font-size: 2rem;
      font-weight: 700;
      color: #09192d;
      line-height: 1.1;
      margin-bottom: 0.55rem;
    }

    .section-subtitle {
      max-width: 72ch;
      color: #536273;
      font-size: 0.98rem;
    }

    .social-links {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-top: 1.5rem;
    }

    .social-row {
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
    }

    .social-links a {
      color: #0066cc;
      text-decoration: none;
      font-size: 0.95rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.3rem;
      transition: all 0.2s ease;
    }

    .social-links a:hover {
      color: #0088ff;
      transform: translateY(-2px);
    }

    .social-links a svg {
      width: 24px;
      height: 24px;
      fill: currentColor;
    }

    .year-section {
      position: relative;
      margin-bottom: 1.2rem;
    }

    .year-header {
      padding: 0.2rem 0 0.9rem;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .year-header:hover h3 {
      color: #0066cc;
    }

    .year-header h3 {
      font-size: 1.5rem;
      font-weight: 600;
      color: #16314d;
      transition: color 0.2s ease;
    }

    .items {
      margin-left: 3rem;
      margin-bottom: 2rem;
      position: relative;
    }

    /* Creative animated line */
    .items::before {
      content: '';
      position: absolute;
      left: -2rem;
      top: 0;
      bottom: 0;
      width: 2px;
      background: linear-gradient(
        180deg,
        transparent 0%,
        #0066cc 10%,
        #00aaff 50%,
        #0066cc 90%,
        transparent 100%
      );
      animation: lineGlow 2s ease-in-out infinite alternate;
    }

    /* Animated dots flowing down the line */
    .items::after {
      content: '';
      position: absolute;
      left: calc(-2rem - 2px);
      top: 0;
      width: 6px;
      height: 6px;
      background: #00aaff;
      border-radius: 50%;
      box-shadow: 0 0 10px #00aaff, 0 0 20px rgba(0, 170, 255, 0.5);
      animation: dotFlow 3s ease-in-out infinite;
    }

    @keyframes lineGlow {
      0% {
        opacity: 0.5;
        box-shadow: 0 0 5px rgba(0, 102, 204, 0.3);
      }
      100% {
        opacity: 1;
        box-shadow: 0 0 15px rgba(0, 170, 255, 0.6);
      }
    }

    @keyframes dotFlow {
      0% {
        top: 0%;
        opacity: 0;
      }
      10% {
        opacity: 1;
      }
      90% {
        opacity: 1;
      }
      100% {
        top: 100%;
        opacity: 0;
      }
    }

    .item {
      margin-bottom: 1rem;
      padding: 1.2rem 1.2rem 1.15rem;
      border: 1px solid rgba(20, 47, 79, 0.08);
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.92);
      box-shadow: 0 10px 28px rgba(16, 30, 54, 0.05);
      position: relative;
      transition: all 0.3s ease;
    }

    /* Item indicator dot - perfectly centered on line */
    .item::before {
      content: '';
      position: absolute;
      left: calc(-2rem - 6px);
      top: 0.4rem;
      width: 12px;
      height: 12px;
      background: #fff;
      border: 3px solid #0066cc;
      border-radius: 50%;
      z-index: 2;
      transition: all 0.3s ease;
    }

    .item:hover::before {
      transform: scale(1.4);
      border-color: #00aaff;
      box-shadow: 0 0 0 4px rgba(0, 170, 255, 0.2), 0 0 15px rgba(0, 170, 255, 0.4);
      background: #00aaff;
    }

    .item:hover {
      transform: translateX(4px);
    }

    .item:hover h4 {
      color: #0066cc;
    }

    .item:last-child {
      border-bottom: none;
    }

    .item h4 {
      font-size: 1.08rem;
      font-weight: 700;
      margin-bottom: 0.45rem;
      color: #08192c;
      letter-spacing: -0.01em;
    }

    .item-meta {
      display: inline-flex;
      align-items: center;
      margin-bottom: 0.7rem;
      padding: 0.24rem 0.65rem;
      border-radius: 999px;
      background: rgba(0, 102, 204, 0.08);
      color: #0052a6;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.02em;
    }

    .item p {
      color: #506173;
      font-size: 0.96rem;
      margin-bottom: 0.5rem;
    }

    .item p:last-child {
      margin-bottom: 0;
    }

    .item a {
      color: #0066cc;
      text-decoration: none;
    }

    .item a:hover {
      text-decoration: underline;
    }

    .sport-text-links .item {
      display: block;
      width: 100%;
      color: #243042;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
    }

    .sport-text-links .item:hover {
      text-decoration: underline;
    }

    .thesis-abstract {
      margin-top: 0.9rem;
      border: 1px solid #d8e6f7;
      border-radius: 10px;
      background: #f8fbff;
      overflow: hidden;
    }

    .thesis-abstract summary {
      list-style: none;
      cursor: pointer;
      padding: 0.7rem 0.9rem;
      font-size: 0.95rem;
      font-weight: 600;
      color: #005bb5;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.8rem;
    }

    .thesis-abstract summary::-webkit-details-marker {
      display: none;
    }

    .thesis-abstract summary::after {
      content: '▾';
      font-size: 0.9rem;
      transition: transform 0.2s ease;
    }

    .thesis-abstract[open] summary::after {
      transform: rotate(180deg);
    }

    .thesis-abstract p {
      border-top: 1px solid #d8e6f7;
      margin: 0;
      padding: 0.9rem;
      color: #555;
      font-size: 0.92rem;
    }

    .thesis-abstract-content {
      border-top: 1px solid #d8e6f7;
      padding: 0.9rem;
      color: #555;
      font-size: 0.92rem;
    }

    .thesis-abstract-content p {
      border-top: none;
      margin: 0 0 0.8rem 0;
      padding: 0;
    }

    .thesis-abstract-content p:last-child {
      margin-bottom: 0;
    }

    .math-block {
      margin: 0 0 0.8rem 0;
      padding: 0.7rem 0.9rem;
      background: #eef5ff;
      border: 1px solid #d8e6f7;
      border-radius: 8px;
      overflow-x: auto;
    }

    .section-notes {
      display: grid;
      gap: 0.7rem;
      margin-top: 1rem;
    }

    .section-notes li {
      list-style: none;
      position: relative;
      padding-left: 1.1rem;
      color: #506173;
      font-size: 0.94rem;
    }

    .section-notes li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.65em;
      width: 0.42rem;
      height: 0.42rem;
      border-radius: 999px;
      background: linear-gradient(135deg, #0066cc, #00aaff);
    }

    .sport-layout {
      display: grid;
      gap: 1.2rem;
      margin-bottom: 1.3rem;
    }

    .achievements-panel {
      padding: 1.15rem 1.2rem;
      border-radius: 20px;
      border: 1px solid rgba(0, 102, 204, 0.14);
      background: linear-gradient(160deg, rgba(255, 255, 255, 0.98), rgba(241, 248, 255, 0.94));
      box-shadow: 0 14px 30px rgba(16, 30, 54, 0.07);
    }

    .achievements-panel h3 {
      font-size: 1.05rem;
      margin-bottom: 0.8rem;
      color: #0f2842;
      letter-spacing: 0.01em;
    }

    .achievement-list {
      display: grid;
      gap: 0.55rem;
      list-style: none;
    }

    .achievement-list li {
      position: relative;
      padding: 0.62rem 0.8rem 0.62rem 1.35rem;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.86);
      border: 1px solid rgba(0, 102, 204, 0.1);
      color: #27445f;
      font-size: 0.93rem;
    }

    .achievement-list li::before {
      content: '';
      position: absolute;
      left: 0.75rem;
      top: 50%;
      width: 0.38rem;
      height: 0.38rem;
      transform: translateY(-50%);
      border-radius: 50%;
      background: linear-gradient(135deg, #0066cc, #00aaff);
      box-shadow: 0 0 0 3px rgba(0, 170, 255, 0.14);
    }

    .achievement-list a {
      color: #005ab6;
      text-decoration: none;
      font-weight: 700;
    }

    .achievement-list a:hover {
      text-decoration: underline;
    }

    .race-log {
      padding: 1.15rem 1.2rem;
      border-radius: 20px;
      border: 1px solid rgba(0, 102, 204, 0.14);
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(245, 251, 255, 0.96));
      box-shadow: 0 14px 30px rgba(16, 30, 54, 0.06);
    }

    .race-log h3 {
      font-size: 1.05rem;
      margin-bottom: 0.9rem;
      color: #0f2842;
      letter-spacing: 0.01em;
    }

    .race-year-group {
      margin-bottom: 1.25rem;
    }

    .race-year-group:last-child {
      margin-bottom: 0;
    }

    .race-year-group > h4 {
      margin-bottom: 0.62rem;
      font-size: 0.9rem;
      color: #4a6078;
      text-transform: uppercase;
      letter-spacing: 0.09em;
    }

    .race-cards-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.8rem;
      align-items: start;
    }

    .race-card {
      display: grid;
      gap: 0.52rem;
      padding: 1rem;
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.88);
      border: 1px solid rgba(0, 102, 204, 0.1);
      box-shadow: 0 8px 24px rgba(16, 30, 54, 0.05);
      scroll-margin-top: 110px;
      align-self: start;
      height: fit-content;
    }

    .race-card.is-pulsed {
      animation: racePulse 1.8s ease-out;
    }

    @keyframes racePulse {
      0% {
        transform: scale(1);
        box-shadow: 0 8px 24px rgba(16, 30, 54, 0.05);
        border-color: rgba(0, 102, 204, 0.1);
      }
      20% {
        transform: scale(1.03);
        box-shadow: 0 18px 40px rgba(0, 102, 204, 0.18);
        border-color: rgba(0, 102, 204, 0.4);
      }
      70% {
        transform: scale(1.015);
        box-shadow: 0 14px 32px rgba(0, 102, 204, 0.12);
        border-color: rgba(0, 102, 204, 0.24);
      }
      100% {
        transform: scale(1);
        box-shadow: 0 8px 24px rgba(16, 30, 54, 0.05);
        border-color: rgba(0, 102, 204, 0.1);
      }
    }

    .race-card--placeholder {
      border-style: dashed;
      background: rgba(0, 102, 204, 0.04);
      color: #6b7c8f;
    }

    .race-type {
      font-size: 0.77rem;
      font-weight: 800;
      color: #0052a6;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .race-name-location {
      font-size: 1rem;
      line-height: 1.3;
      color: #08192c;
    }

    .race-official-link {
      width: fit-content;
      color: #0066cc;
      text-decoration: none;
      font-size: 0.88rem;
      font-weight: 700;
      border-bottom: 1px dashed rgba(0, 102, 204, 0.35);
    }

    .race-official-link:hover {
      color: #0052a6;
      border-bottom-color: rgba(0, 82, 166, 0.8);
    }

    .race-times {
      display: grid;
      gap: 0.55rem;
      margin-top: 0.1rem;
    }

    .race-time-item {
      padding: 0.62rem 0.72rem;
      border-radius: 10px;
      border: 1px solid rgba(0, 102, 204, 0.1);
      background: #f7fbff;
    }

    .race-time-item p {
      margin: 0;
      color: #41566e;
      font-size: 0.88rem;
    }

    .race-time-item .race-time-value {
      margin-top: 0.2rem;
      font-size: 0.98rem;
      color: #102942;
      font-weight: 700;
    }

    .card-media {
      margin-bottom: 0.9rem;
      border-radius: 16px;
      border: 1px dashed rgba(0, 102, 204, 0.22);
      background:
        linear-gradient(135deg, rgba(0, 102, 204, 0.14), rgba(0, 170, 255, 0.07));
      min-height: 150px;
      display: grid;
      place-items: center;
      text-align: center;
      padding: 0.9rem;
      color: #0052a6;
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .card-media small {
      display: block;
      margin-top: 0.35rem;
      color: #57718b;
      font-size: 0.72rem;
      letter-spacing: 0.02em;
      text-transform: none;
      font-weight: 600;
    }

    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0.9rem;
      margin-top: 1rem;
    }

    .gallery-card {
      min-height: 160px;
      padding: 0.9rem;
      border-radius: 18px;
      border: 1px solid rgba(0, 102, 204, 0.1);
      background:
        linear-gradient(180deg, rgba(255,255,255,0.92), rgba(244,249,255,0.96));
      box-shadow: 0 12px 24px rgba(16, 30, 54, 0.05);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 0.8rem;
    }

    .gallery-visual {
      flex: 1;
      border-radius: 14px;
      border: 1px dashed rgba(0, 102, 204, 0.22);
      background:
        linear-gradient(135deg, rgba(0, 102, 204, 0.12), rgba(0, 170, 255, 0.06));
      display: grid;
      place-items: center;
      color: #0052a6;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      min-height: 92px;
    }

    .gallery-caption {
      font-size: 0.84rem;
      color: #607286;
    }

    .sport-item-media {
      margin-bottom: 0.9rem;
      min-height: 140px;
    }

    /* Smooth scrolling */
    html {
      scroll-behavior: smooth;
    }

    .inline-link {
      color: #0066cc;
      text-decoration: none;
      font-weight: 600;
    }

    .inline-link:hover {
      text-decoration: underline;
    }

    #page-top,
    .section {
      scroll-margin-top: 6.5rem;
    }

    /* Floating portfolio navigation */
    .portfolio-nav {
      position: fixed;
      top: calc(16px + env(safe-area-inset-top, 0px));
      left: 50%;
      align-items: center;
      z-index: 300;
      display: flex;
      width: min(980px, calc(100% - 32px));
      min-height: 58px;
      padding: 0.38rem;
      transform: translateX(-50%);
      border: 1px solid rgba(21, 53, 84, 0.11);
      border-radius: 19px;
      background: rgba(251, 253, 255, 0.88);
      box-shadow: 0 12px 35px rgba(13, 35, 61, 0.12), 0 2px 8px rgba(13, 35, 61, 0.06);
      backdrop-filter: blur(18px) saturate(150%);
      -webkit-backdrop-filter: blur(18px) saturate(150%);
    }

    .nav-bar,
    .nav-drawer,
    .nav-links,
    .nav-meta {
      display: flex;
      align-items: center;
    }

    .nav-bar {
      flex: 0 0 auto;
    }

    .nav-identity {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      color: #10243a;
      text-decoration: none;
    }

    .nav-monogram {
      display: grid;
      width: 42px;
      height: 42px;
      place-items: center;
      border-radius: 13px;
      background: linear-gradient(145deg, #0877dd, #0055ad);
      box-shadow: 0 7px 16px rgba(0, 102, 204, 0.24);
      color: #fff;
      font-size: 0.76rem;
      font-weight: 850;
      letter-spacing: 0.055em;
    }

    .nav-current {
      display: none;
      min-width: 0;
    }

    .nav-current small,
    .nav-current strong {
      display: block;
    }

    .nav-current small {
      margin-bottom: 0.08rem;
      color: #738397;
      font-size: 0.61rem;
      font-weight: 750;
      letter-spacing: 0.1em;
      line-height: 1;
      text-transform: uppercase;
    }

    .nav-current strong {
      overflow: hidden;
      color: #122a43;
      font-size: 0.86rem;
      line-height: 1.15;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .nav-drawer {
      flex: 1;
      min-width: 0;
    }

    .nav-drawer-inner {
      display: flex;
      flex: 1;
      min-width: 0;
      align-items: center;
      justify-content: space-between;
    }

    .nav-links {
      min-width: 0;
      gap: 0.15rem;
      margin-left: 0.35rem;
    }

    .nav-link {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.38rem;
      min-height: 42px;
      padding: 0.55rem 0.64rem;
      border-radius: 12px;
      color: #536579;
      font-size: 0.76rem;
      font-weight: 700;
      line-height: 1;
      text-decoration: none;
      white-space: nowrap;
      transition: color 0.2s ease, background 0.2s ease, transform 0.2s ease;
    }

    .nav-link:hover {
      color: #005bb7;
      background: rgba(0, 102, 204, 0.07);
    }

    .nav-identity:focus-visible,
    .nav-link:focus-visible,
    .menu-toggle:focus-visible {
      outline: 3px solid rgba(0, 102, 204, 0.28);
      outline-offset: 2px;
    }

    .nav-link.active {
      color: #004f9f;
      background: rgba(0, 102, 204, 0.095);
    }

    .nav-link.active::after {
      content: '';
      position: absolute;
      right: 0.65rem;
      bottom: 0.3rem;
      left: 0.65rem;
      height: 2px;
      border-radius: 2px;
      background: linear-gradient(90deg, #0066cc, #35b6f2);
    }

    .nav-icon {
      color: #718399;
      font-size: 0.62rem;
      font-weight: 850;
      letter-spacing: 0.04em;
    }

    .nav-meta {
      flex: 0 0 auto;
      margin-left: 0.35rem;
      padding-left: 0.45rem;
      border-left: 1px solid rgba(21, 53, 84, 0.1);
    }

    .nav-meta-label,
    .nav-menu-heading,
    .menu-toggle,
    .nav-backdrop {
      display: none;
    }

    .nav-meta :global(.lang-link) {
      padding: 0.38rem 0.48rem;
      border: 0;
      border-radius: 9px;
      background: transparent;
      color: #66778a;
      font-size: 0.7rem;
    }

    .nav-meta :global(.lang-link.active) {
      background: #0b68c5;
      color: #fff;
    }

    .nav-meta :global(.flag) {
      font-size: 0.82rem;
    }

    .nav-meta :global(.lang-name) {
      font-size: 0.7rem;
    }

    @media (max-width: 880px) {
      body {
        scroll-padding-top: 5.5rem;
      }

      #page-top,
      .section {
        scroll-margin-top: 5.5rem;
      }

      .portfolio-nav {
        left: auto;
        right: 12px;
        display: block;
        width: min(360px, calc(100% - 24px));
        min-height: 0;
        padding: 0;
        transform: none;
        border-radius: 21px;
        background: rgba(251, 253, 255, 0.94);
        box-shadow: 0 16px 44px rgba(9, 31, 55, 0.18), 0 2px 8px rgba(9, 31, 55, 0.06);
        transition:
          width 0.42s cubic-bezier(0.22, 1, 0.36, 1),
          border-radius 0.35s ease,
          box-shadow 0.35s ease;
      }

      .portfolio-nav:not(.is-open) {
        width: 198px;
        border-radius: 18px;
      }

      .portfolio-nav.is-open {
        max-height: calc(100dvh - 28px - env(safe-area-inset-top, 0px));
        overflow-y: auto;
        overscroll-behavior: contain;
        box-shadow: 0 24px 64px rgba(9, 31, 55, 0.24), 0 3px 10px rgba(9, 31, 55, 0.08);
      }

      .nav-bar {
        position: relative;
        z-index: 2;
        justify-content: space-between;
        width: 100%;
        min-height: 56px;
        padding: 0.4rem;
      }

      .nav-identity {
        min-width: 0;
      }

      .nav-current {
        display: block;
        width: 80px;
      }

      .menu-toggle {
        position: relative;
        display: grid;
        flex: 0 0 auto;
        width: 42px;
        height: 42px;
        padding: 0;
        place-items: center;
        border: 0;
        border-radius: 12px;
        background: #edf5fd;
        color: #0d5ca8;
        cursor: pointer;
        transition:
          color 0.25s ease,
          background 0.25s ease,
          transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .portfolio-nav.is-open .menu-toggle {
        background: #0b68c5;
        color: #fff;
        transform: scale(0.94);
      }

      .menu-toggle-lines {
        position: relative;
        width: 18px;
        height: 14px;
      }

      .menu-toggle-lines::before,
      .menu-toggle-lines::after,
      .menu-toggle-lines span {
        content: '';
        position: absolute;
        left: 0;
        width: 18px;
        height: 2px;
        border-radius: 2px;
        background: currentColor;
        transition: top 0.22s ease, transform 0.22s ease, opacity 0.18s ease;
      }

      .menu-toggle-lines::before {
        top: 0;
      }

      .menu-toggle-lines span {
        top: 6px;
      }

      .menu-toggle-lines::after {
        top: 12px;
      }

      .portfolio-nav.is-open .menu-toggle-lines::before {
        top: 6px;
        transform: rotate(45deg);
      }

      .portfolio-nav.is-open .menu-toggle-lines span {
        opacity: 0;
      }

      .portfolio-nav.is-open .menu-toggle-lines::after {
        top: 6px;
        transform: rotate(-45deg);
      }

      .nav-drawer {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-rows: 0fr;
        opacity: 0;
        transform: translate3d(14px, -10px, 0) scale(0.975);
        transform-origin: top right;
        pointer-events: none;
        transition:
          grid-template-rows 0.38s cubic-bezier(0.22, 1, 0.36, 1),
          opacity 0.18s ease,
          transform 0.38s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .nav-drawer-inner {
        display: block;
        min-height: 0;
        overflow: hidden;
      }

      .portfolio-nav.is-open .nav-drawer {
        grid-template-rows: 1fr;
        opacity: 1;
        transform: translate3d(0, 0, 0) scale(1);
        pointer-events: auto;
      }

      .nav-menu-heading {
        display: block;
        margin: 0 0.85rem;
        padding: 0.7rem 0.15rem 0.58rem;
        border-top: 1px solid rgba(21, 53, 84, 0.09);
        color: #7a8999;
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .nav-menu-heading,
      .nav-link,
      .nav-meta {
        opacity: 0;
        transform: translate3d(20px, -3px, 0);
        transition:
          opacity 0.16s ease,
          transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .portfolio-nav.is-open .nav-menu-heading,
      .portfolio-nav.is-open .nav-link,
      .portfolio-nav.is-open .nav-meta {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }

      .portfolio-nav.is-open .nav-menu-heading {
        transition-delay: 0.08s;
      }

      .portfolio-nav.is-open .nav-link:nth-child(1) {
        transition-delay: 0.11s;
      }

      .portfolio-nav.is-open .nav-link:nth-child(2) {
        transition-delay: 0.14s;
      }

      .portfolio-nav.is-open .nav-link:nth-child(3) {
        transition-delay: 0.17s;
      }

      .portfolio-nav.is-open .nav-link:nth-child(4) {
        transition-delay: 0.2s;
      }

      .portfolio-nav.is-open .nav-link:nth-child(5) {
        transition-delay: 0.23s;
      }

      .portfolio-nav.is-open .nav-link:nth-child(6) {
        transition-delay: 0.26s;
      }

      .portfolio-nav.is-open .nav-meta {
        transition-delay: 0.29s;
      }

      .nav-links {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.45rem;
        margin: 0;
        padding: 0 0.75rem;
      }

      .nav-link {
        display: grid;
        grid-template-columns: 30px minmax(0, 1fr);
        gap: 0.55rem;
        min-height: 52px;
        padding: 0.62rem 0.7rem;
        border: 1px solid rgba(21, 53, 84, 0.075);
        border-radius: 14px;
        background: rgba(243, 248, 253, 0.72);
        color: #334b64;
        font-size: 0.79rem;
      }

      .nav-link:hover,
      .nav-link.active {
        border-color: rgba(0, 102, 204, 0.18);
        background: rgba(0, 102, 204, 0.075);
        color: #0056ab;
      }

      .nav-link.active::after {
        top: 50%;
        right: auto;
        bottom: auto;
        left: -1px;
        width: 3px;
        height: 24px;
        transform: translateY(-50%);
        border-radius: 0 3px 3px 0;
        background: #0876d5;
      }

      .nav-icon {
        display: grid;
        width: 30px;
        height: 30px;
        place-items: center;
        border-radius: 9px;
        background: #fff;
        box-shadow: 0 2px 7px rgba(23, 52, 80, 0.08);
        color: #607790;
        font-size: 0.62rem;
        font-weight: 850;
      }

      .nav-meta {
        justify-content: space-between;
        margin: 0.72rem 0.75rem 0;
        padding: 0.72rem 0.1rem 0.78rem;
        border-top: 1px solid rgba(21, 53, 84, 0.09);
        border-left: 0;
      }

      .nav-meta-label {
        display: block;
        color: #536579;
        font-size: 0.75rem;
        font-weight: 700;
      }

      .nav-meta :global(.lang-link) {
        padding: 0.42rem 0.55rem;
        background: #f0f5fa;
      }

      .nav-meta :global(.lang-link.active) {
        background: #0b68c5;
      }

      .nav-backdrop {
        position: fixed;
        inset: 0;
        z-index: 290;
        display: block;
        border: 0;
        background: rgba(8, 24, 42, 0.14);
        opacity: 0;
        visibility: hidden;
        backdrop-filter: blur(2px);
        -webkit-backdrop-filter: blur(2px);
        transition: opacity 0.2s ease, visibility 0.2s;
      }

      .nav-backdrop.is-visible {
        opacity: 1;
        visibility: visible;
      }
    }

    @media (max-width: 768px) {
      .container {
        padding: 6.1rem 1rem 2rem;
      }

      .about-content {
        flex-direction: column;
      }

      .portrait {
        width: 150px;
        height: 150px;
      }

      .about h1 {
        font-size: 2rem;
      }

      .current-strip {
        align-items: flex-start;
        flex-direction: column;
        gap: 0.62rem;
      }

      .current-strip-items {
        width: 100%;
      }

      .sponsor-cta {
        align-items: flex-start;
        flex-direction: column;
      }

      .section-header {
        padding: 1.05rem 1rem;
      }

      .section-header h2 {
        font-size: 1.5rem;
      }

      .race-cards-grid,
      .gallery-grid {
        grid-template-columns: 1fr;
      }

      .card-media,
      .sport-item-media {
        min-height: 120px;
      }

      .achievements-panel,
      .race-log {
        padding: 1rem 0.9rem;
      }

      .year-header h3 {
        font-size: 1.2rem;
      }

      .items {
        margin-left: 1.5rem;
      }

      .items::before {
        left: -1rem;
      }

      .items::after {
        left: calc(-1rem - 2px);
      }

      .item::before {
        left: calc(-1rem - 6px);
      }
    }

    @media (max-width: 340px) {
      .portfolio-nav:not(.is-open) {
        width: 184px;
      }

      .nav-current {
        width: 69px;
      }

      .nav-links {
        grid-template-columns: 1fr;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .portfolio-nav,
      .nav-drawer,
      .nav-menu-heading,
      .nav-link,
      .nav-meta,
      .menu-toggle,
      .menu-toggle-lines::before,
      .menu-toggle-lines::after,
      .menu-toggle-lines span {
        transition: none;
      }
    }
  </style>
</head>
<body id="page-top">

<button class="nav-backdrop" id="navBackdrop" type="button" tabindex="-1" aria-hidden="true"></button>
<header class="portfolio-nav" id="portfolioNav">
  <div class="nav-bar">
    <a class="nav-identity" href="#page-top" aria-label={tr('Zum Seitenanfang', 'Back to top')}>
      <span class="nav-monogram" aria-hidden="true">MN</span>
      <span class="nav-current" aria-live="polite">
        <small>{tr('Gerade hier', 'You are here')}</small>
        <strong id="navCurrentLabel">{navigationItems[0].label}</strong>
      </span>
    </a>
    <button
      class="menu-toggle"
      id="menuToggle"
      type="button"
      aria-expanded="false"
      aria-controls="portfolioNavMenu"
      aria-label={tr('Navigation öffnen', 'Open navigation')}
      data-label-open={tr('Navigation öffnen', 'Open navigation')}
      data-label-close={tr('Navigation schließen', 'Close navigation')}
    >
      <span class="menu-toggle-lines" aria-hidden="true"><span></span></span>
    </button>
  </div>

  <div class="nav-drawer" id="portfolioNavMenu">
    <div class="nav-drawer-inner">
      <p class="nav-menu-heading">{tr('Portfolio entdecken', 'Explore portfolio')}</p>
      <nav class="nav-links" aria-label={tr('Portfolio-Navigation', 'Portfolio navigation')}>
        {navigationItems.map((item, index) => (
          <a
            class:list={['nav-link', { active: index === 0 }]}
            href={item.href}
            data-nav-link
            data-nav-label={item.label}
            aria-current={index === 0 ? 'location' : undefined}
          >
            <span class="nav-icon" aria-hidden="true">{item.index}</span>
            <span>{item.label}</span>
          </a>
        ))}
      </nav>
      <div class="nav-meta">
        <span class="nav-meta-label">{tr('Sprache', 'Language')}</span>
        <LanguageSwitcher currentLocale={locale} currentPath={Astro.url.pathname.replace(/^\/faces/, '') || '/'} />
      </div>
    </div>
  </div>
</header>

<div class="container">
  <!-- About -->
  <section class="about">
    <h1>Michael Neuhold</h1>
    <div class="about-content">
      <img src={main_pic.src} alt="Michael Neuhold" class="portrait">
      <div class="bio">
        <p class="bio-intro">{tr('Software-Engineering-Student und Triathlet.', 'Software engineering student and triathlete.')}</p>
        <p class="bio-age">
          <span id="ageYears"></span> {tr('Jahre alt', 'years old')}
          · <span id="ageDays"></span> {tr('Tage', 'days')} :)
        </p>

        <div class="current-strip" aria-label={tr('Aktuelle Schwerpunkte', 'Current focus')}>
          <span class="current-strip-label">
            <span class="current-strip-dot" aria-hidden="true"></span>
            {tr('Aktuell', 'Currently')}
          </span>
          <ul class="current-strip-items">
            <li class="current-strip-item">
              <span>Software Engineering and Management · TU Graz</span>
            </li>
            <li class="current-strip-item">
              <span>Teaching Assistant · TU Graz</span>
            </li>
            <li class="current-strip-item">
              <span>{tr('Triathlon-Saison 2026', '2026 triathlon season')}</span>
            </li>
          </ul>
        </div>

        <div class="current-strip upcoming-strip" aria-label={tr('Anstehende Wettkämpfe', 'Upcoming events')}>
          <span class="current-strip-label">
            <span class="current-strip-dot" aria-hidden="true"></span>
            {tr('Als Nächstes', 'Upcoming')}
          </span>
