  <script>
    const loadMathJax = () => {
      if (document.getElementById('MathJax-script')) return;

      Object.assign(window, {
        MathJax: {
          tex: {
            inlineMath: [['\\(', '\\)']],
            displayMath: [['$$', '$$']]
          },
          svg: {
            fontCache: 'global'
          }
        }
      });

      const mathJaxScript = document.createElement('script');
      mathJaxScript.id = 'MathJax-script';
      mathJaxScript.async = true;
      mathJaxScript.src = 'https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js';
      document.head.appendChild(mathJaxScript);
    };

    document.addEventListener('neulanc:consentchange', (event) => {
      if (event instanceof CustomEvent && event.detail?.choice === 'all') loadMathJax();
    });

    try {
      const savedConsent = JSON.parse(localStorage.getItem('neulanc-consent-v1') || 'null');
      const isCurrentConsent = savedConsent && Date.now() - savedConsent.savedAt < 1000 * 60 * 60 * 24 * 180;
      if (isCurrentConsent && savedConsent.choice === 'all') loadMathJax();
    } catch {
      // Keep formulas as readable TeX when storage is unavailable.
    }
  </script>
  
  <title>Michael Neuhold</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      background:
        radial-gradient(circle at top left, rgba(0, 102, 204, 0.08), transparent 30%),
        radial-gradient(circle at top right, rgba(0, 170, 255, 0.07), transparent 26%),
        linear-gradient(180deg, #f8fbff 0%, #ffffff 28%, #f6f9fc 100%);
      color: #243042;
      line-height: 1.6;
      min-height: 100vh;
      scroll-padding-top: 90px;
    }

    .container {
      max-width: 1040px;
      margin: 0 auto;
      padding: 6.5rem 2rem 4rem;
    }

    /* Header / About Section */
    .about {
      margin-bottom: 4rem;
    }

    .about h1 {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 1rem;
      color: #000;
    }

    .about-content {
      display: flex;
      gap: 2rem;
      align-items: flex-start;
      margin-bottom: 2rem;
    }

    .portrait {
      width: 180px;
      height: 180px;
      border-radius: 8px;
      object-fit: cover;
      flex-shrink: 0;
    }

    .bio {
      flex: 1;
      font-size: 1.05rem;
      color: #555;
    }

    .bio-intro {
      max-width: 560px;
      color: #34465a;
      font-size: 1.15rem;
      margin-bottom: 0.35rem;
    }

    .bio-age {
      color: #718095;
      font-size: 0.9rem;
    }

    .current-strip {
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      gap: 0.8rem;
      margin-top: 1.45rem;
      padding: 0.75rem;
      border: 1px solid rgba(0, 102, 204, 0.13);
      border-radius: 16px;
      background: linear-gradient(135deg, rgba(238, 247, 255, 0.92), rgba(255, 255, 255, 0.92));
      box-shadow: 0 9px 22px rgba(16, 30, 54, 0.05);
    }

    .current-strip::after {
      content: '';
      position: absolute;
      top: -45px;
      right: -30px;
      width: 100px;
      height: 100px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(0, 170, 255, 0.13), transparent 68%);
      pointer-events: none;
    }

    .current-strip-label {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: center;
      gap: 0.42rem;
      padding: 0 0.2rem;
      color: #526980;
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.11em;
      text-transform: uppercase;
    }

    .current-strip-dot {
      width: 0.48rem;
      height: 0.48rem;
      border-radius: 50%;
      background: #16a56f;
      box-shadow: 0 0 0 4px rgba(22, 165, 111, 0.11);
    }

    .upcoming-strip {
      margin-top: 0.65rem;
      border-color: rgba(211, 133, 17, 0.16);
      background: linear-gradient(135deg, rgba(255, 248, 235, 0.92), rgba(255, 255, 255, 0.92));
    }

    .upcoming-strip::after {
      background: radial-gradient(circle, rgba(245, 158, 11, 0.13), transparent 68%);
    }

    .upcoming-strip .current-strip-dot {
      background: #e99a19;
      box-shadow: 0 0 0 4px rgba(233, 154, 25, 0.12);
    }

    .current-strip-items {
      position: relative;
      z-index: 1;
      display: flex;
      flex-wrap: wrap;
      gap: 0.42rem;
      min-width: 0;
      list-style: none;
    }

    .current-strip-item {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.4rem 0.58rem;
      border: 1px solid rgba(24, 60, 94, 0.08);
      border-radius: 10px;
      background: rgba(255, 255, 255, 0.86);
      box-shadow: 0 2px 7px rgba(16, 30, 54, 0.035);
      color: #314a63;
      font-size: 0.76rem;
      font-weight: 680;
      line-height: 1.2;
    }

    .sponsor-section {
      margin-bottom: 3.5rem;
    }

    .sponsor-list {
      display: grid;
      gap: 0.9rem;
      margin-top: 1rem;
    }

    .sponsor-cta {
      display: flex;
      gap: 1.25rem;
      align-items: center;
      justify-content: space-between;
      margin-top: 1rem;
      padding: 1.15rem 1.25rem;
      border: 1px solid rgba(0, 102, 204, 0.18);
      border-radius: 18px;
      background: linear-gradient(135deg, rgba(0, 102, 204, 0.08), rgba(0, 170, 255, 0.05));
