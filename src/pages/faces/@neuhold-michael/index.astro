      margin-top: 0.15rem;
      color: #5d6e81;
      font-size: 0.9rem;
    }

    .sponsor-cta-link {
      flex-shrink: 0;
      padding: 0.65rem 0.9rem;
      border-radius: 11px;
      background: #0066cc;
      color: #fff;
      font-size: 0.87rem;
      font-weight: 700;
      text-decoration: none;
      white-space: nowrap;
    }

    .sponsor-cta-link:hover {
      background: #0055aa;
    }

    .sponsor-item {
      display: grid;
      grid-template-columns: 64px minmax(0, 1fr);
      gap: 0.9rem;
      align-items: center;
      padding: 0.95rem 1rem;
      border: 1px solid rgba(0, 102, 204, 0.14);
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.94);
      box-shadow: 0 10px 26px rgba(16, 30, 54, 0.05);
      color: inherit;
      text-decoration: none;
    }

    .sponsor-item:hover {
      border-color: rgba(0, 102, 204, 0.24);
      transform: translateY(-1px);
    }

    .sponsor-logo {
      width: 64px;
      height: 64px;
      border-radius: 14px;
