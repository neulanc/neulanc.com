---
import { getLocalizedPath, type Locale } from '../i18n/utils';

interface Props {
  currentLocale: Locale;
  currentPath: string;
}

const { currentLocale, currentPath } = Astro.props;

const languages = [
  { code: 'de', name: 'Deutsch', flag: '🇩🇪' },
  { code: 'en', name: 'English', flag: '🇬🇧' }
];

---

<div class="language-switcher">
  {languages.map(lang => (
    <a
      href={getLocalizedPath(currentPath, lang.code as Locale)}
      data-locale={lang.code}
      class:list={['lang-link', { active: currentLocale === lang.code }]}
      aria-label={`Switch to ${lang.name}`}
    >
      <span class="flag">{lang.flag}</span>
      <span class="lang-name">{lang.code.toUpperCase()}</span>
    </a>
  ))}
</div>

<script>
  const preferenceKey = 'preferred-locale';

  document.querySelectorAll<HTMLAnchorElement>('.language-switcher [data-locale]').forEach(link => {
    link.addEventListener('click', () => {
      const selectedLocale = link.dataset.locale;
      if (selectedLocale) localStorage.setItem(preferenceKey, selectedLocale);
    });
  });

  const savedLocale = localStorage.getItem(preferenceKey);
  const systemLocale = navigator.language.toLowerCase().startsWith('de') ? 'de' : 'en';
  const wantedLocale = savedLocale === 'de' || savedLocale === 'en' ? savedLocale : systemLocale;
  const currentLocale = document.documentElement.lang;

  if (wantedLocale !== currentLocale) {
    const pathWithoutLocale = window.location.pathname.replace(/^\/(de|en)(?=\/|$)/, '') || '/';
    const localizedPath = wantedLocale === 'de' ? pathWithoutLocale : `/en${pathWithoutLocale}`;
    window.location.replace(`${localizedPath}${window.location.search}${window.location.hash}`);
  }
</script>

<style>
  .language-switcher {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    max-width: 100%;
  }

  .lang-link {
    display: inline-flex;
    align-items: center;
    gap: 0.24rem;
    padding: 0.32rem 0.55rem;
    border-radius: 10px;
    text-decoration: none;
    color: #666;
    background: #f5f5f5;
    border: 1px solid #e0e0e0;
    transition: all 0.2s ease;
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.1;
    white-space: nowrap;
  }

  .lang-link:hover {
    background: #e8e8e8;
    color: #333;
    border-color: #ccc;
  }

  .lang-link.active {
    background: #0066cc;
    color: #fff;
    border-color: #0066cc;
  }

  .flag {
    font-size: 0.95rem;
    line-height: 1;
  }

  .lang-name {
    font-size: 0.8rem;
    line-height: 1;
  }
</style>
