    };

    const renderStats = () => {
      const entries = filteredExpenses();
      const project = activeProject();
      const expenses = entries.filter(entry => entry.type === 'expense');
      const income = entries.filter(entry => entry.type === 'income');
      const total = expenses.reduce((sum, expense) => sum + expense.amount, 0);
      const totalIncome = income.reduce((sum, entry) => sum + entry.amount, 0);
      $('[data-total-spent]').textContent = money(total, true);
      $('[data-total-income]').textContent = money(totalIncome, true);
      const balance = totalIncome - total;
      $('[data-balance]').textContent = money(balance, true);
      $('[data-balance]').classList.toggle('negative', balance < 0);
      $<HTMLElement>('.stats').classList.toggle('dual', project.trackingMode === 'both');
      $('[data-income-stat]').hidden = project.trackingMode !== 'both';
      $('[data-balance-stat]').hidden = project.trackingMode !== 'both';
      const allSpent = project.expenses.filter(entry => entry.type === 'expense').reduce((sum, expense) => sum + expense.amount, 0);
      $('[data-budget-left]').classList.remove('negative');
      if (project.budget === null) {
        $('[data-budget-left]').textContent = '—';
        $('[data-budget-meta]').textContent = locale === 'de' ? 'kein Budget gesetzt' : 'no budget set';
      } else {
