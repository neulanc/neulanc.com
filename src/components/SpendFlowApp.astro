---
import type { Locale } from '../i18n/utils';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const isDe = locale === 'de';
---

<section
  class="spendflow"
  data-spendflow
  data-locale={locale}
  data-currency-locale={isDe ? 'de-AT' : 'en-IE'}
  data-storage-error={isDe ? 'Deine Änderungen konnten nicht im Browser gespeichert werden.' : 'Your changes could not be saved in this browser.'}
  data-empty={isDe ? 'Noch keine Ausgaben in diesem Zeitraum.' : 'No spending in this period yet.'}
  data-category-required={isDe ? 'Lege zuerst eine Kategorie an.' : 'Create a category first.'}
  data-saved={isDe ? 'Ausgabe gespeichert.' : 'Expense saved.'}
  data-updated={isDe ? 'Buchung aktualisiert.' : 'Expense updated.'}
  data-deleted={isDe ? 'Ausgabe gelöscht.' : 'Expense deleted.'}
  data-project-renamed={isDe ? 'Projekt aktualisiert.' : 'Project updated.'}
  data-category-in-use={isDe ? 'Diese Kategorie wird noch von Buchungen verwendet.' : 'This category is still used by entries.'}
  data-confirm-project={isDe ? 'Projekt und alle Buchungen wirklich löschen?' : 'Delete this project and all its entries?'}
  data-confirm-category={isDe ? 'Diese Kategorie wirklich löschen?' : 'Delete this category?'}
  data-rename={isDe ? 'Neuer Name' : 'New name'}
  data-sync-error={isDe ? 'Synchronisierung fehlgeschlagen. Deine lokalen Daten sind weiterhin sicher.' : 'Sync failed. Your local data is still safe.'}
  data-sync-ready={isDe ? 'Ende-zu-Ende verschlüsselt synchronisiert.' : 'Synced with end-to-end encryption.'}
  data-pair-success={isDe ? 'Dieses Gerät ist jetzt verbunden.' : 'This device is now connected.'}
  data-pair-invalid={isDe ? 'Dieser QR-Code ist abgelaufen oder wurde bereits verwendet.' : 'This QR code has expired or has already been used.'}
>
  <header class="toolbar">
    <div class="tool-title">
      <a class="back-link" href={isDe ? '/' : '/en/'} aria-label={isDe ? 'Zurück zu allen Apps' : 'Back to all apps'}>←</a>
      <span class="flow-logo" aria-hidden="true">
        <i></i><i></i><i></i>
      </span>
      <div>
        <h1>SpendFlow</h1>
        <p>{isDe ? 'Sieh, wohin jeder Euro fließt.' : 'See where every euro goes.'}</p>
      </div>
    </div>

    <div class="project-switcher">
      <label for="project-select">{isDe ? 'Projekt' : 'Project'}</label>
      <select id="project-select" data-project-select></select>
      <button class="icon-button project-edit-button" data-project-content data-edit-project hidden type="button" aria-label={isDe ? 'Projekt bearbeiten' : 'Edit project'} title={isDe ? 'Projekt bearbeiten' : 'Edit project'}>✎</button>
      <button class="icon-button" type="button" data-open-project aria-label={isDe ? 'Neues Projekt' : 'New project'} title={isDe ? 'Neues Projekt' : 'New project'}>+</button>
    </div>

    <div class="toolbar-actions" data-project-actions hidden>
      <button class="quiet-button" type="button" data-open-projects>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h6v6H4zM14 5h6v6h-6zM4 15h6v4H4zM14 15h6v4h-6z"/></svg>
        <span>{isDe ? 'Projekte' : 'Projects'}</span>
      </button>
      <button class="quiet-button sync-button" type="button" data-open-sync>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 16a5 5 0 0 1 .7-9.95A6.5 6.5 0 0 1 20 9a4 4 0 0 1-1 7.87M8 20l4-4 4 4m-4-4v7"/></svg>
        <span data-sync-button-label>{isDe ? 'Synchronisieren' : 'Sync'}</span>
        <i class="sync-dot" data-sync-dot aria-hidden="true"></i>
      </button>
      <button class="quiet-button" type="button" data-export>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 19h14"/></svg>
        {isDe ? 'Sichern' : 'Back up'}
      </button>
      <button class="quiet-button danger" type="button" data-delete-project>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3m-8 0 1 13h8l1-13M10 11v5m4-5v5"/></svg>
        <span>{isDe ? 'Projekt löschen' : 'Delete project'}</span>
      </button>
    </div>
  </header>

  <section class="project-overview" data-project-overview hidden>
    <header class="project-overview-head">
      <div>
        <span class="eyebrow">{isDe ? 'ÜBERSICHT' : 'OVERVIEW'}</span>
        <h2>{isDe ? 'Alle Projekte' : 'All projects'}</h2>
        <p>{isDe ? 'Öffne, verwalte oder lösche deine lokalen und synchronisierten Projekte.' : 'Open, manage or delete your local and synced projects.'}</p>
      </div>
      <div class="project-overview-head-actions">
        <button class="mini-button" type="button" data-overview-new-project>+ {isDe ? 'Neues Projekt' : 'New project'}</button>
        <button class="quiet-button" type="button" data-close-projects>← {isDe ? 'Zurück' : 'Back'}</button>
      </div>
    </header>
    <div class="project-overview-list" data-project-overview-list></div>
  </section>

  <section class="onboarding" data-onboarding hidden>
    <span class="onboarding-mark" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="eyebrow">{isDe ? 'DEIN GELD. DEINE STRUKTUR.' : 'YOUR MONEY. YOUR STRUCTURE.'}</span>
    <h2>{isDe ? 'Starte mit einer leeren Fläche.' : 'Start with a blank canvas.'}</h2>
    <p>{isDe ? 'Erstelle einen Tracker und baue ihn genau so auf, wie du ihn brauchst.' : 'Create a tracker and structure it exactly the way you need.'}</p>
    <button class="onboarding-button" type="button" data-create-first>
      {isDe ? 'Ersten Tracker erstellen' : 'Create your first tracker'}
      <span aria-hidden="true">→</span>
    </button>
    <button class="recovery-link" type="button" data-recover-project>{isDe ? 'Projekt mit Recovery-Datei wiederherstellen' : 'Recover a project from a recovery file'}</button>
    <input class="visually-hidden" type="file" accept="application/json,.json" data-recovery-file />
    <small>{isDe ? 'Keine Vorlagen. Keine Beispieldaten.' : 'No templates. No sample data.'}</small>
  </section>

  <div class="local-note" data-project-content hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10V8a5 5 0 0 1 10 0v2m-11 0h12v10H6V10Z"/><path d="M12 14v2"/></svg>
    <p data-privacy-note><strong>{isDe ? 'Privat auf diesem Gerät.' : 'Private on this device.'}</strong> {isDe ? 'Synchronisierung ist aus. Deine Finanzdaten verlassen den Browser nicht.' : 'Sync is off. Your financial data does not leave this browser.'}</p>
  </div>

  <div class="workspace" data-project-content hidden>
    <aside class="control-column" id="add-expense">
      <form class="panel quick-entry" data-expense-form>
        <div class="panel-heading">
          <div>
            <span class="eyebrow">{isDe ? 'SCHNELLEINGABE' : 'QUICK ENTRY'}</span>
            <h2 data-entry-form-title>{isDe ? 'Ausgabe hinzufügen' : 'Add an expense'}</h2>
          </div>
          <span class="shortcut" aria-hidden="true">⌘ ↵</span>
        </div>

        <fieldset class="entry-type-switch" data-entry-type-field hidden>
          <legend>{isDe ? 'Art der Buchung' : 'Entry type'}</legend>
          <label><input type="radio" name="entryType" value="expense" checked /><span>{isDe ? 'Ausgabe' : 'Outgoing'}</span></label>
          <label><input type="radio" name="entryType" value="income" /><span>{isDe ? 'Einnahme' : 'Incoming'}</span></label>
        </fieldset>

        <label class="amount-field">
          <span>{isDe ? 'Betrag' : 'Amount'}</span>
          <span class="amount-input"><b data-currency-symbol>€</b><input name="amount" data-amount data-money-input type="text" inputmode="decimal" autocomplete="off" placeholder="0,00" required /></span>
        </label>

        <label class="field">
          <span data-entry-name-label>{isDe ? 'Bezeichnung' : 'Entry name'}</span>
          <input name="note" maxlength="80" placeholder={isDe ? 'z. B. 70.3 Poreč' : 'e.g. 70.3 Poreč'} required />
        </label>

        <label class="field">
          <span>{isDe ? 'Kategorie' : 'Category'}</span>
          <select name="category" data-category-select required></select>
        </label>

        <div class="quick-category-create" data-quick-category-create hidden>
          <label>
            <span>{isDe ? 'Neue Kategorie' : 'New category'}</span>
            <input data-quick-category-name type="text" maxlength="40" placeholder={isDe ? 'Name der Kategorie' : 'Category name'} />
          </label>
          <label class="quick-color" title={isDe ? 'Farbe auswählen' : 'Choose color'}>
            <span class="visually-hidden">{isDe ? 'Farbe' : 'Color'}</span>
            <input data-quick-category-color type="color" value="#6657d9" />
          </label>
          <button type="button" data-save-quick-category>{isDe ? 'Hinzufügen' : 'Add'}</button>
        </div>

        <label class="field">
          <span>{isDe ? 'Datum' : 'Date'}</span>
          <input name="date" data-date type="date" required />
        </label>

        <button class="primary-button" type="submit">
          <span data-entry-submit-label>{isDe ? 'Ausgabe speichern' : 'Save expense'}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
        </button>
      </form>

      <section class="panel category-panel" id="categories" aria-labelledby="category-title">
        <div class="panel-heading compact">
          <div>
            <span class="eyebrow">{isDe ? 'STRUKTUR' : 'STRUCTURE'}</span>
            <h2 id="category-title">{isDe ? 'Kategorien' : 'Categories'}</h2>
          </div>
          <button class="mini-button" type="button" data-open-category>+ {isDe ? 'Neu' : 'New'}</button>
        </div>
        <div class="category-list" data-category-list></div>
      </section>
    </aside>

    <div class="main-column">
      <section class="stats" aria-label={isDe ? 'Projektübersicht' : 'Project overview'}>
        <article data-income-stat hidden>
          <span>{isDe ? 'Eingenommen' : 'Income'}</span>
          <strong data-total-income>€0</strong>
          <small data-income-period>{isDe ? 'gesamt' : 'all time'}</small>
        </article>
        <article>
          <span>{isDe ? 'Ausgegeben' : 'Spent'}</span>
          <strong data-total-spent>€0</strong>
          <small data-period-label>{isDe ? 'gesamt' : 'all time'}</small>
        </article>
        <article data-balance-stat hidden>
          <span>{isDe ? 'Saldo' : 'Balance'}</span>
          <strong data-balance>€0</strong>
          <small>{isDe ? 'Einnahmen minus Ausgaben' : 'Income minus outgoing'}</small>
        </article>
        <article>
          <span>{isDe ? 'Budget übrig' : 'Budget left'}</span>
          <strong data-budget-left>—</strong>
          <small data-budget-meta>{isDe ? 'kein Budget gesetzt' : 'no budget set'}</small>
        </article>
        <article>
          <span>{isDe ? 'Größte Kategorie' : 'Largest category'}</span>
          <strong data-largest-group>—</strong>
          <small data-largest-meta>—</small>
        </article>
      </section>

      <section class="panel flow-panel" id="flow" aria-labelledby="flow-title">
        <div class="flow-heading">
          <div>
            <span class="eyebrow">{isDe ? 'GELDFLUSS' : 'MONEY FLOW'}</span>
            <h2 id="flow-title" data-flow-title>{isDe ? 'Wohin dein Geld fließt' : 'Where your money goes'}</h2>
          </div>
          <div class="flow-heading-actions">
            <div class="inline-flow-zoom" aria-label={isDe ? 'Zoom-Steuerung' : 'Zoom controls'}>
              <button type="button" data-inline-flow-zoom-out aria-label={isDe ? 'Verkleinern' : 'Zoom out'}>−</button>
              <output data-inline-flow-zoom-label>100%</output>
              <button type="button" data-inline-flow-zoom-in aria-label={isDe ? 'Vergrößern' : 'Zoom in'}>+</button>
              <button class="inline-flow-zoom-reset" type="button" data-inline-flow-zoom-reset aria-label={isDe ? 'Zoom zurücksetzen' : 'Reset zoom'}>1:1</button>
            </div>
            <label class="period-filter">
              <span class="visually-hidden">{isDe ? 'Zeitraum' : 'Period'}</span>
              <select data-period>
                <option value="all">{isDe ? 'Gesamter Zeitraum' : 'All time'}</option>
                <option value="year">{isDe ? 'Dieses Jahr' : 'This year'}</option>
                <option value="30">{isDe ? 'Letzte 30 Tage' : 'Last 30 days'}</option>
              </select>
            </label>
            <button class="flow-fullscreen-button" type="button" data-open-flow-fullscreen>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M8 21H3v-5m13 5h5v-5"/></svg>
              <span>{isDe ? 'Vollbild' : 'Full screen'}</span>
            </button>
          </div>
        </div>

        <div class="flow-canvas" data-flow-canvas>
          <div class="flow-labels" data-flow-labels aria-hidden="true">
            <span>{isDe ? 'EINNAHMEN' : 'INCOME'}</span>
            <span>{isDe ? 'GESAMT' : 'TOTAL'}</span>
            <span>{isDe ? 'AUSGABEN' : 'OUTGOING'}</span>
          </div>
          <div class="flow-scroll" data-flow-scroll>
            <div class="flow-inline-zoom-surface" data-inline-flow-zoom-surface>
              <svg data-flow-svg viewBox="0 0 980 440" role="img" aria-labelledby="flow-title flow-description">
                <desc id="flow-description">{isDe ? 'Sankey-Diagramm der Ausgaben nach Kategorie.' : 'Sankey diagram of expenses by category.'}</desc>
              </svg>
            </div>
          </div>
          <div class="empty-state" data-empty-state hidden>
            <span aria-hidden="true">↗</span>
            <h3>{isDe ? 'Dein Flow beginnt hier.' : 'Your flow starts here.'}</h3>
            <p>{isDe ? 'Füge links deine erste Ausgabe hinzu.' : 'Add your first expense on the left.'}</p>
          </div>
        </div>
      </section>

      <section class="panel transactions" id="transactions" aria-labelledby="transactions-title">
        <div class="panel-heading compact">
          <div>
            <span class="eyebrow">{isDe ? 'VERLAUF' : 'ACTIVITY'}</span>
            <h2 id="transactions-title" data-transactions-title>{isDe ? 'Letzte Ausgaben' : 'Recent expenses'}</h2>
          </div>
          <span class="entry-count" data-entry-count>0</span>
        </div>
        <div class="transaction-list" data-transaction-list></div>
      </section>
    </div>
  </div>

  <dialog class="flow-fullscreen-dialog" data-flow-fullscreen-dialog aria-label={isDe ? 'Geldfluss im Vollbild' : 'Money flow in full screen'}>
    <div class="flow-fullscreen-shell">
      <header class="flow-fullscreen-toolbar">
        <div>
          <span class="eyebrow">{isDe ? 'GELDFLUSS' : 'MONEY FLOW'}</span>
          <strong>{isDe ? 'Vollbildansicht' : 'Full-screen view'}</strong>
        </div>
        <div class="flow-zoom-controls" aria-label={isDe ? 'Zoom-Steuerung' : 'Zoom controls'}>
          <button type="button" data-flow-zoom-out aria-label={isDe ? 'Verkleinern' : 'Zoom out'}>−</button>
          <output data-flow-zoom-label>100%</output>
          <button type="button" data-flow-zoom-in aria-label={isDe ? 'Vergrößern' : 'Zoom in'}>+</button>
          <button class="flow-zoom-reset" type="button" data-flow-zoom-reset>{isDe ? 'Zurücksetzen' : 'Reset'}</button>
          <button class="flow-fullscreen-close" type="button" data-close-flow-fullscreen aria-label={isDe ? 'Vollbild schließen' : 'Close full screen'}>×</button>
        </div>
      </header>
      <div class="flow-fullscreen-viewport" data-flow-fullscreen-viewport>
        <div class="flow-zoom-surface" data-flow-zoom-surface></div>
      </div>
      <p class="flow-gesture-hint">{isDe ? 'Ziehen zum Verschieben · Zwei Finger oder Strg/⌘ + Mausrad zum Zoomen' : 'Drag to move · Pinch or Ctrl/⌘ + mouse wheel to zoom'}</p>
    </div>
  </dialog>

  <nav class="mobile-nav" data-project-content hidden aria-label={isDe ? 'App-Navigation' : 'App navigation'}>
    <a href="#flow"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 18V9m6 9V5m6 13v-7m4 7H2"/></svg><span>Flow</span></a>
    <a href="#transactions"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4h12v16H6zM9 8h6m-6 4h6m-6 4h4"/></svg><span data-mobile-entries-label>{isDe ? 'Ausgaben' : 'Expenses'}</span></a>
    <a href="#categories"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h7v6H4zM13 4h7v6h-7zm0 8h7v8h-7zM4 15h7v5H4z"/></svg><span>{isDe ? 'Kategorien' : 'Categories'}</span></a>
  </nav>
  <button class="mobile-add" data-project-content data-mobile-add hidden type="button" aria-label={isDe ? 'Ausgabe hinzufügen' : 'Add expense'}>+</button>

  <dialog class="app-dialog" data-category-dialog>
    <form data-category-form>
      <div class="dialog-head">
        <div>
          <span class="eyebrow">{isDe ? 'STRUKTUR' : 'STRUCTURE'}</span>
          <h2>{isDe ? 'Kategorie hinzufügen' : 'Add category'}</h2>
        </div>
        <button class="dialog-close" type="button" data-close-category aria-label={isDe ? 'Schließen' : 'Close'}>×</button>
      </div>
      <label class="field">
        <span>{isDe ? 'Name der Kategorie' : 'Category name'}</span>
        <input name="groupName" maxlength="40" placeholder={isDe ? 'z. B. Startgelder' : 'e.g. Entry fees'} required />
      </label>
      <label class="field" data-category-type-field hidden>
        <span>{isDe ? 'Verwendung' : 'Used for'}</span>
        <select name="type">
          <option value="expense">{isDe ? 'Ausgaben' : 'Outgoing'}</option>
          <option value="income">{isDe ? 'Einnahmen' : 'Incoming'}</option>
        </select>
      </label>
      <fieldset class="color-picker">
        <legend>{isDe ? 'Farbe der Kategorie' : 'Category color'}</legend>
        <div class="custom-color">
          <input
            type="color"
            name="color"
            value="#6657d9"
            data-color-input
            aria-label={isDe ? 'Beliebige Farbe auswählen' : 'Choose any color'}
          />
          <span>
            <strong data-color-hex>#6657D9</strong>
            <small>{isDe ? 'Klicken, um eine beliebige Farbe zu wählen' : 'Click to choose any color'}</small>
          </span>
        </div>
        <div class="color-presets" aria-label={isDe ? 'Schnellauswahl' : 'Quick colors'}>
          {['#6657d9', '#1b8a70', '#e06b3c', '#d3a51f', '#2788bd', '#c14e77'].map((color) => (
            <button type="button" data-color-preset={color} style={`--swatch:${color}`} aria-label={color}></button>
          ))}
        </div>
      </fieldset>
      <button class="primary-button" type="submit">{isDe ? 'Kategorie speichern' : 'Save category'} <span>→</span></button>
    </form>
  </dialog>

  <dialog class="app-dialog" data-expense-dialog>
    <form data-edit-expense-form>
      <div class="dialog-head">
        <div>
          <span class="eyebrow">{isDe ? 'BUCHUNG' : 'ENTRY'}</span>
          <h2>{isDe ? 'Buchung bearbeiten' : 'Edit entry'}</h2>
        </div>
        <button class="dialog-close" type="button" data-close-expense aria-label={isDe ? 'Schließen' : 'Close'}>×</button>
      </div>
      <label class="field" data-edit-entry-type-field hidden>
        <span>{isDe ? 'Art der Buchung' : 'Entry type'}</span>
        <select name="entryType" data-edit-entry-type>
          <option value="expense">{isDe ? 'Ausgabe' : 'Outgoing'}</option>
          <option value="income">{isDe ? 'Einnahme' : 'Incoming'}</option>
        </select>
      </label>
      <label class="field">
        <span>{isDe ? 'Betrag' : 'Amount'}</span>
        <input name="amount" data-money-input type="text" inputmode="decimal" autocomplete="off" required />
      </label>
      <label class="field">
          <span>{isDe ? 'Bezeichnung' : 'Entry name'}</span>
        <input name="note" maxlength="80" required />
      </label>
      <label class="field">
        <span>{isDe ? 'Kategorie' : 'Category'}</span>
        <select name="category" data-edit-category required></select>
      </label>
      <label class="field">
        <span>{isDe ? 'Datum' : 'Date'}</span>
        <input name="date" type="date" required />
      </label>
      <button class="primary-button" type="submit">{isDe ? 'Änderungen speichern' : 'Save changes'} <span>→</span></button>
    </form>
  </dialog>

  <dialog class="app-dialog" data-project-dialog>
    <form data-project-form>
      <div class="dialog-head">
        <div>
          <span class="eyebrow">{isDe ? 'NEUES PROJEKT' : 'NEW PROJECT'}</span>
          <h2>{isDe ? 'Was möchtest du tracken?' : 'What do you want to track?'}</h2>
        </div>
        <button class="dialog-close" type="button" data-close-project aria-label={isDe ? 'Schließen' : 'Close'}>×</button>
      </div>
      <label class="field">
        <span>{isDe ? 'Projektname' : 'Project name'}</span>
        <input name="name" maxlength="50" placeholder={isDe ? 'Name des Projekts' : 'Project name'} required />
      </label>
      <label class="field">
        <span>{isDe ? 'Budget' : 'Budget'} <small>{isDe ? 'optional' : 'optional'}</small></span>
        <input name="budget" data-money-input type="text" inputmode="decimal" autocomplete="off" />
      </label>
      <label class="field">
        <span>{isDe ? 'Währung' : 'Currency'}</span>
        <select name="currency">
          <option value="EUR">EUR · €</option>
          <option value="USD">USD · $</option>
          <option value="GBP">GBP · £</option>
          <option value="CHF">CHF</option>
        </select>
      </label>
      <label class="field">
        <span>{isDe ? 'Was möchtest du erfassen?' : 'What do you want to track?'}</span>
        <select name="trackingMode">
          <option value="expense">{isDe ? 'Nur Ausgaben' : 'Outgoing only'}</option>
          <option value="both">{isDe ? 'Einnahmen und Ausgaben' : 'Income and outgoing'}</option>
        </select>
      </label>
      <button class="primary-button" type="submit">{isDe ? 'Projekt erstellen' : 'Create project'} <span>→</span></button>
    </form>
  </dialog>

  <dialog class="app-dialog" data-edit-project-dialog>
    <form data-edit-project-form>
      <div class="dialog-head">
        <div>
          <span class="eyebrow">{isDe ? 'PROJEKT' : 'PROJECT'}</span>
          <h2>{isDe ? 'Projekt bearbeiten' : 'Edit project'}</h2>
        </div>
        <button class="dialog-close" type="button" data-close-edit-project aria-label={isDe ? 'Schließen' : 'Close'}>×</button>
      </div>
      <label class="field">
        <span>{isDe ? 'Projektname' : 'Project name'}</span>
        <input name="name" maxlength="50" required />
      </label>
      <label class="field">
        <span>{isDe ? 'Erfassung' : 'Tracking'}</span>
        <select name="trackingMode">
          <option value="expense">{isDe ? 'Nur Ausgaben' : 'Outgoing only'}</option>
