        ? 'Dieses Gerät trennen? Das Projekt bleibt lokal, erhält aber keine weiteren Änderungen.'
        : 'Disconnect this device? The project remains local but will no longer receive updates.')) return;
      let cloudAlreadyMissing = false;
      try {
        await api({ action: 'leave', projectId: config.projectId }, config);
      } catch (error) {
        if (!isMissingCloudProject(error)) {
          showToast(root.dataset.syncError || 'Sync failed.');
          return;
        }
        cloudAlreadyMissing = true;
