      onboarding.hidden = hasProject;
      projectOverview.hidden = !hasProject || !showingProjectOverview;
      projectActions.hidden = !hasProject || showingProjectOverview;
      projectContent.forEach(element => { element.hidden = !hasProject || showingProjectOverview; });
      if (!hasProject) {
        state.activeProjectId = '';
        return;
      }
      if (!state.projects.some(project => project.id === state.activeProjectId)) state.activeProjectId = state.projects[0].id;
      renderProjectOverview();
      if (showingProjectOverview) return;
      renderModeControls();
      renderCategorySelects();
      renderCategories();
      renderStats();
      renderFlow();
      renderTransactions();
      const symbol = new Intl.NumberFormat(currencyLocale, { style: 'currency', currency: activeProject().currency })
        .formatToParts(0).find(part => part.type === 'currency')?.value || activeProject().currency;
      $('[data-currency-symbol]').textContent = symbol;
      renderSyncIndicator();
    };

    const openDialog = (dialog: HTMLDialogElement) => {
      if (dialog.open) return;
      if (typeof dialog.showModal === 'function') dialog.showModal();
      else dialog.setAttribute('open', '');
    };
    const closeDialog = (dialog: HTMLDialogElement) => dialog.close?.();
    const clampInlineFlowZoom = (value: number) => Math.min(2.5, Math.max(.6, value));
    const applyInlineFlowScale = () => {
      if (!inlineFlowBaseWidth || !inlineFlowBaseHeight) return;
      const scaledWidth = inlineFlowBaseWidth * inlineFlowZoom;
      const scaledHeight = inlineFlowBaseHeight * inlineFlowZoom;
      const surfaceWidth = Math.max(flowScroll.clientWidth, scaledWidth);
      inlineFlowZoomSurface.style.width = `${surfaceWidth}px`;
      inlineFlowZoomSurface.style.height = `${scaledHeight}px`;
      flowSvg.style.left = `${Math.max(0, (surfaceWidth - scaledWidth) / 2)}px`;
      flowSvg.style.transform = `scale(${inlineFlowZoom})`;
      inlineFlowZoomLabel.value = `${Math.round(inlineFlowZoom * 100)}%`;
    };
    const setInlineFlowZoom = (value: number) => {
      if (flowFullscreenDialog.open || !inlineFlowBaseWidth || !inlineFlowBaseHeight) return;
      const nextZoom = clampInlineFlowZoom(value);
      const anchorX = flowScroll.clientWidth / 2;
      const anchorY = flowScroll.clientHeight / 2;
      const contentX = (flowScroll.scrollLeft + anchorX) / inlineFlowZoom;
      const contentY = (flowScroll.scrollTop + anchorY) / inlineFlowZoom;
      inlineFlowZoom = nextZoom;
      applyInlineFlowScale();
      window.requestAnimationFrame(() => {
        flowScroll.scrollLeft = contentX * inlineFlowZoom - anchorX;
        flowScroll.scrollTop = contentY * inlineFlowZoom - anchorY;
      });
    };
    const centerInlineFlow = () => {
      if (flowFullscreenDialog.open) return;
      window.requestAnimationFrame(() => {
        flowSvg.style.transform = 'none';
        flowSvg.style.width = '';
        flowSvg.style.left = '0';
        inlineFlowZoomSurface.style.width = `${Math.max(1, flowScroll.clientWidth)}px`;
        inlineFlowZoomSurface.style.height = '';
        inlineFlowBaseWidth = Math.max(flowScroll.clientWidth, Number.parseFloat(flowSvg.style.minWidth) || 0);
        inlineFlowBaseHeight = Math.max(1, Number.parseFloat(flowSvg.style.height) || flowSvg.getBoundingClientRect().height);
        flowSvg.style.width = `${inlineFlowBaseWidth}px`;
        flowSvg.style.transformOrigin = '0 0';
        applyInlineFlowScale();
        flowScroll.scrollLeft = Math.max(0, (flowScroll.scrollWidth - flowScroll.clientWidth) / 2);
        flowScroll.scrollTop = Math.max(0, (flowScroll.scrollHeight - flowScroll.clientHeight) / 2);
      });
    };
    const clampFlowZoom = (value: number) => Math.min(3, Math.max(.5, value));
    const setFlowZoom = (value: number, clientX?: number, clientY?: number) => {
      if (!flowFullscreenDialog.open || !flowBaseWidth || !flowBaseHeight) return;
      const nextZoom = clampFlowZoom(value);
      const viewportRect = flowFullscreenViewport.getBoundingClientRect();
      const anchorX = clientX === undefined ? flowFullscreenViewport.clientWidth / 2 : clientX - viewportRect.left;
      const anchorY = clientY === undefined ? flowFullscreenViewport.clientHeight / 2 : clientY - viewportRect.top;
      const contentX = (flowFullscreenViewport.scrollLeft + anchorX) / flowZoom;
      const contentY = (flowFullscreenViewport.scrollTop + anchorY) / flowZoom;
      flowZoom = nextZoom;
      flowZoomSurface.style.width = `${flowBaseWidth * flowZoom}px`;
      flowZoomSurface.style.height = `${flowBaseHeight * flowZoom}px`;
      flowCanvas.style.transform = `scale(${flowZoom})`;
      flowZoomLabel.value = `${Math.round(flowZoom * 100)}%`;
      flowFullscreenViewport.scrollLeft = contentX * flowZoom - anchorX;
      flowFullscreenViewport.scrollTop = contentY * flowZoom - anchorY;
    };
    const measureFullscreenFlow = (resetZoom = false) => {
      const viewportWidth = Math.max(320, flowFullscreenViewport.clientWidth - 32);
      const viewportHeight = Math.max(320, flowFullscreenViewport.clientHeight - 32);
      const retainedZoom = resetZoom ? 1 : flowZoom;
      flowCanvas.style.transform = 'none';
      flowCanvas.style.width = `${viewportWidth}px`;
      flowBaseWidth = Math.max(viewportWidth, flowCanvas.scrollWidth);
      flowBaseHeight = Math.max(viewportHeight, flowCanvas.scrollHeight);
      flowCanvas.style.width = `${flowBaseWidth}px`;
      flowZoom = 1;
      setFlowZoom(retainedZoom);
    };
    const openFlowFullscreen = () => {
      inlineZoomBeforeFullscreen = inlineFlowZoom;
      inlineScrollLeftBeforeFullscreen = flowScroll.scrollLeft;
      inlineScrollTopBeforeFullscreen = flowScroll.scrollTop;
      inlineFlowZoom = 1;
      applyInlineFlowScale();
      flowZoomSurface.append(flowCanvas);
      flowCanvas.classList.add('is-fullscreen');
      flowCanvas.style.position = 'absolute';
      flowCanvas.style.inset = '0 auto auto 0';
      flowCanvas.style.transformOrigin = '0 0';
      openDialog(flowFullscreenDialog);
      window.requestAnimationFrame(() => {
        measureFullscreenFlow(true);
        flowFullscreenViewport.scrollTo({ top: 0, left: 0 });
      });
    };
    const restoreFlowCanvas = () => {
      flowPointers.clear();
      pinchStartDistance = 0;
      flowFullscreenViewport.classList.remove('dragging');
      flowCanvas.classList.remove('is-fullscreen');
      flowCanvas.style.position = '';
      flowCanvas.style.inset = '';
      flowCanvas.style.transformOrigin = '';
      flowCanvas.style.transform = '';
      flowCanvas.style.width = '';
      flowZoomSurface.removeAttribute('style');
      flowCanvasHome.append(flowCanvas);
      inlineFlowZoom = inlineZoomBeforeFullscreen;
      applyInlineFlowScale();
      window.requestAnimationFrame(() => {
        flowScroll.scrollLeft = inlineScrollLeftBeforeFullscreen;
        flowScroll.scrollTop = inlineScrollTopBeforeFullscreen;
      });
      flowZoom = 1;
      flowBaseWidth = 0;
      flowBaseHeight = 0;
      flowZoomLabel.value = '100%';
    };
    const flowPointerDistance = () => {
      const points = Array.from(flowPointers.values());
      if (points.length < 2) return 0;
      return Math.hypot(points[0].x - points[1].x, points[0].y - points[1].y);
    };
    const flowPointerCenter = () => {
      const points = Array.from(flowPointers.values());
      if (!points.length) return { x: 0, y: 0 };
      return {
        x: points.reduce((sum, point) => sum + point.x, 0) / points.length,
        y: points.reduce((sum, point) => sum + point.y, 0) / points.length,
      };
    };
    const recoveryKit = (config: SyncConfig) => ({
      format: 'spendflow-recovery', version: 1, projectId: config.projectId,
      key: config.key, recoveryToken: config.recoveryToken, createdAt: new Date().toISOString(),
    });
    const downloadRecoveryFile = (config = syncConfig(), project = activeProject()) => {
      if (!config?.recoveryToken || !project || config.role !== 'owner') {
        showToast(locale === 'de' ? 'Recovery-Datei ist auf diesem Gerät nicht verfügbar.' : 'Recovery file is not available on this device.');
        return;
      }
      const blob = new Blob([JSON.stringify(recoveryKit(config), null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      const safeName = project.name.replace(/[^a-z0-9_-]+/gi, '-').replace(/^-|-$/g, '').toLowerCase() || 'project';
      link.href = url;
      link.download = `spendflow-recovery-${safeName}.json`;
      link.click();
      URL.revokeObjectURL(url);
    };
    const startOwnershipTransfer = async (device: Record<string, unknown>) => {
      const config = syncConfig();
      if (!config || config.role !== 'owner') return;
      try {
        const result = await api({ action: 'initiate-transfer', projectId: config.projectId, targetDeviceId: device.id }, config);
        if (!result.ok) throw new Error(String(result.error || 'transfer_failed'));
        transferPanel.hidden = false;
        $('[data-transfer-code]').textContent = String(result.transferCode || '');
        $('[data-transfer-message]').textContent = locale === 'de'
          ? `Gib diesen einmaligen Code auf „${String(device.label)}“ ein. Er läuft nach 1 Minute ab.`
          : `Enter this one-time code on “${String(device.label)}”. It expires after 1 minute.`;
        transferPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } catch { showToast(root.dataset.syncError || 'Sync failed.'); }
    };
    const renderDeviceList = (devices: Array<Record<string, unknown>>) => {
      deviceList.replaceChildren();
      devices
        .sort((a, b) => Number(b.current) - Number(a.current) || Number(b.lastSeenAt) - Number(a.lastSeenAt))
        .forEach(device => {
          const row = document.createElement('div');
          row.className = 'device-row';
          const icon = document.createElement('span');
          icon.className = 'device-icon';
          icon.textContent = String(device.label).toLowerCase().includes('iphone') ? '▯' : '□';
          const details = document.createElement('div');
          const label = document.createElement('strong');
          label.textContent = String(device.label || (locale === 'de' ? 'Gerät' : 'Device'));
          const meta = document.createElement('small');
          const seen = Number(device.lastSeenAt) * 1000;
          const ownerLabel = device.role === 'owner' ? (locale === 'de' ? 'Besitzer' : 'Owner') : '';
          const activity = device.current
            ? (locale === 'de' ? 'Dieses Gerät' : 'This device')
            : (locale === 'de' ? `Zuletzt aktiv ${new Intl.DateTimeFormat(currencyLocale, { dateStyle: 'medium' }).format(seen)}` : `Last active ${new Intl.DateTimeFormat(currencyLocale, { dateStyle: 'medium' }).format(seen)}`);
          meta.textContent = ownerLabel ? `${ownerLabel} · ${activity}` : activity;
          details.append(label, meta);
          row.append(icon, details);
          if (!device.current) {
            const actions = document.createElement('span');
            actions.className = 'device-actions';
            const transfer = document.createElement('button');
            transfer.type = 'button';
            transfer.textContent = locale === 'de' ? 'Besitzer machen' : 'Make owner';
            transfer.addEventListener('click', () => void startOwnershipTransfer(device));
            const revoke = document.createElement('button');
            revoke.type = 'button';
            revoke.textContent = locale === 'de' ? 'Entfernen' : 'Remove';
            revoke.addEventListener('click', async () => {
              const config = syncConfig();
              if (!config || !window.confirm(locale === 'de' ? 'Zugriff dieses Geräts wirklich entfernen?' : 'Remove access for this device?')) return;
              try {
                await api({ action: 'revoke', projectId: config.projectId, targetDeviceId: device.id }, config);
                await loadDevices();
              } catch { showToast(root.dataset.syncError || 'Sync failed.'); }
            });
            actions.append(transfer, revoke);
            row.append(actions);
          }
          deviceList.append(row);
        });
      if (!devices.length) {
        const empty = document.createElement('p');
        empty.className = 'device-empty';
        empty.textContent = locale === 'de' ? 'Keine Geräte gefunden.' : 'No devices found.';
        deviceList.append(empty);
      }
    };
    const loadDevices = async () => {
      const config = syncConfig();
      if (!config || config.role !== 'owner') return;
      try {
        const result = await api({ action: 'devices', projectId: config.projectId }, config);
        renderDeviceList(Array.isArray(result.devices) ? result.devices as Array<Record<string, unknown>> : []);
      } catch {
        const empty = document.createElement('p');
        empty.className = 'device-empty';
        empty.textContent = locale === 'de' ? 'Geräte konnten nicht geladen werden.' : 'Devices could not be loaded.';
        deviceList.replaceChildren(empty);
      }
    };
    const openSyncDialog = () => {
      const config = syncConfig();
      window.clearInterval(inviteTimer);
      currentInviteUrl = '';
      invitePanel.hidden = true;
      pairResult.hidden = true;
      syncLoading.hidden = true;
      syncSetup.hidden = Boolean(config);
      syncConnected.hidden = !config;
      deviceNameInput.value = defaultDeviceName();
      transferPanel.hidden = true;
      renderSyncIndicator();
      openDialog(syncDialog);
      if (config?.role === 'owner') void loadDevices();
    };
    const enableSync = async () => {
      const project = activeProject();
      if (!project || !crypto?.subtle || !window.isSecureContext) {
        showToast(locale === 'de' ? 'Sichere Synchronisierung benötigt HTTPS.' : 'Secure sync requires HTTPS.');
        return;
      }
      setSyncBusy(true);
      try {
        const config: SyncConfig = {
          localProjectId: project.id,
          projectId: randomToken(24),
          key: randomToken(32),
          deviceId: randomToken(24),
          deviceToken: randomToken(48),
          label: deviceNameInput.value.trim().slice(0, 60) || defaultDeviceName(),
          revision: 1,
          lastSyncedAt: Date.now(),
          baseProject: cloneProject(project),
          role: 'owner',
          recoveryToken: randomToken(48),
        };
        const cipher = await encryptProject(project, config);
        const result = await api({
          action: 'create', projectId: config.projectId, deviceId: config.deviceId,
          deviceToken: config.deviceToken, recoveryToken: config.recoveryToken,
          label: config.label, cipher,
        });
        if (!result.ok) throw new Error(String(result.error || 'sync_failed'));
        syncStore.projects[project.id] = config;
        persistSyncStore();
        syncSetup.hidden = true;
        syncConnected.hidden = false;
        renderSyncIndicator();
        await loadDevices();
        downloadRecoveryFile(config, project);
        showToast(root.dataset.syncReady || 'Encrypted sync is ready.');
      } catch {
        showToast(root.dataset.syncError || 'Sync failed.');
      } finally {
        setSyncBusy(false);
      }
    };
    const startInviteCountdown = (expiresAt: number) => {
      window.clearInterval(inviteTimer);
      const update = () => {
        const remaining = Math.max(0, expiresAt * 1000 - Date.now());
        const minutes = Math.floor(remaining / 60000);
        const seconds = Math.floor(remaining % 60000 / 1000);
        inviteCountdown.textContent = `${minutes}:${String(seconds).padStart(2, '0')}`;
        if (!remaining) {
          window.clearInterval(inviteTimer);
          currentInviteUrl = '';
          currentInviteToken = '';
          invitePanel.hidden = true;
          showToast(locale === 'de' ? 'Der QR-Code ist abgelaufen.' : 'The QR code has expired.');
        }
      };
      update();
      inviteTimer = window.setInterval(update, 1000);
    };
    const cancelCurrentInvite = async () => {
      const config = syncConfig();
      const token = currentInviteToken;
      currentInviteToken = '';
      currentInviteUrl = '';
      window.clearInterval(inviteTimer);
      invitePanel.hidden = true;
      if (!config || config.role !== 'owner' || !token) return;
      try { await api({ action: 'cancel-invite', projectId: config.projectId, inviteToken: token }, config); }
      catch { /* It may already have been redeemed or expired. */ }
    };
    const createInvite = async () => {
      const config = syncConfig();
      if (!config || config.role !== 'owner') return;
      await cancelCurrentInvite();
      setSyncBusy(true);
      try {
        const result = await api({ action: 'invite', projectId: config.projectId }, config);
        if (!result.ok) throw new Error(String(result.error || 'sync_failed'));
        const payload = encodePairPayload({ v: 1, p: config.projectId, k: config.key, i: result.inviteToken });
        currentInviteToken = String(result.inviteToken);
        currentInviteUrl = `${location.origin}${location.pathname}#pair=${payload}`;
        const canvas = $<HTMLCanvasElement>('[data-sync-qr]');
        await QRCode.toCanvas(canvas, currentInviteUrl, {
          width: 240, margin: 2,
          color: { dark: '#202721', light: '#fffefa' },
          errorCorrectionLevel: 'M',
        });
        invitePanel.hidden = false;
        startInviteCountdown(Number(result.expiresAt));
      } catch {
        showToast(root.dataset.syncError || 'Sync failed.');
      } finally {
        setSyncBusy(false);
      }
    };
    const showPairResult = (success: boolean, message: string) => {
      syncLoading.hidden = true;
      syncSetup.hidden = true;
      syncConnected.hidden = true;
      pairResult.hidden = false;
      $('[data-pair-icon]').textContent = success ? '✓' : '!';
      $('[data-pair-icon]').classList.toggle('error', !success);
      $('[data-pair-title]').textContent = success
        ? (locale === 'de' ? 'Gerät verbunden' : 'Device connected')
        : (locale === 'de' ? 'Verbindung nicht möglich' : 'Could not connect');
      $('[data-pair-message]').textContent = message;
      $('[data-close-pair-result]').hidden = !success;
    };
    const handlePairingLink = async () => {
      if (!location.hash.startsWith('#pair=')) return;
      const encoded = location.hash.slice(6);
      history.replaceState(null, '', `${location.pathname}${location.search}`);
      openDialog(syncDialog);
      syncSetup.hidden = true;
      syncConnected.hidden = true;
      pairResult.hidden = true;
      syncLoading.hidden = false;
      try {
        const payload = decodePairPayload(encoded);
        const projectId = String(payload.p || '');
        const key = String(payload.k || '');
        const inviteToken = String(payload.i || '');
        if (!/^[A-Za-z0-9_-]{32,64}$/.test(projectId) || !/^[A-Za-z0-9_-]{43}$/.test(key) || !/^[A-Za-z0-9_-]{32,160}$/.test(inviteToken)) {
          throw new Error('invalid_invite');
        }
        if (Object.values(syncStore.projects).some(config => config.projectId === projectId)) {
          throw new Error('already_connected');
        }
        const pendingConfig: SyncConfig = {
          localProjectId: '', projectId, key,
          deviceId: randomToken(24), deviceToken: '', label: defaultDeviceName(),
          revision: 0, lastSyncedAt: Date.now(), role: 'member',
        };
        const result = await api({
          action: 'redeem', projectId, inviteToken,
          deviceId: pendingConfig.deviceId, label: pendingConfig.label,
        });
        if (!result.ok || !result.deviceToken || !result.cipher) throw new Error(String(result.error || 'pair_failed'));
        pendingConfig.deviceToken = String(result.deviceToken);
        pendingConfig.revision = Number(result.revision);
        pendingConfig.role = result.role === 'owner' ? 'owner' : 'member';
        const project = await decryptProject(result.cipher as Ciphertext, pendingConfig);
        pendingConfig.localProjectId = project.id;
        pendingConfig.baseProject = cloneProject(project);
        const existingIndex = state.projects.findIndex(item => item.id === project.id);
        if (existingIndex >= 0) state.projects[existingIndex] = project;
        else state.projects.push(project);
        state.activeProjectId = project.id;
        syncStore.projects[project.id] = pendingConfig;
        save(false);
        persistSyncStore();
        render();
        showPairResult(true, root.dataset.pairSuccess || 'This device is now connected.');
      } catch (error) {
        const code = error instanceof Error ? error.message : '';
        const message = code === 'already_connected'
          ? (locale === 'de' ? 'Dieses Projekt ist auf diesem Gerät bereits verbunden.' : 'This project is already connected on this device.')
          : (root.dataset.pairInvalid || 'This QR code is invalid, expired, or already used.');
        showPairResult(false, message);
      }
    };
    const recoverFromFile = async (file: File) => {
      if (file.size > 65536) {
        showToast(locale === 'de' ? 'Diese Recovery-Datei ist ungültig.' : 'This recovery file is invalid.');
        return;
      }
      openDialog(syncDialog);
      syncSetup.hidden = true;
      syncConnected.hidden = true;
      pairResult.hidden = true;
      syncLoading.hidden = false;
      try {
        const kit = JSON.parse(await file.text()) as Record<string, unknown>;
        const projectId = String(kit.projectId || '');
        const key = String(kit.key || '');
        const recoveryToken = String(kit.recoveryToken || '');
        if (kit.format !== 'spendflow-recovery' || kit.version !== 1
          || !/^[A-Za-z0-9_-]{32,64}$/.test(projectId)
          || !/^[A-Za-z0-9_-]{43}$/.test(key)
          || !/^[A-Za-z0-9_-]{32,160}$/.test(recoveryToken)) throw new Error('invalid_recovery_key');
        const existingConfig = Object.values(syncStore.projects).find(config => config.projectId === projectId);
        const newRecoveryToken = randomToken(48);
        const recoveredConfig: SyncConfig = {
          localProjectId: '', projectId, key,
          deviceId: randomToken(24), deviceToken: '', label: defaultDeviceName(),
          revision: 0, lastSyncedAt: Date.now(), role: 'owner', recoveryToken: newRecoveryToken,
        };
        const result = await api({
          action: 'recover-owner', projectId, recoveryToken, newRecoveryToken,
          previousDeviceId: existingConfig?.deviceId,
          deviceId: recoveredConfig.deviceId, label: recoveredConfig.label,
        });
        if (!result.ok || !result.deviceToken || !result.cipher) throw new Error(String(result.error || 'recovery_failed'));
        recoveredConfig.deviceToken = String(result.deviceToken);
        recoveredConfig.revision = Number(result.revision);
        const project = await decryptProject(result.cipher as Ciphertext, recoveredConfig);
        recoveredConfig.localProjectId = project.id;
        recoveredConfig.baseProject = cloneProject(project);
        if (existingConfig) delete syncStore.projects[existingConfig.localProjectId];
        const existingIndex = state.projects.findIndex(item => item.id === project.id);
        if (existingIndex >= 0) state.projects[existingIndex] = project;
        else state.projects.push(project);
        state.activeProjectId = project.id;
        syncStore.projects[project.id] = recoveredConfig;
        save(false);
        persistSyncStore();
        render();
        downloadRecoveryFile(recoveredConfig, project);
        showPairResult(true, locale === 'de'
