    $('[data-delete-project]').addEventListener('click', () => void deleteProject(activeProject()));
    $('[data-export]').addEventListener('click', () => {
      const blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `spendflow-backup-${today()}.json`;
      link.click();
      URL.revokeObjectURL(url);
    });
    document.addEventListener('keydown', event => {
      if ((event.metaKey || event.ctrlKey) && event.key === 'Enter' && !categoryDialog.open && !expenseDialog.open && !projectDialog.open && !editProjectDialog.open && !syncDialog.open && !flowFullscreenDialog.open) {
        event.preventDefault();
        expenseForm.requestSubmit();
      }
    });
    [categoryDialog, expenseDialog, projectDialog, editProjectDialog, syncDialog].forEach(dialog => dialog.addEventListener('click', event => {
      if (event.target === dialog) {
        if (dialog === expenseDialog) editingExpenseId = '';
        closeDialog(dialog);
      }
    }));
    syncDialog.addEventListener('close', () => {
      void cancelCurrentInvite();
    });
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) void pullProject();
    });
    window.addEventListener('online', () => void pullProject(false));
    pollTimer = window.setInterval(() => void pullProject(), 20000);

    $('[data-date]').value = today();
    render();
    void handlePairingLink();
    if (syncConfig()) void pullProject();
  }
</script>

