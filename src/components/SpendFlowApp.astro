        const addSubcategoryButton = document.createElement('button');
        addSubcategoryButton.type = 'button';
        addSubcategoryButton.className = 'category-icon-button category-add-button';
        addSubcategoryButton.textContent = '+';
        addSubcategoryButton.title = locale === 'de' ? 'Unterkategorie hinzufügen' : 'Add subcategory';
