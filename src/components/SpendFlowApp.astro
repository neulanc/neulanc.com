        const result = await api({ action: 'claim-transfer', projectId: config.projectId, transferCode, newRecoveryToken }, config);
        if (!result.ok || result.role !== 'owner') throw new Error(String(result.error || 'transfer_failed'));
        config.role = 'owner';
        config.recoveryToken = newRecoveryToken;
        persistSyncStore();
        input.value = '';
        renderSyncIndicator();
        await loadDevices();
        downloadRecoveryFile(config, activeProject());
        showToast(locale === 'de' ? 'Du bist jetzt Besitzer. Neue Recovery-Datei heruntergeladen.' : 'You are now the owner. A new recovery file was downloaded.');
      } catch {
