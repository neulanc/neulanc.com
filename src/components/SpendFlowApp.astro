        remove.textContent = '×';
        remove.setAttribute('aria-label', locale === 'de' ? 'Kategorie löschen' : 'Delete category');
        remove.addEventListener('click', () => removeGroup(group));
        row.append(swatch, nameWrap, colorPicker, addSubcategoryButton, rename, remove);
        categoryList.append(row);

        const renderSubcategory = (subcategory: Subcategory, depth: 2 | 3) => {
          const subRow = document.createElement('div');
          subRow.className = `category-row subcategory-row depth-${depth}`;
          const branch = document.createElement('i');
          branch.textContent = '↳';
          const subNameWrap = document.createElement('div');
          const subName = document.createElement('strong');
          subName.textContent = subcategory.name;
          const subMeta = document.createElement('small');
          subMeta.textContent = `${locale === 'de' ? `Ebene ${depth}` : `Level ${depth}`} · ${money(totalForSubcategory(group, subcategory.id), true)}`;
          subNameWrap.append(subName, subMeta);
          const spacer = document.createElement('span');
