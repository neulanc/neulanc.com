<script>
  import QRCode from 'qrcode';

  type EntryType = 'expense' | 'income';
  type TrackingMode = 'expense' | 'both';
  type Subcategory = { id: string; name: string; parentId: string | null };
  type Group = { id: string; name: string; color: string; type: EntryType; subcategories: Subcategory[] };
  type Expense = { id: string; amount: number; groupId: string; subcategoryId: string; note: string; date: string; type: EntryType };
  type FlowNode = {
    id: string;
    name: string;
    value: number;
    percentageBase: number;
    color: string;
    x: number;
    y: number;
    width: number;
    height: number;
    radius?: number;
    roundLeft?: boolean;
    roundRight?: boolean;
    roundTopLeft?: boolean;
    roundTopRight?: boolean;
    roundBottomLeft?: boolean;
    roundBottomRight?: boolean;
    showPercentage?: boolean;
    labelSide: 'left' | 'right';
  };
  type FlowLink = {
    source: FlowNode;
    target: FlowNode;
    value: number;
    color: string;
    opacity: number;
    sourceAlignment?: 'start' | 'center';
    targetAlignment?: 'start' | 'center';
  };
  type Project = { id: string; name: string; budget: number | null; currency: string; trackingMode: TrackingMode; groups: Group[]; expenses: Expense[]; updatedAt: number };
  type AppState = { version: 3; activeProjectId: string; projects: Project[] };
  type Ciphertext = { iv: string; data: string };
  type SyncConfig = {
    localProjectId: string;
    projectId: string;
    key: string;
    deviceId: string;
    deviceToken: string;
    label: string;
    revision: number;
    lastSyncedAt: number;
    baseProject?: Project;
    role: 'owner' | 'member';
    recoveryToken?: string;
  };
  type SyncStore = { version: 1; projects: Record<string, SyncConfig> };
  type ApiResult = { ok: boolean; error?: string; [key: string]: unknown };

  const root = document.querySelector<HTMLElement>('[data-spendflow]');

  if (root) {
    const STORAGE_KEY = 'spendflow:v3';
    const SYNC_KEY = 'spendflow:sync:v1';
    const API_URL = '/api/spendflow.php';
    const locale = root.dataset.locale === 'de' ? 'de' : 'en';
    const currencyLocale = root.dataset.currencyLocale || 'de-AT';
    const $ = <T extends Element>(selector: string) => root.querySelector<T>(selector)!;
    const projectSelect = $<HTMLSelectElement>('[data-project-select]');
    const categorySelect = $<HTMLSelectElement>('[data-category-select]');
    const quickCategoryCreate = $<HTMLElement>('[data-quick-category-create]');
    const quickCategoryName = $<HTMLInputElement>('[data-quick-category-name]');
    const quickCategoryColor = $<HTMLInputElement>('[data-quick-category-color]');
    const periodSelect = $<HTMLSelectElement>('[data-period]');
    const categoryList = $<HTMLElement>('[data-category-list]');
    const transactionList = $<HTMLElement>('[data-transaction-list]');
    const flowCanvas = $<HTMLElement>('[data-flow-canvas]');
    const flowCanvasHome = flowCanvas.parentElement!;
    const flowScroll = $<HTMLElement>('[data-flow-scroll]');
    const inlineFlowZoomSurface = $<HTMLElement>('[data-inline-flow-zoom-surface]');
    const flowSvg = $<SVGSVGElement>('[data-flow-svg]');
    const emptyState = $<HTMLElement>('[data-empty-state]');
    const flowFullscreenDialog = $<HTMLDialogElement>('[data-flow-fullscreen-dialog]');
    const flowFullscreenViewport = $<HTMLElement>('[data-flow-fullscreen-viewport]');
    const flowZoomSurface = $<HTMLElement>('[data-flow-zoom-surface]');
    const flowZoomLabel = $<HTMLOutputElement>('[data-flow-zoom-label]');
    const inlineFlowZoomLabel = $<HTMLOutputElement>('[data-inline-flow-zoom-label]');
    const categoryDialog = $<HTMLDialogElement>('[data-category-dialog]');
    const expenseDialog = $<HTMLDialogElement>('[data-expense-dialog]');
    const projectDialog = $<HTMLDialogElement>('[data-project-dialog]');
    const editProjectDialog = $<HTMLDialogElement>('[data-edit-project-dialog]');
    const categoryForm = $<HTMLFormElement>('[data-category-form]');
    const editExpenseForm = $<HTMLFormElement>('[data-edit-expense-form]');
    const editCategorySelect = $<HTMLSelectElement>('[data-edit-category]');
    const projectForm = $<HTMLFormElement>('[data-project-form]');
    const editProjectForm = $<HTMLFormElement>('[data-edit-project-form]');
    const expenseForm = $<HTMLFormElement>('[data-expense-form]');
    const colorInput = $<HTMLInputElement>('[data-color-input]');
    const colorHex = $<HTMLElement>('[data-color-hex]');
    const onboarding = $<HTMLElement>('[data-onboarding]');
    const projectContent = root.querySelectorAll<HTMLElement>('[data-project-content]');
    const projectActions = $<HTMLElement>('[data-project-actions]');
    const projectOverview = $<HTMLElement>('[data-project-overview]');
    const projectOverviewList = $<HTMLElement>('[data-project-overview-list]');
    const entryTypeField = $<HTMLElement>('[data-entry-type-field]');
    const categoryTypeField = $<HTMLElement>('[data-category-type-field]');
    const editEntryTypeField = $<HTMLElement>('[data-edit-entry-type-field]');
    const editEntryType = $<HTMLSelectElement>('[data-edit-entry-type]');
    const toast = $<HTMLElement>('[data-toast]');
    const syncDialog = $<HTMLDialogElement>('[data-sync-dialog]');
    const syncSetup = $<HTMLElement>('[data-sync-setup]');
    const syncConnected = $<HTMLElement>('[data-sync-connected]');
    const syncLoading = $<HTMLElement>('[data-sync-loading]');
    const pairResult = $<HTMLElement>('[data-pair-result]');
    const privacyNote = $<HTMLElement>('[data-privacy-note]');
    const syncDot = $<HTMLElement>('[data-sync-dot]');
    const deviceNameInput = $<HTMLInputElement>('[data-device-name]');
    const invitePanel = $<HTMLElement>('[data-invite-panel]');
    const inviteCountdown = $<HTMLElement>('[data-invite-countdown]');
    const deviceList = $<HTMLElement>('[data-device-list]');
    const ownerControls = $<HTMLElement>('[data-owner-controls]');
    const memberControls = $<HTMLElement>('[data-member-controls]');
    const transferPanel = $<HTMLElement>('[data-transfer-panel]');
    const recoveryFileInput = $<HTMLInputElement>('[data-recovery-file]');
    let period = 'all';
    let editingExpenseId = '';
    let toastTimer = 0;
    let syncTimer = 0;
    let pollTimer = 0;
    let inviteTimer = 0;
    let currentInviteUrl = '';
    let currentInviteToken = '';
    let syncBusy = false;
    let localMutationVersion = 0;
    let showingProjectOverview = false;
    let flowZoom = 1;
    let flowBaseWidth = 0;
    let flowBaseHeight = 0;
    let pinchStartDistance = 0;
    let pinchStartZoom = 1;
    let inlineFlowZoom = 1;
    let inlineFlowBaseWidth = 0;
    let inlineFlowBaseHeight = 0;
    let inlineZoomBeforeFullscreen = 1;
    let inlineScrollLeftBeforeFullscreen = 0;
    let inlineScrollTopBeforeFullscreen = 0;
    let inlinePanPointer = 0;
    let inlinePanX = 0;
    let inlinePanY = 0;
    const flowPointers = new Map<number, { x: number; y: number }>();

    const id = () => globalThis.crypto?.randomUUID?.() || `${Date.now()}-${Math.random().toString(16).slice(2)}`;
    const today = () => {
      const value = new Date();
      const local = new Date(value.getTime() - value.getTimezoneOffset() * 60000);
      return local.toISOString().slice(0, 10);
    };
    const starterState = (): AppState => ({ version: 3, activeProjectId: '', projects: [] });
    const starterSyncStore = (): SyncStore => ({ version: 1, projects: {} });
    const normalizeProjectData = (project: Project) => {
      let changed = false;
      if (project.trackingMode !== 'both' && project.trackingMode !== 'expense') {
        project.trackingMode = 'expense';
        changed = true;
      }
      if (!Number.isFinite(project.updatedAt)) {
        project.updatedAt = Date.now();
        changed = true;
      }
      project.groups.forEach(group => {
        if (group.type !== 'income' && group.type !== 'expense') {
          group.type = 'expense';
          changed = true;
        }
        if (!Array.isArray(group.subcategories)) {
          group.subcategories = [];
          changed = true;
        }
        if (!group.subcategories.some(subcategory => subcategory.name === '')) {
          group.subcategories.unshift({ id: id(), name: '', parentId: null });
          changed = true;
        }
        group.subcategories.forEach(subcategory => {
          if (subcategory.parentId === undefined) {
            subcategory.parentId = null;
            changed = true;
          }
        });
      });
      project.expenses.forEach(expense => {
        if (expense.type !== 'income' && expense.type !== 'expense') {
          expense.type = project.groups.find(group => group.id === expense.groupId)?.type || 'expense';
          changed = true;
        }
      });
      return changed;
    };

    const validState = (value: unknown): value is AppState => {
      if (!value || typeof value !== 'object') return false;
      const candidate = value as AppState;
      return candidate.version === 3 && Array.isArray(candidate.projects) && typeof candidate.activeProjectId === 'string';
    };

    const load = () => {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
          const parsed = JSON.parse(saved);
          if (validState(parsed)) {
            let migrated = false;
            parsed.projects.forEach(project => { migrated = normalizeProjectData(project) || migrated; });
            if (migrated) localStorage.setItem(STORAGE_KEY, JSON.stringify(parsed));
            return parsed;
          }
        }
      } catch { /* Start safely with a blank local state. */ }
      return starterState();
    };

    const loadSyncStore = (): SyncStore => {
      try {
        const parsed = JSON.parse(localStorage.getItem(SYNC_KEY) || 'null') as SyncStore | null;
        if (parsed?.version === 1 && parsed.projects && typeof parsed.projects === 'object') return parsed;
      } catch { /* Ignore invalid device credentials. */ }
      return starterSyncStore();
    };

    let state = load();
    let syncStore = loadSyncStore();
    const activeProject = () => state.projects.find(project => project.id === state.activeProjectId) || state.projects[0];
    const syncConfig = (projectId = state.activeProjectId) => syncStore.projects[projectId];
    const persistSyncStore = () => {
      try { localStorage.setItem(SYNC_KEY, JSON.stringify(syncStore)); }
      catch { showToast(root.dataset.storageError || 'Could not save changes.'); }
    };
    const save = (shouldSync = true, touchProject = shouldSync) => {
      const project = activeProject();
      if (touchProject && project) project.updatedAt = Date.now();
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }
      catch { showToast(root.dataset.storageError || 'Could not save changes.'); }
      if (shouldSync && syncConfig()) {
        localMutationVersion += 1;
        schedulePush();
      }
    };
    const showToast = (message: string) => {
      toast.textContent = message;
      toast.classList.add('show');
      clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => toast.classList.remove('show'), 2600);
    };
    const bytesToBase64url = (bytes: Uint8Array) => {
      let binary = '';
      bytes.forEach(byte => { binary += String.fromCharCode(byte); });
      return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
    };
    const base64urlToBytes = (value: string) => {
      const padded = value.replace(/-/g, '+').replace(/_/g, '/') + '='.repeat((4 - value.length % 4) % 4);
      const binary = atob(padded);
      return Uint8Array.from(binary, character => character.charCodeAt(0));
    };
    const randomToken = (bytes = 32) => bytesToBase64url(crypto.getRandomValues(new Uint8Array(bytes)));
    const encodePairPayload = (value: object) => bytesToBase64url(new TextEncoder().encode(JSON.stringify(value)));
    const decodePairPayload = (value: string) => JSON.parse(new TextDecoder().decode(base64urlToBytes(value))) as Record<string, unknown>;
    const defaultDeviceName = () => {
      const agent = navigator.userAgent;
      if (/iPhone/i.test(agent)) return 'iPhone';
      if (/iPad/i.test(agent)) return 'iPad';
      if (/Android/i.test(agent)) return locale === 'de' ? 'Android-Gerät' : 'Android device';
      if (/Macintosh/i.test(agent)) return 'Mac';
      if (/Windows/i.test(agent)) return 'Windows PC';
      return locale === 'de' ? 'Dieses Gerät' : 'This device';
    };
    const importEncryptionKey = (encodedKey: string) => crypto.subtle.importKey(
      'raw', base64urlToBytes(encodedKey), { name: 'AES-GCM' }, false, ['encrypt', 'decrypt'],
    );
    const encryptProject = async (project: Project, config: Pick<SyncConfig, 'projectId' | 'key'>): Promise<Ciphertext> => {
      const iv = crypto.getRandomValues(new Uint8Array(12));
      const key = await importEncryptionKey(config.key);
      const plaintext = new TextEncoder().encode(JSON.stringify(project));
      const additionalData = new TextEncoder().encode(`spendflow:${config.projectId}:v1`);
      const encrypted = await crypto.subtle.encrypt({ name: 'AES-GCM', iv, additionalData }, key, plaintext);
      return { iv: bytesToBase64url(iv), data: bytesToBase64url(new Uint8Array(encrypted)) };
    };
    const decryptProject = async (cipher: Ciphertext, config: Pick<SyncConfig, 'projectId' | 'key'>): Promise<Project> => {
      const key = await importEncryptionKey(config.key);
      const additionalData = new TextEncoder().encode(`spendflow:${config.projectId}:v1`);
      const decrypted = await crypto.subtle.decrypt(
        { name: 'AES-GCM', iv: base64urlToBytes(cipher.iv), additionalData }, key, base64urlToBytes(cipher.data),
      );
      const project = JSON.parse(new TextDecoder().decode(decrypted)) as Project;
      if (!project || typeof project.id !== 'string' || typeof project.name !== 'string' || !Array.isArray(project.groups) || !Array.isArray(project.expenses)) {
        throw new Error('invalid_project');
      }
      normalizeProjectData(project);
      return project;
    };
    const cloneProject = (project: Project): Project => JSON.parse(JSON.stringify(project)) as Project;
    const equalData = (left: unknown, right: unknown) => JSON.stringify(left) === JSON.stringify(right);
    const mergeValue = <T,>(base: T, local: T, remote: T): T => {
      if (equalData(local, base)) return remote;
      if (equalData(remote, base)) return local;
      return local;
    };
    const mergeRecords = <T extends { id: string }>(baseItems: T[], localItems: T[], remoteItems: T[]): T[] => {
      const base = new Map(baseItems.map(item => [item.id, item]));
      const local = new Map(localItems.map(item => [item.id, item]));
      const remote = new Map(remoteItems.map(item => [item.id, item]));
      const orderedIds = [...remoteItems.map(item => item.id), ...localItems.map(item => item.id)]
        .filter((item, index, all) => all.indexOf(item) === index);
      const merged: T[] = [];
      orderedIds.forEach(itemId => {
        const before = base.get(itemId);
        const here = local.get(itemId);
        const there = remote.get(itemId);
        if (!before) {
          if (here && there) merged.push(equalData(here, there) ? there : here);
          else if (here || there) merged.push((here || there)!);
          return;
        }
        if (!here || !there) return; // A deletion wins over a concurrent edit.
        if (equalData(here, before)) { merged.push(there); return; }
        if (equalData(there, before)) { merged.push(here); return; }
        const combined = { ...there } as T & Record<string, unknown>;
        const keys = new Set([...Object.keys(before), ...Object.keys(here), ...Object.keys(there)]);
        keys.forEach(key => {
          combined[key] = mergeValue(
            (before as T & Record<string, unknown>)[key],
            (here as T & Record<string, unknown>)[key],
            (there as T & Record<string, unknown>)[key],
          );
        });
        merged.push(combined as T);
      });
      return merged;
    };
    const mergeProjects = (base: Project, local: Project, remote: Project): Project => {
      const merged: Project = {
        id: remote.id,
        name: mergeValue(base.name, local.name, remote.name),
        budget: mergeValue(base.budget, local.budget, remote.budget),
        currency: mergeValue(base.currency, local.currency, remote.currency),
        trackingMode: mergeValue(base.trackingMode, local.trackingMode, remote.trackingMode),
        updatedAt: Math.max(base.updatedAt || 0, local.updatedAt || 0, remote.updatedAt || 0),
        groups: mergeRecords(base.groups, local.groups, remote.groups),
        expenses: mergeRecords(base.expenses, local.expenses, remote.expenses),
      };
      const knownGroups = new Map([...base.groups, ...remote.groups, ...local.groups].map(group => [group.id, group]));
      merged.expenses.forEach(expense => {
        if (!merged.groups.some(group => group.id === expense.groupId)) {
          const required = knownGroups.get(expense.groupId);
          if (required) merged.groups.push(required);
        }
      });
      return merged;
    };
    const api = async (body: Record<string, unknown>, config?: Pick<SyncConfig, 'deviceToken'>): Promise<ApiResult> => {
      const headers: Record<string, string> = { 'Content-Type': 'application/json' };
      if (config?.deviceToken) headers.Authorization = `Bearer ${config.deviceToken}`;
      const response = await fetch(API_URL, {
        method: 'POST',
        headers,
        credentials: 'omit',
        cache: 'no-store',
        referrerPolicy: 'no-referrer',
        body: JSON.stringify(body),
      });
      const result = await response.json().catch(() => ({ ok: false, error: 'invalid_response' })) as ApiResult;
      if (!response.ok && response.status !== 409) {
        const error = new Error(String(result.error || `http_${response.status}`));
        (error as Error & { code?: string }).code = String(result.error || 'sync_failed');
        throw error;
      }
      return result;
    };
    const isMissingCloudProject = (error: unknown) => error instanceof Error
      && (((error as Error & { code?: string }).code || error.message) === 'project_not_found');
    const setPrivacyNote = (synced: boolean, status = '') => {
      const strong = document.createElement('strong');
      strong.textContent = synced
        ? (locale === 'de' ? 'Ende-zu-Ende verschlüsselt.' : 'End-to-end encrypted.')
        : (locale === 'de' ? 'Privat auf diesem Gerät.' : 'Private on this device.');
      const text = document.createTextNode(synced
        ? ` ${status || (locale === 'de' ? 'Nur deine verbundenen Geräte besitzen den Schlüssel.' : 'Only your connected devices hold the key.')}`
        : ` ${locale === 'de' ? 'Synchronisierung ist aus. Deine Finanzdaten verlassen den Browser nicht.' : 'Sync is off. Your financial data does not leave this browser.'}`);
      privacyNote.replaceChildren(strong, text);
    };
    const renderSyncIndicator = () => {
      const config = syncConfig();
      if (config && config.role !== 'owner' && config.role !== 'member') config.role = 'member';
      syncDot.classList.toggle('connected', Boolean(config));
      $('[data-sync-button-label]').textContent = config
        ? (locale === 'de' ? 'Synchronisiert' : 'Synced')
        : (locale === 'de' ? 'Synchronisieren' : 'Sync');
      if (config) {
        ownerControls.hidden = config.role !== 'owner';
        memberControls.hidden = config.role === 'owner';
        $('[data-sync-role]').textContent = config.role === 'owner'
          ? (locale === 'de' ? 'Besitzergerät' : 'Owner device')
          : (locale === 'de' ? 'Verbundenes Gerät' : 'Connected device');
        const last = config.lastSyncedAt
          ? new Intl.DateTimeFormat(currencyLocale, { hour: '2-digit', minute: '2-digit' }).format(config.lastSyncedAt)
          : '';
        setPrivacyNote(true, last
          ? (locale === 'de' ? `Zuletzt synchronisiert um ${last}.` : `Last synced at ${last}.`)
          : '');
      } else {
        ownerControls.hidden = true;
        memberControls.hidden = true;
        setPrivacyNote(false);
      }
    };
    const setSyncBusy = (busy: boolean) => {
      syncBusy = busy;
      syncLoading.hidden = !busy;
      syncSetup.toggleAttribute('inert', busy);
      syncConnected.toggleAttribute('inert', busy);
    };
    const markSynced = (config: SyncConfig, revision: number, baseProject = activeProject()) => {
      config.revision = revision;
      config.lastSyncedAt = Date.now();
      if (baseProject) config.baseProject = cloneProject(baseProject);
      syncDot.classList.remove('error');
      persistSyncStore();
      renderSyncIndicator();
      const status = root.querySelector<HTMLElement>('[data-sync-status-text]');
      if (status) status.textContent = locale === 'de' ? 'Aktuell' : 'Up to date';
    };
    const pushProject = async (force = false) => {
      const project = activeProject();
      const config = syncConfig(project?.id);
      if (!project || !config) return;
      if (syncBusy) {
        window.clearTimeout(syncTimer);
        syncTimer = window.setTimeout(() => void pushProject(force), 700);
        return;
      }
      const mutationVersion = localMutationVersion;
      syncBusy = true;
      syncDot.classList.add('working');
      try {
        let projectToPush = project;
        let cipher = await encryptProject(projectToPush, config);
        let result = await api({
          action: 'push', projectId: config.projectId, cipher,
          baseRevision: config.revision, force,
        }, config);
        if (!result.ok && result.error === 'revision_conflict') {
          const remote = await decryptProject(result.cipher as Ciphertext, config);
          projectToPush = mergeProjects(config.baseProject || cloneProject(project), project, remote);
          const index = state.projects.findIndex(item => item.id === project.id);
          if (index >= 0) state.projects[index] = projectToPush;
          save(false);
          render();
          config.revision = Number(result.revision || config.revision);
          config.baseProject = cloneProject(remote);
          cipher = await encryptProject(projectToPush, config);
          result = await api({
            action: 'push', projectId: config.projectId, cipher,
            baseRevision: config.revision, force: true,
          }, config);
        }
        if (!result.ok) throw new Error(String(result.error || 'sync_failed'));
        if (result.role === 'owner' || result.role === 'member') {
          config.role = result.role;
          if (result.role === 'member') delete config.recoveryToken;
        }
        if (config.role === 'owner' && !config.recoveryToken) {
          const recoveryToken = randomToken(48);
          await api({ action: 'set-recovery', projectId: config.projectId, recoveryToken }, config);
          config.recoveryToken = recoveryToken;
        }
        markSynced(config, Number(result.revision), projectToPush);
      } catch {
        syncDot.classList.add('error');
        showToast(root.dataset.syncError || 'Sync failed.');
      } finally {
        syncBusy = false;
        syncDot.classList.remove('working');
        if (localMutationVersion > mutationVersion) schedulePush();
      }
    };
    const schedulePush = () => {
      window.clearTimeout(syncTimer);
      syncTimer = window.setTimeout(() => void pushProject(), 450);
    };
    const pullProject = async (quiet = true) => {
      const project = activeProject();
      const config = syncConfig(project?.id);
      if (!project || !config || syncBusy || document.hidden) return;
      syncBusy = true;
      try {
        const result = await api({ action: 'pull', projectId: config.projectId }, config);
        if (result.role === 'owner' || result.role === 'member') {
          config.role = result.role;
          if (result.role === 'member') delete config.recoveryToken;
        }
        if (config.role === 'owner' && !config.recoveryToken) {
          const recoveryToken = randomToken(48);
          await api({ action: 'set-recovery', projectId: config.projectId, recoveryToken }, config);
          config.recoveryToken = recoveryToken;
        }
        const revision = Number(result.revision || 0);
        if (revision > config.revision && result.cipher) {
          const remote = await decryptProject(result.cipher as Ciphertext, config);
          const merged = mergeProjects(config.baseProject || cloneProject(project), project, remote);
          const index = state.projects.findIndex(item => item.id === project.id);
          if (index >= 0) state.projects[index] = merged;
          state.activeProjectId = merged.id;
          if (merged.id !== config.localProjectId) {
            delete syncStore.projects[config.localProjectId];
            config.localProjectId = merged.id;
            syncStore.projects[merged.id] = config;
          }
          config.revision = revision;
          config.baseProject = cloneProject(remote);
          save(false);
          render();
          if (!equalData(merged, remote)) {
            localMutationVersion += 1;
            schedulePush();
          }
        }
        if (revision <= config.revision) markSynced(config, revision, config.baseProject || project);
      } catch {
        syncDot.classList.add('error');
        if (!quiet) showToast(root.dataset.syncError || 'Sync failed.');
      } finally {
        syncBusy = false;
        if (syncDialog.open && config.role === 'owner') void loadDevices();
      }
    };
    const syncColorPanel = () => { colorHex.textContent = colorInput.value.toUpperCase(); };
    const money = (value: number, compact = false) => new Intl.NumberFormat(currencyLocale, {
      style: 'currency',
      currency: activeProject().currency,
      maximumFractionDigits: compact && value >= 1000 ? 0 : 2,
    }).format(value);
    const invalidMoneyMessage = locale === 'de'
      ? 'Bitte gib einen gültigen Betrag ein, z. B. 1,20 oder 1.000,50.'
      : 'Enter a valid amount, for example 1.20 or 1,000.50.';
    const parseMoneyInput = (input: FormDataEntryValue | string | null) => {
      let raw = String(input || '').trim().replace(/[\s'’]/g, '');
      if (!raw) return Number.NaN;
      let sign = 1;
      if (raw.startsWith('-') || raw.startsWith('+')) {
        sign = raw.startsWith('-') ? -1 : 1;
        raw = raw.slice(1);
      }
      if (!raw || !/^[0-9.,]+$/.test(raw)) return Number.NaN;

      const lastComma = raw.lastIndexOf(',');
      const lastDot = raw.lastIndexOf('.');
      let normalized = raw;
      if (lastComma >= 0 && lastDot >= 0) {
        const decimalSeparator = lastComma > lastDot ? ',' : '.';
        const groupingSeparator = decimalSeparator === ',' ? '.' : ',';
        normalized = raw.split(groupingSeparator).join('');
        const decimalIndex = normalized.lastIndexOf(decimalSeparator);
        normalized = `${normalized.slice(0, decimalIndex).split(decimalSeparator).join('')}.${normalized.slice(decimalIndex + 1)}`;
      } else if (lastComma >= 0 || lastDot >= 0) {
        const separator = lastComma >= 0 ? ',' : '.';
        const parts = raw.split(separator);
        if (parts.length === 2) {
          const [integerPart, fractionPart] = parts;
          if (!fractionPart) normalized = integerPart || '0';
          else if (fractionPart.length === 3 && integerPart.length > 0) normalized = `${integerPart}${fractionPart}`;
          else if (fractionPart.length <= 2) normalized = `${integerPart || '0'}.${fractionPart}`;
          else return Number.NaN;
        } else {
          const lastPart = parts.at(-1) || '';
          const allThousands = parts.slice(1).every(part => part.length === 3);
          if (allThousands) normalized = parts.join('');
          else if (lastPart.length > 0 && lastPart.length <= 2) normalized = `${parts.slice(0, -1).join('')}.${lastPart}`;
          else return Number.NaN;
        }
      }
      const value = Number(normalized) * sign;
      return Number.isFinite(value) ? value : Number.NaN;
    };
    const formatMoneyInput = (value: number) => new Intl.NumberFormat(currencyLocale, {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    }).format(value);
    const readMoneyField = (form: HTMLFormElement, name: string, allowZero = false) => {
      const input = form.elements.namedItem(name) as HTMLInputElement;
      const value = parseMoneyInput(input.value);
      const valid = Number.isFinite(value) && (allowZero ? value >= 0 : value > 0);
      input.setCustomValidity(valid ? '' : invalidMoneyMessage);
      if (!valid) input.reportValidity();
      return valid ? value : Number.NaN;
    };
    const filteredExpenses = () => {
      const project = activeProject();
      const expenses = project.expenses.filter(expense => project.trackingMode === 'both' || expense.type === 'expense');
      const now = new Date();
      if (period === 'year') return expenses.filter(expense => new Date(`${expense.date}T12:00:00`).getFullYear() === now.getFullYear());
      if (period === '30') {
        const cutoff = new Date();
        cutoff.setDate(cutoff.getDate() - 30);
        return expenses.filter(expense => new Date(`${expense.date}T23:59:59`) >= cutoff);
      }
      return expenses;
    };
    const categoryByIds = (groupId: string, subcategoryId: string) => {
      const group = activeProject().groups.find(item => item.id === groupId);
      const subcategory = group?.subcategories.find(item => item.id === subcategoryId);
      return { group, subcategory };
    };
    const totalForGroup = (groupId: string, expenses = activeProject().expenses) => expenses
      .filter(expense => expense.groupId === groupId)
      .reduce((sum, expense) => sum + expense.amount, 0);
    const currentEntryType = (): EntryType => {
      if (activeProject().trackingMode !== 'both') return 'expense';
      return (expenseForm.querySelector<HTMLInputElement>('input[name="entryType"]:checked')?.value === 'income') ? 'income' : 'expense';
    };
    const directSubcategory = (group: Group) => group.subcategories.find(subcategory => subcategory.name === '');
    const subcategoryChildren = (group: Group, parentId: string | null) => group.subcategories
      .filter(subcategory => subcategory.name !== '' && subcategory.parentId === parentId);
    const subcategoryPath = (group: Group, subcategoryId: string) => {
      const subcategory = group.subcategories.find(item => item.id === subcategoryId);
      if (!subcategory || subcategory.name === '') return group.name;
      const parent = subcategory.parentId ? group.subcategories.find(item => item.id === subcategory.parentId) : null;
      return [group.name, parent?.name, subcategory.name].filter(Boolean).join(' › ');
    };
    const subcategoryIdsWithChildren = (group: Group, subcategoryId: string) => {
      const childIds = group.subcategories.filter(item => item.parentId === subcategoryId).map(item => item.id);
      return [subcategoryId, ...childIds];
    };
    const totalForSubcategory = (group: Group, subcategoryId: string, expenses = activeProject().expenses) => {
      const ids = new Set(subcategoryIdsWithChildren(group, subcategoryId));
      return expenses.filter(expense => expense.groupId === group.id && ids.has(expense.subcategoryId))
        .reduce((sum, expense) => sum + expense.amount, 0);
    };
    const populateCategorySelect = (select: HTMLSelectElement, type: EntryType, selectedValue = '') => {
      select.replaceChildren();
      const groups = activeProject().groups.filter(group => group.type === type);
      if (!groups.length) {
        const empty = document.createElement('option');
        empty.textContent = locale === 'de' ? 'Kategorie auswählen …' : 'Choose a category…';
        empty.value = '';
        empty.disabled = true;
        empty.selected = true;
        select.append(empty);
      }
      groups.forEach(group => {
        const direct = directSubcategory(group);
        if (!direct) return;
        const rootOption = document.createElement('option');
        rootOption.value = `${group.id}:${direct.id}`;
        rootOption.textContent = group.name;
        select.append(rootOption);
        subcategoryChildren(group, null).forEach(levelTwo => {
          const levelTwoOption = document.createElement('option');
          levelTwoOption.value = `${group.id}:${levelTwo.id}`;
          levelTwoOption.textContent = `↳ ${levelTwo.name}`;
          select.append(levelTwoOption);
          subcategoryChildren(group, levelTwo.id).forEach(levelThree => {
            const levelThreeOption = document.createElement('option');
            levelThreeOption.value = `${group.id}:${levelThree.id}`;
            levelThreeOption.textContent = `  ↳ ${levelThree.name}`;
            select.append(levelThreeOption);
          });
        });
      });
      if (selectedValue && Array.from(select.options).some(option => option.value === selectedValue)) select.value = selectedValue;
    };
    const renderProjectSelect = () => {
      projectSelect.replaceChildren();
      projectSelect.disabled = state.projects.length === 0;
      if (!state.projects.length) {
