        edited.append(editedLabel, editedValue);

        const actions = document.createElement('div');
        actions.className = 'project-overview-actions';
        const open = document.createElement('button');
        open.type = 'button';
        open.dataset.openProjectId = project.id;
        open.textContent = locale === 'de' ? 'Öffnen' : 'Open';
