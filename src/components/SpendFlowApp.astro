        card.append(identity, status, edited, actions);
        projectOverviewList.append(card);
      });
    };

    const renderCategorySelects = () => {
      populateCategorySelect(categorySelect, currentEntryType());
      const createOption = document.createElement('option');
      createOption.value = '__new__';
      createOption.textContent = locale === 'de' ? '+ Neue Kategorie erstellen' : '+ Create new category';
      categorySelect.append(createOption);
