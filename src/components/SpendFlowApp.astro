          renameSub.addEventListener('click', () => renameSubcategory(subcategory));
          const removeSub = document.createElement('button');
          removeSub.type = 'button';
          removeSub.className = 'category-icon-button';
          removeSub.textContent = '×';
          removeSub.setAttribute('aria-label', locale === 'de' ? 'Unterkategorie löschen' : 'Delete subcategory');
          removeSub.addEventListener('click', () => removeSubcategory(group, subcategory));
          subRow.append(branch, subNameWrap, spacer, addChild, renameSub, removeSub);
          categoryList.append(subRow);
        };
        subcategoryChildren(group, null).forEach(levelTwo => {
          renderSubcategory(levelTwo, 2);
          subcategoryChildren(group, levelTwo.id).forEach(levelThree => renderSubcategory(levelThree, 3));
        });
      });

      if (!visibleGroups.length) {
        const empty = document.createElement('p');
        empty.className = 'category-empty';
        empty.textContent = locale === 'de' ? 'Noch keine Kategorien. Lege deine erste an.' : 'No categories yet. Create your first one.';
        categoryList.append(empty);
      }
    };

    const renderTransactions = () => {
      transactionList.replaceChildren();
      const expenses = [...filteredExpenses()].sort((a, b) => b.date.localeCompare(a.date) || b.id.localeCompare(a.id));
      const both = activeProject().trackingMode === 'both';
      $('[data-transactions-title]').textContent = both
        ? (locale === 'de' ? 'Letzte Buchungen' : 'Recent entries')
        : (locale === 'de' ? 'Letzte Ausgaben' : 'Recent expenses');
      $('[data-mobile-entries-label]').textContent = both ? (locale === 'de' ? 'Buchungen' : 'Entries') : (locale === 'de' ? 'Ausgaben' : 'Expenses');
      $('[data-entry-count]').textContent = String(expenses.length).padStart(2, '0');
      expenses.forEach(expense => {
        const { group } = categoryByIds(expense.groupId, expense.subcategoryId);
        const row = document.createElement('article');
        row.className = 'transaction-row';
        row.classList.toggle('income', expense.type === 'income');
        const color = document.createElement('i');
        color.style.background = group?.color || '#8a918b';
        const date = document.createElement('time');
        date.dateTime = expense.date;
        date.textContent = new Intl.DateTimeFormat(currencyLocale, { day: '2-digit', month: 'short' }).format(new Date(`${expense.date}T12:00:00`));
        const info = document.createElement('div');
        const note = document.createElement('strong');
        note.textContent = expense.note || (expense.type === 'income'
          ? (locale === 'de' ? 'Einnahme' : 'Income')
          : (locale === 'de' ? 'Ausgabe' : 'Expense'));
        const category = document.createElement('small');
        category.textContent = group ? subcategoryPath(group, expense.subcategoryId) : '';
        info.append(note, category);
        const amount = document.createElement('b');
        amount.textContent = `${expense.type === 'income' ? '+' : '−'} ${money(expense.amount)}`;
        amount.className = expense.type === 'income' ? 'income-amount' : '';
        const actions = document.createElement('span');
        actions.className = 'transaction-actions';
        const edit = document.createElement('button');
        edit.type = 'button';
        edit.textContent = '✎';
        edit.setAttribute('aria-label', locale === 'de' ? 'Buchung bearbeiten' : 'Edit entry');
        edit.addEventListener('click', () => openExpenseEditor(expense));
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.textContent = '×';
        remove.setAttribute('aria-label', locale === 'de' ? 'Buchung löschen' : 'Delete entry');
        remove.addEventListener('click', () => {
          activeProject().expenses = activeProject().expenses.filter(item => item.id !== expense.id);
          save();
          render();
          showToast(locale === 'de' ? 'Buchung gelöscht.' : 'Entry deleted.');
        });
        actions.append(edit, remove);
        row.append(color, date, info, amount, actions);
        transactionList.append(row);
      });
      if (!expenses.length) {
        const empty = document.createElement('p');
        empty.className = 'transaction-empty';
        empty.textContent = both
          ? (locale === 'de' ? 'Noch keine Buchungen in diesem Zeitraum.' : 'No entries in this period yet.')
          : (root.dataset.empty || 'No spending yet.');
        transactionList.append(empty);
      }
    };

    const svgElement = <K extends keyof SVGElementTagNameMap>(name: K, attributes: Record<string, string | number> = {}) => {
      const element = document.createElementNS('http://www.w3.org/2000/svg', name);
      Object.entries(attributes).forEach(([key, value]) => element.setAttribute(key, String(value)));
      return element;
    };
    const svgText = (x: number, y: number, value: string, className: string, anchor = 'start') => {
      const element = svgElement('text', { x, y, class: className, 'text-anchor': anchor });
      element.textContent = value;
      return element;
    };
    const truncate = (value: string, max = 21) => value.length > max ? `${value.slice(0, max - 1)}…` : value;

    const renderFlow = () => {
      flowSvg.replaceChildren();
      flowSvg.setAttribute('viewBox', '0 0 980 440');
      flowSvg.style.height = '';
      flowSvg.style.minWidth = '';
      const project = activeProject();
      const entries = filteredExpenses();
      const total = entries.reduce((sum, entry) => sum + entry.amount, 0);
      const both = project.trackingMode === 'both';
      const groups = project.groups
        .map(group => ({ ...group, value: totalForGroup(group.id, entries) }))
        .filter(group => group.value > 0)
        .sort((a, b) => b.value - a.value);
      const hasVisibleSubcategories = groups.some(group => group.subcategories.some(subcategory => (
        subcategory.name !== '' && totalForSubcategory(group, subcategory.id, entries) > 0
      )));
      emptyState.hidden = total > 0;
      flowSvg.style.opacity = total > 0 ? '1' : '0';

      const labels = $<HTMLElement>('[data-flow-labels]');
      const labelItems = labels.querySelectorAll<HTMLElement>('span');
      labels.classList.toggle('dual', both);
      labels.classList.toggle('hierarchical', !both);
      if (both) {
        labelItems[0].hidden = false;
        labelItems[0].textContent = locale === 'de' ? 'EINNAHMEN' : 'INCOME';
        labelItems[1].hidden = true;
        labelItems[2].textContent = locale === 'de' ? 'AUSGABEN' : 'OUTGOING';
      } else if (hasVisibleSubcategories) {
        labelItems[0].hidden = false;
        labelItems[1].hidden = false;
        labelItems[0].textContent = locale === 'de' ? 'GESAMT' : 'TOTAL';
        labelItems[1].textContent = locale === 'de' ? 'KATEGORIEN' : 'CATEGORIES';
        labelItems[2].textContent = locale === 'de' ? 'UNTERKATEGORIEN · BEZEICHNUNGEN' : 'SUBCATEGORIES · ENTRIES';
      } else {
        labelItems[0].hidden = false;
        labelItems[1].hidden = false;
        labelItems[0].textContent = locale === 'de' ? 'GESAMT' : 'TOTAL';
        labelItems[1].textContent = locale === 'de' ? 'KATEGORIEN' : 'CATEGORIES';
        labelItems[2].textContent = locale === 'de' ? 'BEZEICHNUNGEN' : 'ENTRIES';
      }
      $('[data-flow-title]').textContent = both
        ? (locale === 'de' ? 'Einnahmen und Ausgaben im Fluss' : 'Income and outgoing in one flow')
        : (locale === 'de' ? 'Wohin dein Geld fließt' : 'Where your money goes');
      const flowDescription = svgElement('desc', { id: 'flow-description' });
      flowDescription.textContent = both
        ? (locale === 'de' ? 'Sankey-Diagramm der Einnahmen und Ausgaben nach Kategorie, Unterkategorie und Bezeichnung.' : 'Sankey diagram of income and outgoing entries by category, subcategory and entry name.')
        : (locale === 'de' ? 'Sankey-Diagramm der Ausgaben nach Kategorie, Unterkategorie und Bezeichnung.' : 'Sankey diagram of expenses by category, subcategory and entry name.');
      flowSvg.append(flowDescription);
      if (!total) return;

      const nodeWidth = 14;
      const columns: FlowNode[][] = [];
      const links: FlowLink[] = [];
      const hierarchyChildren = new Map<string, FlowNode[]>();
      const registerNode = (column: number, node: FlowNode) => {
        if (!columns[column]) columns[column] = [];
        columns[column].push(node);
        return node;
      };
      const registerChild = (parent: FlowNode, child: FlowNode) => {
        const children = hierarchyChildren.get(parent.id) || [];
        children.push(child);
        hierarchyChildren.set(parent.id, children);
      };
      const exactSubcategoryTotal = (group: Group, subcategoryId: string, sourceEntries: Expense[]) => sourceEntries
        .filter(entry => entry.groupId === group.id && entry.subcategoryId === subcategoryId)
        .reduce((sum, entry) => sum + entry.amount, 0);
      const maxSubcategoryDepth = (sourceGroups: typeof groups, sourceEntries: Expense[]) => {
        let depth = 0;
        sourceGroups.forEach(group => {
          subcategoryChildren(group, null).forEach(levelTwo => {
            if (totalForSubcategory(group, levelTwo.id, sourceEntries) <= 0) return;
            depth = Math.max(depth, 1);
            if (subcategoryChildren(group, levelTwo.id).some(levelThree => exactSubcategoryTotal(group, levelThree.id, sourceEntries) > 0)) depth = 2;
          });
        });
        return depth;
      };
      const buildHierarchy = (
        sourceGroups: typeof groups,
        sourceEntries: Expense[],
        xByDepth: number[],
        entryX: number,
        startColumn: number,
        direction: 'in' | 'out',
        sideTotal: number,
      ) => {
        const groupNodes = new Map<string, FlowNode>();
        sourceGroups.forEach(group => {
          const subcategoryNodes = new Map<string, FlowNode>();
          const groupNode = registerNode(startColumn, {
            id: `${direction}:group:${group.id}`,
            name: group.name,
            value: group.value,
            percentageBase: sideTotal,
            color: group.color,
            x: xByDepth[0], y: 0, width: nodeWidth, height: 0,
            roundLeft: direction === 'in', roundRight: direction === 'out',
            labelSide: direction === 'in' ? 'left' : 'right',
          });
          groupNodes.set(group.id, groupNode);
          subcategoryChildren(group, null).forEach(levelTwo => {
            const levelTwoValue = totalForSubcategory(group, levelTwo.id, sourceEntries);
            if (levelTwoValue <= 0 || xByDepth[1] === undefined) return;
            const levelTwoNode = registerNode(startColumn + 1, {
              id: `${direction}:subcategory:${levelTwo.id}`,
              name: levelTwo.name,
              value: levelTwoValue,
              percentageBase: group.value,
              color: group.color,
              x: xByDepth[1], y: 0, width: nodeWidth, height: 0,
              roundLeft: direction === 'in', roundRight: direction === 'out',
              labelSide: direction === 'in' ? 'left' : 'right',
            });
            subcategoryNodes.set(levelTwo.id, levelTwoNode);
            registerChild(groupNode, levelTwoNode);
            if (direction === 'out') groupNode.roundRight = false;
            else groupNode.roundLeft = false;
            links.push(direction === 'out'
              ? { source: groupNode, target: levelTwoNode, value: levelTwoValue, color: group.color, opacity: .34, sourceAlignment: 'start' }
              : { source: levelTwoNode, target: groupNode, value: levelTwoValue, color: group.color, opacity: .34, targetAlignment: 'start' });
            subcategoryChildren(group, levelTwo.id).forEach(levelThree => {
              const levelThreeValue = exactSubcategoryTotal(group, levelThree.id, sourceEntries);
              if (levelThreeValue <= 0 || xByDepth[2] === undefined) return;
              const levelThreeNode = registerNode(startColumn + 2, {
                id: `${direction}:subcategory:${levelThree.id}`,
                name: levelThree.name,
                value: levelThreeValue,
                percentageBase: levelTwoValue,
                color: group.color,
                x: xByDepth[2], y: 0, width: nodeWidth, height: 0,
                roundLeft: direction === 'in', roundRight: direction === 'out',
                labelSide: direction === 'in' ? 'left' : 'right',
              });
              subcategoryNodes.set(levelThree.id, levelThreeNode);
              registerChild(levelTwoNode, levelThreeNode);
              if (direction === 'out') levelTwoNode.roundRight = false;
              else levelTwoNode.roundLeft = false;
              links.push(direction === 'out'
                ? { source: levelTwoNode, target: levelThreeNode, value: levelThreeValue, color: group.color, opacity: .28, sourceAlignment: 'start' }
                : { source: levelThreeNode, target: levelTwoNode, value: levelThreeValue, color: group.color, opacity: .28, targetAlignment: 'start' });
            });
          });

          const subcategoryIndex = new Map(group.subcategories.map((subcategory, index) => [subcategory.id, index]));
          const entryRank = (entry: Expense) => {
            const subcategory = group.subcategories.find(item => item.id === entry.subcategoryId);
            if (!subcategory || subcategory.name === '') return Number.MAX_SAFE_INTEGER;
            const parentRank = subcategory.parentId ? (subcategoryIndex.get(subcategory.parentId) || 0) : (subcategoryIndex.get(subcategory.id) || 0);
            const ownRank = subcategory.parentId ? (subcategoryIndex.get(subcategory.id) || 0) : 0;
            return parentRank * 1000 + ownRank;
          };
          sourceEntries
            .filter(entry => entry.groupId === group.id)
            .sort((a, b) => entryRank(a) - entryRank(b) || a.date.localeCompare(b.date) || a.id.localeCompare(b.id))
            .forEach(entry => {
              const parentNode = subcategoryNodes.get(entry.subcategoryId) || groupNode;
              const entryNode = registerNode(startColumn + xByDepth.length, {
                id: `${direction}:entry:${entry.id}`,
                name: entry.note,
                value: entry.amount,
                percentageBase: parentNode.value,
                color: group.color,
                x: entryX, y: 0, width: nodeWidth, height: 0,
                roundLeft: direction === 'in', roundRight: direction === 'out',
                showPercentage: false,
                labelSide: direction === 'in' ? 'left' : 'right',
              });
              registerChild(parentNode, entryNode);
              if (direction === 'out') parentNode.roundRight = false;
              else parentNode.roundLeft = false;
              links.push(direction === 'out'
                ? { source: parentNode, target: entryNode, value: entry.amount, color: group.color, opacity: .24, sourceAlignment: 'start' }
                : { source: entryNode, target: parentNode, value: entry.amount, color: group.color, opacity: .24, targetAlignment: 'start' });
            });
        });
        return groupNodes;
      };
      const layoutForest = (roots: FlowNode[], scale: number) => {
        const branchGap = 28;
        const rootGap = 42;
        const layoutSubtree = (node: FlowNode, y: number): number => {
          node.height = Math.max(3, node.value * scale);
          node.y = y;
          const children = hierarchyChildren.get(node.id) || [];
          if (!children.length) return y + node.height;
          let childY = y;
          children.forEach((child, index) => {
            childY = layoutSubtree(child, childY);
            if (index < children.length - 1) childY += branchGap;
          });
          return Math.max(y + node.height, childY);
        };
        let cursor = 0;
        roots.forEach((rootNode, index) => {
          cursor = layoutSubtree(rootNode, cursor);
          if (index < roots.length - 1) cursor += rootGap;
        });
        return cursor;
      };
      const shiftForest = (roots: FlowNode[], offset: number) => {
        const shiftSubtree = (node: FlowNode) => {
          node.y += offset;
          (hierarchyChildren.get(node.id) || []).forEach(shiftSubtree);
        };
        roots.forEach(shiftSubtree);
      };
      const drawLinks = (scale: number) => {
        const sourceStarts = new Map<FlowLink, number>();
        const targetStarts = new Map<FlowLink, number>();
        const outgoingTotals = new Map<string, number>();
        const incomingTotals = new Map<string, number>();
        const linkThickness = (link: FlowLink) => link.value * scale;
        const linksBySource = new Map<string, FlowLink[]>();
        const linksByTarget = new Map<string, FlowLink[]>();
        links.forEach(link => {
          const sourceLinks = linksBySource.get(link.source.id) || [];
          const targetLinks = linksByTarget.get(link.target.id) || [];
          sourceLinks.push(link);
          targetLinks.push(link);
          linksBySource.set(link.source.id, sourceLinks);
          linksByTarget.set(link.target.id, targetLinks);
        });
        linksBySource.forEach(sourceLinks => {
          let used = 0;
          sourceLinks.sort((a, b) => a.target.y - b.target.y || a.target.id.localeCompare(b.target.id));
          sourceLinks.forEach(link => {
            sourceStarts.set(link, used);
            used += linkThickness(link);
          });
          outgoingTotals.set(sourceLinks[0].source.id, used);
        });
        linksByTarget.forEach(targetLinks => {
          let used = 0;
          targetLinks.sort((a, b) => a.source.y - b.source.y || a.source.id.localeCompare(b.source.id));
          targetLinks.forEach(link => {
            targetStarts.set(link, used);
            used += linkThickness(link);
          });
          incomingTotals.set(targetLinks[0].target.id, used);
        });
        links.forEach(link => {
          const thickness = linkThickness(link);
          const sourceUsed = sourceStarts.get(link) || 0;
          const targetUsed = targetStarts.get(link) || 0;
          const sourceInset = link.sourceAlignment === 'start' ? 0 : Math.max(0, (link.source.height - (outgoingTotals.get(link.source.id) || 0)) / 2);
          const targetInset = link.targetAlignment === 'start' ? 0 : Math.max(0, (link.target.height - (incomingTotals.get(link.target.id) || 0)) / 2);
          const sourceTop = link.source.y + sourceInset + sourceUsed;
          const targetTop = link.target.y + targetInset + targetUsed;
          const sourceX = link.source.x + link.source.width;
          const targetX = link.target.x;
          const curveStart = sourceX + (targetX - sourceX) * .46;
          const curveEnd = sourceX + (targetX - sourceX) * .54;
          flowSvg.append(svgElement('path', {
            d: `M ${sourceX} ${sourceTop} C ${curveStart} ${sourceTop}, ${curveEnd} ${targetTop}, ${targetX} ${targetTop} L ${targetX} ${targetTop + thickness} C ${curveEnd} ${targetTop + thickness}, ${curveStart} ${sourceTop + thickness}, ${sourceX} ${sourceTop + thickness} Z`,
            fill: link.color,
            'fill-opacity': link.opacity,
          }));
        });
      };
      const drawNodes = (canvasHeight: number) => {
        columns.forEach(nodes => nodes?.forEach(node => {
          if (node.value <= 0) return;
          const radius = Math.min(node.radius ?? 5, node.width / 2, node.height / 2);
          const roundLeft = node.roundLeft ?? true;
          const roundRight = node.roundRight ?? true;
          const topLeftRadius = (node.roundTopLeft ?? roundLeft) ? radius : 0;
          const topRightRadius = (node.roundTopRight ?? roundRight) ? radius : 0;
          const bottomLeftRadius = (node.roundBottomLeft ?? roundLeft) ? radius : 0;
          const bottomRightRadius = (node.roundBottomRight ?? roundRight) ? radius : 0;
          const nodePath = [
            `M ${node.x + topLeftRadius} ${node.y}`,
            `L ${node.x + node.width - topRightRadius} ${node.y}`,
            topRightRadius ? `Q ${node.x + node.width} ${node.y} ${node.x + node.width} ${node.y + topRightRadius}` : `L ${node.x + node.width} ${node.y}`,
            `L ${node.x + node.width} ${node.y + node.height - bottomRightRadius}`,
            bottomRightRadius ? `Q ${node.x + node.width} ${node.y + node.height} ${node.x + node.width - bottomRightRadius} ${node.y + node.height}` : `L ${node.x + node.width} ${node.y + node.height}`,
            `L ${node.x + bottomLeftRadius} ${node.y + node.height}`,
            bottomLeftRadius ? `Q ${node.x} ${node.y + node.height} ${node.x} ${node.y + node.height - bottomLeftRadius}` : `L ${node.x} ${node.y + node.height}`,
            `L ${node.x} ${node.y + topLeftRadius}`,
            topLeftRadius ? `Q ${node.x} ${node.y} ${node.x + topLeftRadius} ${node.y}` : `L ${node.x} ${node.y}`,
            'Z',
          ].join(' ');
          flowSvg.append(svgElement('path', { d: nodePath, fill: node.color }));
          if (!node.name) return;
          const labelY = Math.max(18, Math.min(canvasHeight - 15, node.y + node.height / 2 - 4));
          const labelX = node.labelSide === 'left' ? node.x - 12 : node.x + node.width + 12;
          const anchor = node.labelSide === 'left' ? 'end' : 'start';
          flowSvg.append(svgText(labelX, labelY, truncate(node.name, 22), 'flow-name', anchor));
          const valueLabel = node.showPercentage === false
            ? money(node.value, true)
            : `${money(node.value, true)} · ${Math.round(node.value / Math.max(1, node.percentageBase) * 100)}%`;
          flowSvg.append(svgText(labelX, labelY + 17, valueLabel, 'flow-value', anchor));
        }));
      };

      if (both) {
        const incomeEntries = entries.filter(entry => entry.type === 'income');
        const expenseEntries = entries.filter(entry => entry.type === 'expense');
        const totalIncome = incomeEntries.reduce((sum, entry) => sum + entry.amount, 0);
        const totalExpense = expenseEntries.reduce((sum, entry) => sum + entry.amount, 0);
        const incomeGroups = groups.filter(group => group.type === 'income');
        const expenseGroups = groups.filter(group => group.type === 'expense');
        const incomeDepth = maxSubcategoryDepth(incomeGroups, incomeEntries);
        const expenseDepth = maxSubcategoryDepth(expenseGroups, expenseEntries);
        const columnDistance = 235;
        const margin = 140;
        const sideColumns = Math.max(incomeDepth, expenseDepth) + 2;
        const canvasWidth = Math.max(980, margin * 2 + columnDistance * sideColumns * 2 + nodeWidth * 2);
        const centerExpenseX = canvasWidth / 2;
        const centerIncomeX = centerExpenseX - nodeWidth;
        const incomeX = Array.from({ length: incomeDepth + 1 }, (_, depth) => centerIncomeX - columnDistance * (depth + 1));
        const expenseX = Array.from({ length: expenseDepth + 1 }, (_, depth) => centerExpenseX + columnDistance * (depth + 1));
        const incomeEntryX = centerIncomeX - columnDistance * (incomeDepth + 2);
        const expenseEntryX = centerExpenseX + columnDistance * (expenseDepth + 2);
        const incomeStartColumn = 0;
        const expenseStartColumn = 6;
        const incomeGroupNodes = buildHierarchy(incomeGroups, incomeEntries, incomeX, incomeEntryX, incomeStartColumn, 'in', totalIncome);
        const incomeCenter = registerNode(4, {
          id: 'income:center', name: '', value: totalIncome, percentageBase: totalIncome, color: '#278462',
          x: centerIncomeX, y: 0, width: nodeWidth, height: 0,
          roundLeft: false, roundRight: false, roundBottomRight: totalIncome > totalExpense,
          labelSide: 'left',
        });
        incomeGroupNodes.forEach((node, groupId) => {
          const group = incomeGroups.find(item => item.id === groupId)!;
          links.push({ source: node, target: incomeCenter, value: group.value, color: group.color, opacity: .42 });
        });
        const expenseCenter = registerNode(5, {
          id: 'expense:center', name: '', value: totalExpense, percentageBase: totalExpense, color: '#202721',
          x: centerExpenseX, y: 0, width: nodeWidth, height: 0,
          roundLeft: false, roundRight: false, roundBottomLeft: totalExpense > totalIncome,
          labelSide: 'right',
        });
        const expenseGroupNodes = buildHierarchy(expenseGroups, expenseEntries, expenseX, expenseEntryX, expenseStartColumn, 'out', totalExpense);
        expenseGroupNodes.forEach((node, groupId) => {
          const group = expenseGroups.find(item => item.id === groupId)!;
          links.push({ source: expenseCenter, target: node, value: group.value, color: group.color, opacity: .42 });
        });
        const scale = 270 / Math.max(totalIncome, totalExpense, 1);
        const incomeRoots = Array.from(incomeGroupNodes.values());
        const expenseRoots = Array.from(expenseGroupNodes.values());
        const incomeForestHeight = layoutForest(incomeRoots, scale);
        const expenseForestHeight = layoutForest(expenseRoots, scale);
        const forestHeight = Math.max(incomeForestHeight, expenseForestHeight, 270);
        const chartTop = 90;
        const canvasHeight = Math.max(440, forestHeight + chartTop + 44);
        const centerTop = chartTop;
        shiftForest(incomeRoots, centerTop);
        shiftForest(expenseRoots, centerTop);
        incomeCenter.height = Math.max(3, totalIncome * scale);
        expenseCenter.height = Math.max(3, totalExpense * scale);
        incomeCenter.y = centerTop;
        expenseCenter.y = centerTop;
        flowSvg.setAttribute('viewBox', `0 0 ${canvasWidth} ${canvasHeight}`);
        flowSvg.style.minWidth = `${Math.max(760, canvasWidth * .82)}px`;
        flowSvg.style.height = `${Math.max(400, canvasHeight * .91)}px`;
        drawLinks(scale);
        drawNodes(canvasHeight);
        flowSvg.append(svgText(centerIncomeX - 10, 24, money(totalIncome, true), 'flow-total', 'end'));
        flowSvg.append(svgText(centerExpenseX + nodeWidth + 10, 24, money(totalExpense, true), 'flow-total'));
        flowSvg.append(svgText(canvasWidth / 2, 48, `${locale === 'de' ? 'Saldo' : 'Balance'} ${money(totalIncome - totalExpense, true)}`, 'flow-balance', 'middle'));
        centerInlineFlow();
        return;
      }

      const depth = maxSubcategoryDepth(groups, entries);
      const sourceX = 40;
      const canvasWidth = depth === 0 ? 1080 : depth === 1 ? 1280 : 1480;
      const hierarchyX = depth === 0 ? [430] : depth === 1 ? [350, 650] : [300, 560, 820];
      const entryX = depth === 0 ? 850 : depth === 1 ? 1010 : 1180;
      const sourceNode = registerNode(0, {
        id: 'expense:total', name: '', value: total, percentageBase: total, color: '#202721',
        x: sourceX, y: 0, width: nodeWidth, height: 0, roundLeft: true, roundRight: false, labelSide: 'right',
      });
      const groupNodes = buildHierarchy(groups, entries, hierarchyX, entryX, 1, 'out', total);
      groupNodes.forEach((node, groupId) => {
        const group = groups.find(item => item.id === groupId)!;
        links.push({ source: sourceNode, target: node, value: group.value, color: group.color, opacity: .38 });
      });
      const scale = 270 / total;
      const roots = Array.from(groupNodes.values());
      const forestHeight = Math.max(270, layoutForest(roots, scale));
      const canvasHeight = Math.max(440, forestHeight + 70);
      const forestTop = (canvasHeight - forestHeight) / 2;
      shiftForest(roots, forestTop);
      sourceNode.height = 270;
      sourceNode.y = forestTop;
      flowSvg.setAttribute('viewBox', `0 0 ${canvasWidth} ${canvasHeight}`);
      flowSvg.style.minWidth = `${Math.max(760, canvasWidth * .82)}px`;
      flowSvg.style.height = `${Math.max(400, canvasHeight * .91)}px`;
      drawLinks(scale);
      drawNodes(canvasHeight);
      flowSvg.append(svgText(sourceX + nodeWidth + 15, sourceNode.y - 16, money(total, true), 'flow-total'));
      centerInlineFlow();
    };

    const renderModeControls = () => {
      const project = activeProject();
      const both = project.trackingMode === 'both';
      entryTypeField.hidden = !both;
      categoryTypeField.hidden = !both;
      editEntryTypeField.hidden = !both;
      if (!both) {
        const outgoing = expenseForm.querySelector<HTMLInputElement>('input[name="entryType"][value="expense"]');
        if (outgoing) outgoing.checked = true;
      }
      const type = currentEntryType();
      $('[data-entry-form-title]').textContent = type === 'income'
        ? (locale === 'de' ? 'Einnahme hinzufügen' : 'Add income')
        : (locale === 'de' ? 'Ausgabe hinzufügen' : 'Add outgoing');
      $('[data-entry-submit-label]').textContent = type === 'income'
        ? (locale === 'de' ? 'Einnahme speichern' : 'Save income')
        : (locale === 'de' ? 'Ausgabe speichern' : 'Save outgoing');
      $('[data-entry-name-label]').textContent = locale === 'de' ? 'Bezeichnung' : 'Entry name';
      const emptyTitle = emptyState.querySelector<HTMLElement>('h3');
      const emptyCopy = emptyState.querySelector<HTMLElement>('p');
      if (emptyTitle) emptyTitle.textContent = locale === 'de' ? 'Dein Flow beginnt hier.' : 'Your flow starts here.';
      if (emptyCopy) emptyCopy.textContent = both
        ? (locale === 'de' ? 'Füge deine erste Einnahme oder Ausgabe hinzu.' : 'Add your first incoming or outgoing entry.')
        : (locale === 'de' ? 'Füge links deine erste Ausgabe hinzu.' : 'Add your first expense on the left.');
      const mobileAdd = $<HTMLButtonElement>('[data-mobile-add]');
