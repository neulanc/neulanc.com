---
import type { Locale } from '../i18n/utils';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const isDe = locale === 'de';
---

<section class="directory-hero">
  <p class="eyebrow">neulanc / apps</p>
  <h1>{isDe ? 'Kleine Tools. Große Erleichterung.' : 'Small tools. Big relief.'}</h1>
  <div class="principles" aria-label={isDe ? 'Unsere Grundsätze' : 'Our principles'}>
    <span><i aria-hidden="true"></i>{isDe ? 'Kostenlos' : 'Free'}</span>
    <span><i aria-hidden="true"></i>{isDe ? 'Ohne Anmeldung' : 'No sign-up'}</span>
    <span><i aria-hidden="true"></i>{isDe ? 'Privat im Browser' : 'Private in your browser'}</span>
  </div>
</section>

<section class="app-section" aria-labelledby="apps-title">
  <div class="section-head">
    <div>
      
      <h2 id="apps-title">{isDe ? 'Alle Apps' : 'All apps'}</h2>
    </div>
    <span class="count">01</span>
  </div>

  <a class="app-card" href={isDe ? '/meldpdf/' : '/en/meldpdf/'}>
    <div class="app-icon" aria-hidden="true">
      <span class="sheet sheet-back"></span>
      <span class="sheet sheet-front">PDF</span>
      <span class="merge-arrow">↘</span>
    </div>
    <div class="app-copy">
      <div class="app-title-row">
        <h3>MeldPDF</h3>
        <span class="badge">{isDe ? 'Neu' : 'New'}</span>
      </div>
      <p>
        {isDe
          ? 'JPGs und PNGs in PDF verwandeln oder mehrere PDFs und Bilder zu einer Datei verbinden.'
          : 'Turn JPGs and PNGs into PDFs, or combine multiple PDFs and images into one file.'}
      </p>
      <ul aria-label={isDe ? 'Funktionen' : 'Features'}>
        <li>JPG / PNG → PDF</li>
        <li>PDF + PDF → PDF</li>
        <li>{isDe ? 'Lokal & privat' : 'Local & private'}</li>
      </ul>
    </div>
    <span class="open-app">{isDe ? 'Öffnen' : 'Open'} <b aria-hidden="true">↗</b></span>
  </a>
</section>

<style>
  .directory-hero,
  .app-section {
    width: min(1080px, calc(100% - 40px));
    margin-inline: auto;
  }

  .directory-hero {
    padding: clamp(5.5rem, 12vw, 10rem) 0 clamp(5rem, 10vw, 8rem);
  }

  .eyebrow {
    margin: 0;
    color: var(--green);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 900px;
    margin: 1.1rem 0 1.6rem;
    font-size: clamp(2.8rem, 6.8vw, 5.6rem);
    letter-spacing: -0.065em;
    line-height: 0.94;
  }

  .intro {
    max-width: 620px;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1rem, 2vw, 1.22rem);
    line-height: 1.65;
  }

  .principles {
    display: flex;
    flex-wrap: wrap;
    gap: 1.35rem;
    margin-top: 2.4rem;
  }

  .principles span {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    color: #48534c;
    font-size: 0.83rem;
    font-weight: 700;
  }

  .principles i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 4px rgba(30, 93, 66, 0.1);
  }

  .app-section { padding-bottom: clamp(3rem, 8vw, 7rem); }

  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  h2 {
    margin: 0.35rem 0 0;
    font-size: clamp(1.65rem, 3vw, 2.45rem);
    letter-spacing: -0.05em;
  }

  .count {
    color: #8a918b;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.76rem;
  }

  .app-card {
    position: relative;
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr) auto;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    margin-top: 1.4rem;
    padding: clamp(1.3rem, 3vw, 2.2rem);
    overflow: hidden;
    border: 1px solid #d8dbd3;
    border-radius: 26px;
    background: rgba(255, 253, 248, 0.84);
    box-shadow: 0 18px 60px rgba(41, 54, 45, 0.06);
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .app-card:hover {
    transform: translateY(-4px);
    border-color: #b8beb4;
    box-shadow: 0 24px 70px rgba(41, 54, 45, 0.11);
  }

  .app-icon {
    position: relative;
    min-height: 150px;
    border-radius: 18px;
    background: var(--green);
  }

  .sheet {
    position: absolute;
    display: grid;
    width: 70px;
    height: 88px;
    place-items: end center;
    padding-bottom: 14px;
    border-radius: 7px;
    background: #fffdf8;
    color: var(--green);
    font-size: 0.65rem;
    font-weight: 900;
    box-shadow: 0 10px 22px rgba(4, 23, 14, 0.2);
  }

  .sheet::after {
    position: absolute;
    top: 14px;
    right: 12px;
    left: 12px;
    height: 4px;
    border-radius: 3px;
    background: var(--lime);
    box-shadow: 0 10px 0 #e8ece6, 0 20px 0 #e8ece6;
    content: '';
  }

  .sheet-back { top: 25px; left: 31px; transform: rotate(-8deg); opacity: 0.72; }
  .sheet-front { top: 31px; left: 72px; transform: rotate(7deg); }
  .merge-arrow { position: absolute; right: 17px; bottom: 12px; color: var(--lime); font-size: 2rem; }

  .app-title-row { display: flex; gap: 0.75rem; align-items: center; }
  .app-copy h3 { margin: 0; font-size: clamp(1.4rem, 2.5vw, 1.85rem); letter-spacing: -0.04em; }
  .badge { padding: 0.3rem 0.55rem; border-radius: 99px; background: var(--lime); font-size: 0.65rem; font-weight: 850; text-transform: uppercase; }
  .app-copy p { max-width: 620px; margin: 0.7rem 0 1rem; color: var(--muted); line-height: 1.6; }
  .app-copy ul { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .app-copy li { padding: 0.35rem 0.6rem; border: 1px solid #dcded8; border-radius: 7px; color: #69716b; font-size: 0.71rem; font-weight: 700; }
  .open-app { white-space: nowrap; font-size: 0.87rem; font-weight: 800; }
  .open-app b { display: inline-block; margin-left: 0.35rem; transition: transform 0.2s ease; }
  .app-card:hover .open-app b { transform: translate(3px, -3px); }

  @media (max-width: 760px) {
    .directory-hero, .app-section { width: calc(100% - 28px); }
    .directory-hero { padding-top: 4.5rem; }
    .app-card { grid-template-columns: 110px 1fr; border-radius: 20px; }
    .app-icon { min-height: 112px; }
    .sheet { width: 50px; height: 67px; padding-bottom: 9px; }
    .sheet-back { top: 19px; left: 16px; }
    .sheet-front { top: 23px; left: 43px; }
    .sheet::after { top: 10px; right: 9px; left: 9px; height: 3px; box-shadow: 0 8px 0 #e8ece6, 0 16px 0 #e8ece6; }
    .merge-arrow { font-size: 1.4rem; }
    .open-app { grid-column: 2; }
  }

  @media (max-width: 520px) {
    h1 { font-size: clamp(2.65rem, 13vw, 3.8rem); }
    .principles { display: grid; gap: 0.75rem; }
    .app-card { grid-template-columns: 1fr; }
    .app-icon { min-height: 145px; }
    .sheet { width: 65px; height: 83px; }
    .sheet-back { top: 26px; left: calc(50% - 57px); }
    .sheet-front { top: 30px; left: calc(50% - 15px); }
    .open-app { grid-column: 1; }
  }
</style>
