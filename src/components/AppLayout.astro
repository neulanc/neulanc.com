---
import LanguageSwitcher from './LanguageSwitcher.astro';
import SiteFooter from './SiteFooter.astro';
import CookieConsent from './CookieConsent.astro';
import type { Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
}

const { locale, title, description, path } = Astro.props;
const canonicalPath = path === '/' ? '' : path;
const localizedCanonicalPath = locale === 'en' ? `/en${canonicalPath}` : canonicalPath;
const canonical = `https://app.neulanc.com${localizedCanonicalPath || '/'}`;
const homePath = locale === 'en' ? '/en/' : '/';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f3ee" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="https://neulanc.com/favicon.svg" />
    <link rel="apple-touch-icon" href="https://neulanc.com/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
  </head>
  <body id="page-top">
    <header class="app-header">
      <a class="brand" href={homePath} aria-label="neulanc apps home">
        <span class="brand-mark" aria-hidden="true">n.</span>
        <span>apps</span>
      </a>
      <nav aria-label={locale === 'de' ? 'Hauptnavigation' : 'Main navigation'}>
        <a href={homePath}>{locale === 'de' ? 'Alle Apps' : 'All apps'}</a>
        <a href="https://neulanc.com">neulanc.com</a>
      </nav>
      <LanguageSwitcher currentLocale={locale} currentPath={path} />
    </header>
    <main>
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <CookieConsent locale={locale} />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --ink: #17201b;
    --muted: #657069;
    --paper: #f6f4ee;
    --card: #fffdf8;
    --line: #dcded7;
    --lime: #d8ff5f;
    --green: #1e5d42;
    --orange: #ff7043;
  }

  * { box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    background:
      radial-gradient(circle at 8% 4%, rgba(216, 255, 95, 0.28), transparent 27rem),
      radial-gradient(circle at 92% 22%, rgba(255, 112, 67, 0.08), transparent 25rem),
      var(--paper);
    color: var(--ink);
    font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  button, input { font: inherit; }

  a { color: inherit; }

  .app-header {
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: min(1180px, calc(100% - 40px));
    min-height: 88px;
    margin: 0 auto;
    border-bottom: 1px solid rgba(23, 32, 27, 0.14);
  }

  .brand {
    display: inline-flex;
    gap: 0.65rem;
    align-items: center;
    justify-self: start;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border-radius: 10px;
    background: var(--ink);
    color: var(--lime);
    font-size: 0.9rem;
  }

  .app-header nav {
    display: flex;
    gap: 1.6rem;
  }

  .app-header nav a {
    color: #4f5a53;
    font-size: 0.87rem;
    font-weight: 700;
    text-decoration: none;
  }

  .app-header nav a:hover { color: #111914; }
  .app-header .language-switcher { justify-self: end; }

  :focus-visible {
    outline: 3px solid #316d4e;
    outline-offset: 3px;
  }

  @media (max-width: 720px) {
    .app-header {
      grid-template-columns: 1fr auto;
      width: min(100% - 28px, 1180px);
      min-height: 76px;
    }
    .app-header nav { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
