---
import type { Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = (de: string, en: string) => locale === 'de' ? de : en;
const legalBase = locale === 'de' ? 'https://neulanc.com' : 'https://neulanc.com/en';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <section class="footer-intro" aria-labelledby="footer-brand">
        <a class="footer-brand" id="footer-brand" href="https://neulanc.com" aria-label="neulanc Home">
          <span class="footer-mark" aria-hidden="true">n.</span>
          <span>neulanc</span>
        </a>
        <!-- <p>{tr(
          'Digitale Projekte, persönliche Portfolios und Ideen - unabhängig entwickelt in Österreich.',
          'Digital projects, personal portfolios and ideas — independently built in Austria.'
        )}</p> -->
        <p></p>
        <a class="footer-contact" href="mailto:contact@neulanc.com">contact@neulanc.com</a>
      </section>

      <nav class="footer-column" aria-labelledby="footer-explore">
        <h2 id="footer-explore">{tr('Entdecken', 'Explore')}</h2>
        <a href="https://neulanc.com">{tr('Startseite', 'Home')}</a>
        <a href="https://app.neulanc.com">Apps</a>
        <a href="https://faces.neulanc.com">Faces</a>
        <a href="https://faces.neulanc.com/@neuhold-michael">{tr('Michael Neuhold', 'Michael Neuhold')}</a>
      </nav>

      <nav class="footer-column" aria-labelledby="footer-legal">
        <h2 id="footer-legal">{tr('Rechtliches', 'Legal')}</h2>
        <a href={`${legalBase}/imprint/`}>{tr('Impressum', 'Imprint')}</a>
        <a href={`${legalBase}/privacy/`}>{tr('Datenschutz', 'Privacy')}</a>
        <a href={`${legalBase}/terms/`}>{tr('Nutzungsbedingungen', 'Terms & Conditions')}</a>
        <a href={`${legalBase}/cookies/`}>{tr('Cookie-Richtlinie', 'Cookie Policy')}</a>
      </nav>

      <section class="footer-column footer-note" aria-labelledby="footer-contact-heading">
        <h2 id="footer-contact-heading">{tr('Kontakt', 'Contact')}</h2>
        <p>{tr(
          'Fragen, Ideen oder Interesse an einer Zusammenarbeit?',
          'Questions, ideas, or interested in working together?'
        )}</p>
        <a class="footer-cta" href="mailto:contact@neulanc.com">
          {tr('Schreib uns', 'Get in touch')}
          <span aria-hidden="true">→</span>
        </a>
      </section>
    </div>

    <div class="footer-bottom">
      <a class="back-to-top" href="#page-top" data-back-to-top aria-label={tr('Zum Seitenanfang', 'Back to top')}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 19V5m0 0-6 6m6-6 6 6"></path>
        </svg>
      </a>
      <p>© {currentYear} neulanc. {tr('Alle Rechte vorbehalten.', 'All rights reserved.')}</p>
      <button class="cookie-settings-link" type="button" data-cookie-settings>
        {tr('Cookie-Einstellungen', 'Cookie settings')}
      </button>
    </div>
  </div>
</footer>

<script>
  const backToTopButton = document.querySelector<HTMLAnchorElement>('[data-back-to-top]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let backToTopFrame = 0;

  const updateBackToTop = () => {
    backToTopFrame = 0;
    const revealAfter = Math.min(320, window.innerHeight * 0.35);
    backToTopButton?.classList.toggle('is-visible', window.scrollY > revealAfter);
  };

  window.addEventListener('scroll', () => {
    if (!backToTopFrame) backToTopFrame = window.requestAnimationFrame(updateBackToTop);
  }, { passive: true });

  backToTopButton?.addEventListener('click', (event) => {
    event.preventDefault();
    window.scrollTo({ top: 0, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
  });

  updateBackToTop();
</script>

<style>
  .site-footer,
  .site-footer * {
    box-sizing: border-box;
  }

  .site-footer {
    position: relative;
    z-index: 1;
    width: 100%;
    margin-top: clamp(4.5rem, 9vw, 8rem);
    border-top: 1px solid #dfe8f1;
    background: #fff;
    color: #16283d;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .footer-inner {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: clamp(3.5rem, 7vw, 6.5rem) 0 1.4rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.35fr 0.72fr 1fr 1.05fr;
    gap: clamp(2rem, 5vw, 5rem);
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
  }

  .footer-intro p,
  .footer-note p {
    max-width: 30ch;
    margin: 1.25rem 0 1rem;
    color: #667488;
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.68rem;
    color: #10243a;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  .footer-mark {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 11px;
    background: linear-gradient(145deg, #0877dd, #0055ad);
    color: #fff;
    font-size: 0.92rem;
    letter-spacing: -0.04em;
  }

  .footer-contact {
    color: #1c4e7f;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
  }

  .footer-contact:hover,
  .footer-column a:hover {
    color: #0066cc;
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.82rem;
  }

  .footer-column h2 {
    margin: 0 0 0.45rem;
    color: #10243a;
    font-size: 0.83rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-column a {
    color: #68768a;
    font-size: 0.91rem;
    line-height: 1.4;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-note p {
    margin: 0;
  }

  .footer-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.25rem;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid #a9c5df;
    color: #164f85 !important;
    font-weight: 750;
  }

  .footer-cta span {
    font-size: 1.05rem;
    transition: transform 0.2s ease;
  }

  .footer-cta:hover span {
    transform: translateX(3px);
  }

  .footer-bottom {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 76px;
    border-top: 1px solid #e2e8ef;
  }

  .footer-bottom p {
    grid-column: 2;
    margin: 0;
    color: #7a8798;
    font-size: 0.8rem;
    text-align: center;
  }

  .back-to-top {
    position: fixed;
    bottom: calc(22px + env(safe-area-inset-bottom, 0px));
    left: 22px;
    z-index: 250;
    display: grid;
    width: 58px;
    height: 58px;
    place-items: center;
    transform: translateY(14px) scale(0.92);
    border: 1px solid #e2e8ef;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 10px 28px rgba(15, 39, 65, 0.1);
    color: #29435f;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      color 0.2s ease,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.2s ease,
      opacity 0.2s ease,
      visibility 0.2s;
  }

  .back-to-top.is-visible {
    transform: translateY(0) scale(1);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .back-to-top:hover {
    transform: translateY(-3px) scale(1);
    color: #0066cc;
    box-shadow: 0 14px 34px rgba(15, 39, 65, 0.15);
  }

  :global(html[data-consent-prompt='open']) .back-to-top {
    transform: translateY(14px) scale(0.92);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .back-to-top svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .cookie-settings-link {
    grid-column: 3;
    justify-self: end;
    padding: 0;
    border: 0;
    background: transparent;
    color: #667488;
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
  }

  .cookie-settings-link:hover {
    color: #0066cc;
  }

  .site-footer a:focus-visible,
  .cookie-settings-link:focus-visible {
    outline: 3px solid rgba(0, 102, 204, 0.24);
    outline-offset: 4px;
    border-radius: 4px;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1.25fr 0.75fr 1fr;
    }

    .footer-note {
      grid-column: 1 / -1;
      padding-top: 0.5rem;
    }

    .footer-note p {
      max-width: 48ch;
    }
  }

  @media (max-width: 620px) {
    .footer-inner {
      width: min(100% - 32px, 1180px);
      padding-top: 3.5rem;
    }

    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem 1.4rem;
      padding-bottom: 3.8rem;
    }

    .footer-intro,
    .footer-note {
      grid-column: 1 / -1;
    }

    .footer-bottom {
      grid-template-columns: 1fr;
      gap: 0.65rem;
      padding: 2.5rem 0 0.8rem;
    }

    .footer-bottom p,
    .cookie-settings-link {
      grid-column: 1;
      justify-self: start;
      text-align: left;
    }

    .back-to-top {
      bottom: calc(16px + env(safe-area-inset-bottom, 0px));
      left: 16px;
      width: 54px;
      height: 54px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
    }
  }
</style>
