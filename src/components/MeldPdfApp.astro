---
import type { Locale } from '../i18n/utils';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const isDe = locale === 'de';
---

<section class="tool-hero">
  <a class="back-link" href={isDe ? '/' : '/en/'}>← {isDe ? 'Alle Apps' : 'All apps'}</a>
  <h1 class="visually-hidden">MeldPDF</h1>
</section>

<section
  class="workspace"
  data-meld-pdf
  data-invalid={isDe ? 'Bitte wähle nur echte JPG-, PNG- oder PDF-Dateien.' : 'Please choose genuine JPG, PNG, or PDF files only.'}
  data-file-too-large={isDe ? '„{name}“ ist zu groß. Maximal 50 MB pro Datei.' : '“{name}” is too large. The limit is 50 MB per file.'}
  data-batch-too-large={isDe ? 'Die Auswahl ist zu groß. Maximal 150 MB insgesamt.' : 'The selection is too large. The total limit is 150 MB.'}
  data-too-many={isDe ? 'Maximal 100 Dateien pro Durchgang.' : 'The limit is 100 files per batch.'}
  data-image-too-large={isDe ? '„{name}“ hat zu viele Bildpunkte. Maximal 25 Megapixel.' : '“{name}” has too many pixels. The limit is 25 megapixels.'}
  data-too-many-pages={isDe ? 'Das Ergebnis hätte mehr als 500 Seiten.' : 'The result would contain more than 500 pages.'}
  data-protected-pdf={isDe ? '„{name}“ ist passwortgeschützt und kann nicht verarbeitet werden.' : '“{name}” is password-protected and cannot be processed.'}
  data-unsafe-pdf={isDe ? '„{name}“ ist beschädigt oder kein unterstütztes PDF.' : '“{name}” is damaged or is not a supported PDF.'}
  data-ready={isDe ? 'Bereit zum Verbinden.' : 'Ready to meld.'}
  data-working={isDe ? 'Deine Datei wird erstellt …' : 'Creating your file…'}
  data-done={isDe ? 'Fertig! Dein Download wurde gestartet.' : 'Done! Your download has started.'}
  data-error={isDe ? 'Das hat leider nicht funktioniert. Prüfe, ob die PDFs geschützt oder beschädigt sind.' : 'That did not work. Check whether any PDFs are password-protected or damaged.'}
  data-one-file={isDe ? '1 Datei' : '1 file'}
  data-many-files={isDe ? '{count} Dateien' : '{count} files'}
  data-remove={isDe ? 'Datei entfernen' : 'Remove file'}
  data-move-up={isDe ? 'Nach oben' : 'Move up'}
  data-move-down={isDe ? 'Nach unten' : 'Move down'}
>
  <div class="privacy-strip">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10V8a5 5 0 0 1 10 0v2m-11 0h12v10H6V10Z"/><path d="M12 14v2"/></svg>
    <p><strong>{isDe ? 'Bleibt bei dir.' : 'Stays with you.'}</strong> {isDe ? 'Deine Dateien verlassen nie deinen Browser. Aktive PDF-Inhalte werden entfernt.' : 'Your files never leave your browser. Active PDF content is removed.'}</p>
  </div>

  <div class="steps" aria-label={isDe ? 'So funktioniert es' : 'How it works'}>
    <article>
      <span>01</span>
      <div>
        <h2>{isDe ? 'Auswählen' : 'Choose'}</h2>
        <p>{isDe ? 'JPG, PNG oder PDF' : 'JPG, PNG, or PDF'}</p>
      </div>
    </article>
    <article>
      <span>02</span>
      <div>
        <h2>{isDe ? 'Sortieren' : 'Arrange'}</h2>
        <p>{isDe ? 'In die richtige Reihenfolge' : 'Put them in the right order'}</p>
      </div>
    </article>
    <article>
      <span>03</span>
      <div>
        <h2>{isDe ? 'Herunterladen' : 'Download'}</h2>
        <p>{isDe ? 'Direkt auf dein Gerät' : 'Directly to your device'}</p>
      </div>
    </article>
  </div>

  <div class="drop-zone" data-drop-zone tabindex="0" role="button" aria-describedby="drop-hint">
    <input data-file-input type="file" accept=".jpg,.jpeg,.png,.pdf,image/jpeg,image/png,application/pdf" multiple hidden />
    <div class="drop-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M12 16V4m0 0L7 9m5-5 5 5M5 15v4h14v-4"/></svg>
    </div>
    <h2>{isDe ? 'Dateien hier ablegen' : 'Drop files here'}</h2>
    <p id="drop-hint">{isDe ? 'oder klicke zum Auswählen' : 'or click to choose'}</p>
    <span>JPG · PNG · PDF</span>
  </div>
  <p class="drop-status" data-drop-status role="status" aria-live="polite"></p>
  <p class="limits">
    {isDe
      ? 'Limits: 100 Dateien · 50 MB je Datei · 150 MB insgesamt · 500 PDF-Seiten · 25 MP je Bild'
      : 'Limits: 100 files · 50 MB each · 150 MB total · 500 PDF pages · 25 MP per image'}
  </p>

  <div class="file-panel" data-file-panel hidden>
    <div class="file-panel-head">
      <div>
        <h2>{isDe ? 'Deine Dateien' : 'Your files'}</h2>
        <p data-file-count></p>
      </div>
      <div class="panel-actions">
        <button class="text-button" type="button" data-add>{isDe ? '+ Hinzufügen' : '+ Add more'}</button>
        <button class="text-button muted" type="button" data-clear>{isDe ? 'Alle entfernen' : 'Remove all'}</button>
      </div>
    </div>
    <ol class="file-list" data-file-list aria-live="polite"></ol>
    <p class="order-hint">{isDe ? 'Ziehe Dateien, um die Reihenfolge zu ändern.' : 'Drag files to change their order.'}</p>
  </div>

  <div class="output-panel" data-output-panel hidden>
    <label for="output-name">{isDe ? 'Dateiname' : 'File name'}</label>
    <div class="filename-field">
      <input id="output-name" data-output-name value="meldpdf" maxlength="90" spellcheck="false" />
      <span>.pdf</span>
    </div>
    <button class="convert-button" type="button" data-convert>
      <span data-button-label>{isDe ? 'PDF erstellen' : 'Create PDF'}</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
    </button>
    <p class="status" data-status role="status" aria-live="polite"></p>
  </div>
</section>

<script>
  import { PDFDocument, PDFName } from 'pdf-lib';

  type SupportedKind = 'jpeg' | 'png' | 'pdf';
  type FileItem = { id: string; file: File; kind: SupportedKind };
  const root = document.querySelector<HTMLElement>('[data-meld-pdf]');

  if (root) {
    const MAX_FILES = 100;
    const MAX_FILE_BYTES = 50 * 1024 * 1024;
    const MAX_TOTAL_BYTES = 150 * 1024 * 1024;
    const MAX_PAGES = 500;
    const MAX_IMAGE_PIXELS = 25_000_000;
    const MAX_PDF_PAGE_DIMENSION = 20_000;
    const HEADER_READ_BYTES = 2 * 1024 * 1024;
    const input = root.querySelector<HTMLInputElement>('[data-file-input]')!;
    const dropZone = root.querySelector<HTMLElement>('[data-drop-zone]')!;
    const panel = root.querySelector<HTMLElement>('[data-file-panel]')!;
    const outputPanel = root.querySelector<HTMLElement>('[data-output-panel]')!;
    const list = root.querySelector<HTMLOListElement>('[data-file-list]')!;
    const count = root.querySelector<HTMLElement>('[data-file-count]')!;
    const outputName = root.querySelector<HTMLInputElement>('[data-output-name]')!;
    const convertButton = root.querySelector<HTMLButtonElement>('[data-convert]')!;
    const buttonLabel = root.querySelector<HTMLElement>('[data-button-label]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const dropStatus = root.querySelector<HTMLElement>('[data-drop-status]')!;
    const initialButtonText = buttonLabel.textContent || 'Create PDF';
    let files: FileItem[] = [];
    let draggedId = '';
    let addQueue = Promise.resolve();

    const message = (key: string, replacements: Record<string, string> = {}) => {
      let value = root.dataset[key] || '';
      Object.entries(replacements).forEach(([name, replacement]) => {
        value = value.replace(`{${name}}`, replacement);
      });
      return value;
    };

    const getPngDimensions = (bytes: Uint8Array) => {
      if (bytes.length < 24) return null;
      const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
      return { width: view.getUint32(16), height: view.getUint32(20) };
    };

    const getJpegDimensions = (bytes: Uint8Array) => {
      let offset = 2;
      const startOfFrame = new Set([0xc0, 0xc1, 0xc2, 0xc3, 0xc5, 0xc6, 0xc7, 0xc9, 0xca, 0xcb, 0xcd, 0xce, 0xcf]);

      while (offset + 8 < bytes.length) {
        if (bytes[offset] !== 0xff) {
          offset += 1;
          continue;
        }
        while (offset < bytes.length && bytes[offset] === 0xff) offset += 1;
        const marker = bytes[offset++];
        if (marker === 0xd8 || marker === 0x01) continue;
        if (marker === 0xd9 || marker === 0xda || offset + 1 >= bytes.length) break;
        const segmentLength = (bytes[offset] << 8) | bytes[offset + 1];
        if (segmentLength < 2 || offset + segmentLength > bytes.length) return null;
        if (startOfFrame.has(marker) && segmentLength >= 7) {
          return {
            height: (bytes[offset + 3] << 8) | bytes[offset + 4],
            width: (bytes[offset + 5] << 8) | bytes[offset + 6],
          };
        }
        offset += segmentLength;
      }
      return null;
    };

    const validateFile = async (file: File): Promise<SupportedKind> => {
      if (!file.size || file.size > MAX_FILE_BYTES) {
        throw new Error(message('fileTooLarge', { name: file.name }));
      }

      const extension = file.name.split('.').pop()?.toLowerCase();
      const expectedKind: SupportedKind | null = extension === 'pdf'
        ? 'pdf'
        : extension === 'png'
          ? 'png'
          : extension === 'jpg' || extension === 'jpeg'
            ? 'jpeg'
            : null;
      if (!expectedKind) throw new Error(message('invalid'));

      const header = new Uint8Array(await file.slice(0, Math.min(file.size, HEADER_READ_BYTES)).arrayBuffer());
      const isPng = header.length >= 24 && [137, 80, 78, 71, 13, 10, 26, 10].every((byte, index) => header[index] === byte);
      const isJpeg = header.length >= 3 && header[0] === 0xff && header[1] === 0xd8 && header[2] === 0xff;
      const isPdf = header.length >= 5 && String.fromCharCode(...header.slice(0, 5)) === '%PDF-';
      const detectedKind: SupportedKind | null = isPng ? 'png' : isJpeg ? 'jpeg' : isPdf ? 'pdf' : null;
      const allowedMimeTypes: Record<SupportedKind, string[]> = {
        jpeg: ['', 'application/octet-stream', 'image/jpeg', 'image/jpg', 'image/pjpeg'],
        png: ['', 'application/octet-stream', 'image/png'],
        pdf: ['', 'application/octet-stream', 'application/pdf', 'application/x-pdf'],
      };
      const mimeType = file.type.toLowerCase();
      if (detectedKind !== expectedKind || !allowedMimeTypes[expectedKind].includes(mimeType)) {
        throw new Error(message('invalid'));
      }

      if (detectedKind === 'png' || detectedKind === 'jpeg') {
        const dimensions = detectedKind === 'png' ? getPngDimensions(header) : getJpegDimensions(header);
        if (!dimensions || !dimensions.width || !dimensions.height || dimensions.width * dimensions.height > MAX_IMAGE_PIXELS) {
          throw new Error(message('imageTooLarge', { name: file.name }));
        }
      }

      return detectedKind;
    };

    const formatSize = (bytes: number) => {
      if (bytes < 1024) return `${bytes} B`;
      if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
      return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
    };

    const render = () => {
      list.replaceChildren();
      const hasFiles = files.length > 0;
      panel.hidden = !hasFiles;
      outputPanel.hidden = !hasFiles;
      dropZone.classList.toggle('compact', hasFiles);
      count.textContent = files.length === 1
        ? root.dataset.oneFile || '1 file'
        : (root.dataset.manyFiles || '{count} files').replace('{count}', String(files.length));

      files.forEach((item, index) => {
        const row = document.createElement('li');
        row.className = 'file-row';
        row.draggable = true;
        row.dataset.id = item.id;
        row.innerHTML = `
          <span class="drag-handle" aria-hidden="true">⠿</span>
          <span class="file-preview"><b>${item.kind === 'jpeg' ? 'JPG' : item.kind.toUpperCase()}</b></span>
          <span class="file-details"><strong></strong><small></small></span>
          <span class="row-actions">
            <button type="button" data-up aria-label="${root.dataset.moveUp || 'Move up'}">↑</button>
            <button type="button" data-down aria-label="${root.dataset.moveDown || 'Move down'}">↓</button>
            <button type="button" data-remove aria-label="${root.dataset.remove || 'Remove file'}">×</button>
          </span>`;
        row.querySelector('strong')!.textContent = item.file.name;
        row.querySelector('small')!.textContent = formatSize(item.file.size);
        row.querySelector<HTMLButtonElement>('[data-up]')!.disabled = index === 0;
        row.querySelector<HTMLButtonElement>('[data-down]')!.disabled = index === files.length - 1;
        row.querySelector('[data-remove]')!.addEventListener('click', () => {
          files = files.filter(file => file.id !== item.id);
          status.textContent = '';
          if (!files.length) dropStatus.textContent = '';
          render();
        });
        row.querySelector('[data-up]')!.addEventListener('click', () => moveItem(index, index - 1));
        row.querySelector('[data-down]')!.addEventListener('click', () => moveItem(index, index + 1));
        row.addEventListener('dragstart', () => { draggedId = item.id; row.classList.add('dragging'); });
        row.addEventListener('dragend', () => { draggedId = ''; row.classList.remove('dragging'); });
        row.addEventListener('dragover', event => event.preventDefault());
        row.addEventListener('drop', event => {
          event.preventDefault();
          const from = files.findIndex(file => file.id === draggedId);
          const to = files.findIndex(file => file.id === item.id);
          moveItem(from, to);
        });
        list.append(row);
      });
    };

    const moveItem = (from: number, to: number) => {
      if (from < 0 || to < 0 || from === to || to >= files.length) return;
      const [item] = files.splice(from, 1);
      files.splice(to, 0, item);
      render();
    };

    const addFiles = async (incoming: FileList | File[]) => {
      const candidates = Array.from(incoming);
      const additions: FileItem[] = [];
      let validationMessage = '';
      let totalBytes = files.reduce((sum, item) => sum + item.file.size, 0);

      for (const file of candidates) {
        if (files.length + additions.length >= MAX_FILES) {
          validationMessage ||= message('tooMany');
          break;
        }
        if (totalBytes + file.size > MAX_TOTAL_BYTES) {
          validationMessage ||= message('batchTooLarge');
          continue;
        }

        try {
          const kind = await validateFile(file);
          additions.push({
            id: `${Date.now()}-${Math.random().toString(36).slice(2)}`,
            file,
            kind,
          });
          totalBytes += file.size;
        } catch (error) {
          validationMessage ||= error instanceof Error ? error.message : message('invalid');
        }
      }

      files.push(...additions);
      dropStatus.textContent = validationMessage || (additions.length ? root.dataset.ready || '' : '');
      render();
    };

    const queueFiles = (incoming: FileList | File[]) => {
      const selectedFiles = Array.from(incoming);
      input.value = '';
      addQueue = addQueue
        .then(() => addFiles(selectedFiles))
        .catch(() => { dropStatus.textContent = root.dataset.error || ''; });
    };

    dropZone.addEventListener('click', event => {
      if (event.target !== input) input.click();
    });
    dropZone.addEventListener('keydown', event => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        input.click();
      }
    });
    input.addEventListener('change', () => input.files && queueFiles(input.files));
    root.querySelector('[data-add]')?.addEventListener('click', () => input.click());
    root.querySelector('[data-clear]')?.addEventListener('click', () => {
      files = [];
      status.textContent = '';
      dropStatus.textContent = '';
      render();
    });

    ['dragenter', 'dragover'].forEach(type => dropZone.addEventListener(type, event => {
      event.preventDefault();
      dropZone.classList.add('is-over');
    }));
    ['dragleave', 'drop'].forEach(type => dropZone.addEventListener(type, event => {
      event.preventDefault();
      dropZone.classList.remove('is-over');
    }));
    dropZone.addEventListener('drop', event => {
      if (event.dataTransfer?.files.length) queueFiles(event.dataTransfer.files);
    });

    convertButton.addEventListener('click', async () => {
      if (!files.length || convertButton.disabled) return;
      convertButton.disabled = true;
      root.classList.add('is-working');
      buttonLabel.textContent = root.dataset.working || 'Creating…';
      status.textContent = root.dataset.working || '';

      try {
        const output = await PDFDocument.create();
        let outputPageCount = 0;
        for (const item of files) {
          const bytes = await item.file.arrayBuffer();
          if (item.kind === 'pdf') {
            let source: PDFDocument;
            try {
              source = await PDFDocument.load(bytes, { updateMetadata: false });
            } catch (error) {
              const isEncrypted = error instanceof Error && /encrypt/i.test(error.message);
              throw new Error(message(isEncrypted ? 'protectedPdf' : 'unsafePdf', { name: item.file.name }));
            }

            const sourcePages = source.getPages();
            if (outputPageCount + sourcePages.length > MAX_PAGES) throw new Error(message('tooManyPages'));
            const hasInvalidPageSize = sourcePages.some(page => {
              const { width, height } = page.getSize();
              return !Number.isFinite(width) || !Number.isFinite(height) ||
                width <= 0 || height <= 0 ||
                width > MAX_PDF_PAGE_DIMENSION || height > MAX_PDF_PAGE_DIMENSION;
            });
            if (hasInvalidPageSize) throw new Error(message('unsafePdf', { name: item.file.name }));

            // Flatten page visuals into new pages. This intentionally drops links,
            // forms, attachments, annotations, document actions, and PDF JavaScript.
            sourcePages.forEach(page => {
              page.node.delete(PDFName.of('Annots'));
              page.node.delete(PDFName.of('AA'));
              if (!page.node.Contents()) {
                page.drawRectangle({ x: 0, y: 0, width: 0, height: 0, opacity: 0 });
              }
            });
            const embeddedPages = await output.embedPages(sourcePages);
            embeddedPages.forEach(embeddedPage => {
              const page = output.addPage([embeddedPage.width, embeddedPage.height]);
              page.drawPage(embeddedPage, { x: 0, y: 0, width: embeddedPage.width, height: embeddedPage.height });
            });
            outputPageCount += sourcePages.length;
          } else {
            if (outputPageCount + 1 > MAX_PAGES) throw new Error(message('tooManyPages'));
            const image = item.kind === 'png'
              ? await output.embedPng(bytes)
              : await output.embedJpg(bytes);
            const landscape = image.width > image.height * 1.12;
            const pageWidth = landscape ? 841.89 : 595.28;
            const pageHeight = landscape ? 595.28 : 841.89;
            const margin = 30;
            const scale = Math.min((pageWidth - margin * 2) / image.width, (pageHeight - margin * 2) / image.height);
            const width = image.width * scale;
            const height = image.height * scale;
            const page = output.addPage([pageWidth, pageHeight]);
            page.drawImage(image, {
              x: (pageWidth - width) / 2,
              y: (pageHeight - height) / 2,
              width,
              height,
            });
            outputPageCount += 1;
          }
        }

        // A fresh output should never expose interactive document actions.
        ['Names', 'OpenAction', 'AA', 'AcroForm', 'Perms', 'Collection'].forEach(key => {
          output.catalog.delete(PDFName.of(key));
        });
        output.setTitle('MeldPDF document');
        output.setCreator('MeldPDF');
        output.setProducer('MeldPDF');
        const pdfBytes = await output.save();
        const blob = new Blob([pdfBytes], { type: 'application/pdf' });
        const url = URL.createObjectURL(blob);
        const download = document.createElement('a');
        const cleanedName = (outputName.value.trim() || 'meldpdf')
          .replace(/[\u0000-\u001f\u007f-\u009f]/g, '')
          .replace(/[\\/:*?"<>|]+/g, '-')
          .replace(/\.pdf$/i, '')
          .replace(/^[. ]+|[. ]+$/g, '');
        const safeName = cleanedName || 'meldpdf';
        download.href = url;
        download.download = `${safeName}.pdf`;
        document.body.append(download);
        download.click();
        download.remove();
        window.setTimeout(() => URL.revokeObjectURL(url), 30_000);
        status.textContent = root.dataset.done || 'Done!';
      } catch (error) {
        console.error(error);
        status.textContent = error instanceof Error && error.message
          ? error.message
          : root.dataset.error || 'Unable to create PDF.';
      } finally {
        convertButton.disabled = false;
        root.classList.remove('is-working');
        buttonLabel.textContent = initialButtonText;
      }
    });
  }
</script>

<style>
  .tool-hero,
  .workspace {
    width: min(960px, calc(100% - 40px));
    margin-inline: auto;
  }

  .tool-hero { padding: 2rem 0 1rem; }
  .back-link { display: inline-block; color: #657069; font-size: 0.8rem; font-weight: 750; text-decoration: none; }
  .back-link:hover { color: var(--ink); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  .workspace {
    padding: clamp(1rem, 2.5vw, 1.7rem);
    border: 1px solid #d9ddd5;
    border-radius: 30px;
    background: rgba(255, 253, 248, 0.88);
    box-shadow: 0 30px 90px rgba(37, 51, 42, 0.09);
  }

  .privacy-strip { display: flex; gap: 0.65rem; align-items: center; margin-bottom: 1rem; padding: 0.8rem 1rem; border-radius: 13px; background: #edf5e9; color: #345240; }
  .privacy-strip svg { width: 19px; flex: 0 0 auto; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }
  .privacy-strip p { margin: 0; font-size: 0.78rem; line-height: 1.45; }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-bottom: 1rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 15px;
    background: #faf9f4;
  }

  .steps article {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    min-width: 0;
    padding: 0.9rem 1rem;
  }

  .steps article + article { border-left: 1px solid var(--line); }
  .steps span { color: var(--green); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.62rem; font-weight: 800; }
  .steps h2 { margin: 0; font-size: 0.88rem; letter-spacing: -0.015em; }
  .steps p { margin: 0.15rem 0 0; overflow: hidden; color: var(--muted); font-size: 0.68rem; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }

  .drop-zone { display: grid; min-height: 330px; place-items: center; align-content: center; padding: 2rem; border: 2px dashed #b8beb5; border-radius: 21px; text-align: center; cursor: pointer; transition: background 0.2s, border-color 0.2s, transform 0.2s; }
  .drop-zone:hover, .drop-zone.is-over { border-color: var(--green); background: #f5f9ef; transform: scale(1.003); }
  .drop-zone.compact { min-height: 120px; margin-bottom: 1rem; padding: 1rem; }
  .drop-zone.compact .drop-icon { width: 40px; height: 40px; margin-bottom: 0.5rem; }
  .drop-zone.compact h2 { font-size: 1rem; }
  .drop-zone.compact p, .drop-zone.compact span { display: none; }
  .drop-icon { display: grid; width: 64px; height: 64px; margin-bottom: 1rem; place-items: center; border-radius: 18px; background: var(--lime); color: var(--ink); }
  .drop-icon svg { width: 28px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.7; }
  .drop-zone h2 { margin: 0; font-size: clamp(1.35rem, 3vw, 1.8rem); letter-spacing: -0.035em; }
  .drop-zone p { margin: 0.45rem 0 1.1rem; color: var(--muted); }
