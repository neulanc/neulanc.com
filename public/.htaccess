RewriteEngine On
DirectoryIndex index.html
Options -Indexes -MultiViews

# Canonical main-domain host.
RewriteCond %{HTTP_HOST} ^www\.neulanc\.com$ [NC]
RewriteRule ^ https://neulanc.com%{REQUEST_URI} [R=301,L]

# Always use HTTPS.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Resolve Astro's directory-style routes explicitly (for example /imprint/).
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# Hostinger can replace ErrorDocument responses with its own error page.
# Route unknown paths through a handler that returns our page with status 404.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ 404.php [L]
